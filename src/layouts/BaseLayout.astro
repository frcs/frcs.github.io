---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentSection?: string;
}

const {
  title = "François Pitié - Academic Homepage",
  description = "Webpage of François Pitié, Ussher Assistant Professor at Trinity College Dublin",
  currentSection = "home"
} = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const navItems = [
  { name: "Home", href: "/" },
  { 
    name: "Research", 
    href: "/research",
    children: [
      { name: "Colour Transfer", href: "/research/colour-transfer" },
      { name: "Deflicker", href: "/research/deflicker" },
      { name: "Matting Laplacian", href: "/research/matting-laplacian" }
    ]
  },
  { name: "Publications", href: "/publications" },
  { 
    name: "Teaching", 
    href: "/teaching",
    children: [
      { name: "4C16 Deep Learning", href: "/teaching/4c16-teaching" },
      { name: "5C34 Advanced AI", href: "/teaching/5c34-teaching" }
    ]
  },
  { name: "Team & Alumni", href: "/team" },
  { name: "Grants & Impact", href: "/grants-impact" }
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2">
  <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico?v=2">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous">
  <script is:inline>
    // Dark mode detection / persistence
    if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>
</head>
<body class="min-h-screen flex flex-col antialiased">
  
  <!-- Subtle Top Accent Bar -->
  <div class="h-0.5 w-full bg-[#F29718]"></div>

  <!-- Desktop Institutional Header (Prominent TCD & Sigmedia Logos) -->
  <header class="hidden md:block border-b border-[#E6E8EB] dark:border-white/[0.08]">
    <div class="max-w-5xl mx-auto px-5 sm:px-8 py-4 flex items-center justify-between">
      <!-- Trinity College Dublin Logo -->
      <a 
        href="https://www.tcd.ie" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="opacity-90 hover:opacity-100 transition-opacity inline-flex items-center" 
        title="Trinity College Dublin"
      >
        <img src="/images/tcd-logo.png" alt="Trinity College Dublin" class="h-11 w-auto dark:hidden" />
        <img src="/images/tcd-logo-white.png" alt="Trinity College Dublin" class="h-11 w-auto hidden dark:block" />
      </a>

      <!-- Sigmedia Research Group Logo -->
      <a 
        href="https://sigmedia.tv" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="opacity-90 hover:opacity-100 transition-opacity inline-flex items-center" 
        title="Sigmedia Research Group"
      >
        <img src="/images/sigmedia-logo.svg" alt="Sigmedia Research Group" class="h-10 w-auto dark:hidden" />
        <img src="/images/sigmedia-logo-white.svg" alt="Sigmedia Research Group" class="h-10 w-auto hidden dark:block" />
      </a>
    </div>
  </header>

  <!-- Mobile Header -->
  <header class="md:hidden flex items-center justify-between px-4 py-3 bg-[#FCFCFC]/95 dark:bg-[#1F2430]/95 border-b border-[#E6E8EB] dark:border-white/[0.08] sticky top-0 z-40 backdrop-blur-xs">
    <div class="flex items-center gap-3">
      <img src="/images/tcd-logo.png" alt="Trinity College Dublin" class="h-8 w-auto dark:hidden" />
      <img src="/images/tcd-logo-white.png" alt="Trinity College Dublin" class="h-8 w-auto hidden dark:block" />
      <a href="/" class="font-medium text-[#242936] dark:text-[#ECEFF4] text-base">François Pitié</a>
    </div>
    <div class="flex items-center gap-2">
      <button id="theme-toggle-mobile" aria-label="Toggle dark mode" class="p-2 rounded text-slate-500 hover:bg-black/[0.05] dark:text-slate-400 dark:hover:bg-white/[0.05]">
        <svg class="w-5 h-5 hidden dark:block text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707-.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"/></svg>
        <svg class="w-5 h-5 block dark:hidden" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
      </button>
      <button id="menu-toggle" aria-label="Open Navigation" class="p-2 rounded text-[#5C6166] hover:bg-black/[0.05] dark:text-[#ECEFF4] dark:hover:bg-white/[0.05]">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </header>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden md:hidden bg-[#FCFCFC] dark:bg-[#1F2430] border-b border-[#E6E8EB] dark:border-white/[0.08] px-5 py-3 space-y-1">
    {navItems.map(item => {
      const isExactActive = currentPath === item.href;
      const isSectionOpen = (item.href !== '/' && currentPath.startsWith(item.href)) || 
                            (item.href === '/research' && currentSection === 'research') ||
                            (item.href === '/teaching' && currentSection === 'teaching');
      return (
        <div>
          <a
            href={item.href}
            class={`block py-1.5 text-sm transition-colors ${
              isExactActive
                ? 'text-[#2B79C2] dark:text-[#73D0FF] font-medium'
                : isSectionOpen
                ? 'text-[#2B79C2] dark:text-[#73D0FF]'
                : 'text-[#5C6166] dark:text-[#CBCCC6] hover:text-[#242936]'
            }`}
          >
            {item.name}
          </a>
          {item.children && isSectionOpen && (
            <div class="pl-4 py-0.5 space-y-0.5">
              {item.children.map(sub => {
                const isSubActive = currentPath === sub.href;
                return (
                  <a
                    href={sub.href}
                    class={`block py-1 text-xs transition-colors ${
                      isSubActive
                        ? 'text-[#2B79C2] dark:text-[#73D0FF] font-medium'
                        : 'text-[#828E9F] dark:text-[#707A8C] hover:text-[#242936] dark:hover:text-[#ECEFF4]'
                    }`}
                  >
                    {sub.name}
                  </a>
                );
              })}
            </div>
          )}
        </div>
      );
    })}

    <!-- Mobile Institutional Logos -->
    <div class="pt-3 pb-1 border-t border-[#E6E8EB] dark:border-white/[0.08] flex items-center justify-between px-1">
      <a href="https://www.tcd.ie" target="_blank" rel="noopener noreferrer" title="Trinity College Dublin">
        <img src="/images/tcd-logo.png" alt="Trinity College Dublin" class="h-7 w-auto dark:hidden" />
        <img src="/images/tcd-logo-white.png" alt="Trinity College Dublin" class="h-7 w-auto hidden dark:block" />
      </a>
      <a href="https://sigmedia.tv" target="_blank" rel="noopener noreferrer" title="Sigmedia Research Group">
        <img src="/images/sigmedia-logo.svg" alt="Sigmedia Research Group" class="h-6.5 w-auto dark:hidden" />
        <img src="/images/sigmedia-logo-white.svg" alt="Sigmedia Research Group" class="h-6.5 w-auto hidden dark:block" />
      </a>
    </div>
  </div>

  <!-- Main 2-Column Academic Container -->
  <div class="max-w-5xl mx-auto w-full px-5 sm:px-8 py-10 flex-1 flex flex-col md:flex-row gap-12 lg:gap-16">
    
    <!-- Left Column (Harmonious, uncluttered academic sidebar) -->
    <aside class="w-full md:w-56 shrink-0">
      <div class="sticky top-8 space-y-6">
        
        <!-- Portrait & Core Identity -->
        <div>
          <div class="w-36 h-44 rounded-sm overflow-hidden mb-3.5 bg-black/[0.04] dark:bg-white/[0.04] border border-[#E6E8EB] dark:border-white/[0.08]">
            <img 
              src="/images/pitief.jpg" 
              alt="François Pitié" 
              class="w-full h-full object-cover object-[center_15%]"
              loading="eager"
            />
          </div>

          <h1 class="text-lg font-medium text-[#242936] dark:text-[#ECEFF4] tracking-tight">François Pitié</h1>
          <p class="text-xs text-[#828E9F] dark:text-[#707A8C] mt-0.5 leading-snug">
            Ussher Assistant Professor &bull; FTCD<br />
            <a href="https://www.tcd.ie/eleceng/" target="_blank" rel="noopener noreferrer" class="hover:text-[#242936] dark:hover:text-[#ECEFF4]">Electronic & Electrical Engineering</a><br />
            <a href="https://www.tcd.ie" target="_blank" rel="noopener noreferrer" class="hover:text-[#242936] dark:hover:text-[#ECEFF4]">Trinity College Dublin</a>
          </p>
        </div>

        <!-- Quick Contacts & Profiles -->
        <div class="text-xs space-y-1 text-[#828E9F] dark:text-[#707A8C] pt-1">
          <div>
            <a href="mailto:pitief@tcd.ie" class="text-[#2B79C2] dark:text-[#73D0FF] hover:underline font-mono">pitief@tcd.ie</a>
          </div>
          <div class="text-[11px] text-[#828E9F] dark:text-[#707A8C]">
            Room 3-22, Áras an Phiarsaigh
          </div>
          <div class="pt-1.5 flex items-center gap-1.5 text-xs text-[#828E9F] dark:text-[#707A8C] flex-wrap">
            <a href="https://scholar.google.com/citations?user=lOaoO74AAAAJ" target="_blank" rel="noopener noreferrer" class="text-[#5C6166] dark:text-[#CBCCC6] hover:text-[#2B79C2] dark:hover:text-[#73D0FF]">Scholar</a>
            <span>&bull;</span>
            <a href="https://orcid.org/0000-0002-3925-5020" target="_blank" rel="noopener noreferrer" class="text-[#5C6166] dark:text-[#CBCCC6] hover:text-[#2B79C2] dark:hover:text-[#73D0FF]">ORCID</a>
            <span>&bull;</span>
            <a href="https://github.com/frcs" target="_blank" rel="noopener noreferrer" class="text-[#5C6166] dark:text-[#CBCCC6] hover:text-[#2B79C2] dark:hover:text-[#73D0FF]">GitHub</a>
            <span>&bull;</span>
            <a href="https://ie.linkedin.com/in/fran%C3%A7ois-piti%C3%A9-6182718b" target="_blank" rel="noopener noreferrer" class="text-[#5C6166] dark:text-[#CBCCC6] hover:text-[#2B79C2] dark:hover:text-[#73D0FF]">LinkedIn</a>
          </div>
        </div>

        <!-- Navigation Menu -->
        <nav class="hidden md:block pt-3.5 border-t border-[#E6E8EB] dark:border-white/[0.08]">
          <ul class="space-y-1.5 text-sm">
            {navItems.map(item => {
              const isExactActive = currentPath === item.href;
              const isSectionOpen = (item.href !== '/' && currentPath.startsWith(item.href)) || 
                                    (item.href === '/research' && currentSection === 'research') ||
                                    (item.href === '/teaching' && currentSection === 'teaching');
              return (
                <li>
                  <a
                    href={item.href}
                    class={`flex items-center justify-between py-1 transition-colors ${
                      isExactActive
                        ? 'text-[#2B79C2] dark:text-[#73D0FF] font-medium'
                        : isSectionOpen
                        ? 'text-[#2B79C2] dark:text-[#73D0FF]'
                        : 'text-[#5C6166] dark:text-[#707A8C] hover:text-[#242936] dark:hover:text-[#ECEFF4]'
                    }`}
                  >
                    <span>{item.name}</span>
                    {isExactActive && (
                      <span class="w-1.5 h-1.5 rounded-full bg-[#F29718] dark:bg-[#FFA759]"></span>
                    )}
                  </a>

                  {/* Subfolder list - only visible when inside this section */}
                  {item.children && isSectionOpen && (
                    <ul class="pl-3.5 pt-0.5 pb-1 space-y-1">
                      {item.children.map(sub => {
                        const isSubActive = currentPath === sub.href;
                        return (
                          <li>
                            <a
                              href={sub.href}
                              class={`flex items-center justify-between py-0.5 text-xs transition-colors ${
                                isSubActive
                                  ? 'text-[#2B79C2] dark:text-[#73D0FF] font-medium'
                                  : 'text-[#828E9F] dark:text-[#707A8C] hover:text-[#242936] dark:hover:text-[#ECEFF4]'
                              }`}
                            >
                              <span>{sub.name}</span>
                              {isSubActive && (
                                <span class="w-1 h-1 rounded-full bg-[#F29718] dark:bg-[#FFA759] opacity-80"></span>
                              )}
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  )}
                </li>
              );
            })}
          </ul>
        </nav>

      </div>
    </aside>

    <!-- Right Content Area -->
    <main class="flex-1 min-w-0">
      <slot />
    </main>

  </div>

  <!-- Footer with Quiet Theme Toggle -->
  <footer class="mt-auto border-t border-[#E6E8EB] dark:border-white/[0.08] py-6 text-xs text-[#828E9F] dark:text-[#707A8C]">
    <div class="max-w-5xl mx-auto px-5 sm:px-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
      <p>&copy; {new Date().getFullYear()} François Pitié &bull; Dept. of Electronic & Electrical Engineering &bull; Trinity College Dublin</p>
      
      <button id="theme-toggle-desktop" class="inline-flex items-center gap-1.5 text-xs text-[#828E9F] hover:text-[#242936] dark:text-[#707A8C] dark:hover:text-[#ECEFF4] transition-colors cursor-pointer">
        <svg class="w-3.5 h-3.5 hidden dark:block text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707-.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"/></svg>
        <svg class="w-3.5 h-3.5 block dark:hidden" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
        <span>Toggle Theme</span>
      </button>
    </div>
  </footer>

  <script>
    function setupThemeToggle(id) {
      const btn = document.getElementById(id);
      if (!btn) return;
      btn.addEventListener('click', () => {
        if (document.documentElement.classList.contains('dark')) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('color-theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('color-theme', 'dark');
        }
      });
    }
    setupThemeToggle('theme-toggle-desktop');
    setupThemeToggle('theme-toggle-mobile');

    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    if (menuToggle && mobileMenu) {
      menuToggle.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
    }
  </script>
</body>
</html>
