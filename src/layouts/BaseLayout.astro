---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentSection?: string;
}

const {
  title = "François Pitié - Academic Homepage",
  description = "Webpage of François Pitié, Ussher Assistant Professor at Trinity College Dublin",
  currentSection = "home"
} = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const navItems = [
  { name: "Home", href: "/" },
  { 
    name: "Research", 
    href: "/research",
    children: [
      { name: "Colour Transfer", href: "/research/colour-transfer" },
      { name: "Deflicker", href: "/research/deflicker" },
      { name: "Matting Laplacian", href: "/research/matting-laplacian" }
    ]
  },
  { name: "Publications", href: "/publications" },
  { 
    name: "Teaching", 
    href: "/teaching",
    children: [
      { name: "4C16 Deep Learning", href: "/teaching/4c16-teaching" },
      { name: "5C34 Advanced AI", href: "/teaching/5c34-teaching" }
    ]
  },
  { name: "Team & Alumni", href: "/team" },
  { name: "Grants & Impact", href: "/grants-impact" }
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2">
  <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico?v=2">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous">
  <script is:inline>
    // Dark mode detection / persistence
    if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>
</head>
<body class="min-h-screen flex flex-col antialiased">
  
  <!-- Subtle Top Accent Bar -->
  <div class="h-0.5 w-full bg-[#0569B9]/80"></div>

  <!-- Mobile Header -->
  <header class="md:hidden flex items-center justify-between px-4 py-3 bg-white/90 dark:bg-slate-900/90 border-b border-slate-200 dark:border-slate-800 sticky top-0 z-40 backdrop-blur-xs">
    <div class="flex items-center gap-3">
      <img src="/images/tcd-logo.png" alt="Trinity College Dublin" class="h-8 w-auto dark:hidden" />
      <img src="/images/tcd-logo-white.png" alt="Trinity College Dublin" class="h-8 w-auto hidden dark:block" />
      <a href="/" class="font-medium text-slate-900 dark:text-white text-base">François Pitié</a>
    </div>
    <div class="flex items-center gap-2">
      <button id="theme-toggle-mobile" aria-label="Toggle dark mode" class="p-2 rounded text-slate-500 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800">
        <svg class="w-5 h-5 hidden dark:block text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"/></svg>
        <svg class="w-5 h-5 block dark:hidden" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
      </button>
      <button id="menu-toggle" aria-label="Open Navigation" class="p-2 rounded text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </header>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden md:hidden bg-white dark:bg-[#111928] border-b border-slate-200 dark:border-slate-800 px-4 py-3 space-y-1">
    {navItems.map(item => {
      const isParentActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
      return (
        <div>
          <a
            href={item.href}
            class={`block px-3 py-2 text-base font-medium transition-colors ${
              currentPath === item.href
                ? 'text-[#0569B9] dark:text-[#82B4DC] font-semibold pl-2 border-l-2 border-[#0569B9]'
                : isParentActive
                ? 'text-[#0569B9] dark:text-[#82B4DC] font-semibold'
                : 'text-slate-600 dark:text-slate-300 hover:text-slate-900'
            }`}
          >
            {item.name}
          </a>
          {item.children && (
            <div class="pl-5 py-1 space-y-1 border-l border-slate-200 dark:border-slate-800 ml-3">
              {item.children.map(sub => {
                const isSubActive = currentPath === sub.href;
                return (
                  <a
                    href={sub.href}
                    class={`block py-1 text-sm transition-colors ${
                      isSubActive
                        ? 'text-[#0569B9] dark:text-[#82B4DC] font-semibold'
                        : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'
                    }`}
                  >
                    {sub.name}
                  </a>
                );
              })}
            </div>
          )}
        </div>
      );
    })}
  </div>

  <!-- Main 2-Column Academic Container -->
  <div class="max-w-5xl mx-auto w-full px-5 sm:px-8 py-10 flex-1 flex flex-col md:flex-row gap-10 lg:gap-14">
    
    <!-- Left Column (Refined minimal academic sidebar) -->
    <aside class="w-full md:w-52 lg:w-56 shrink-0">
      <div class="sticky top-8 space-y-5">
        
        <!-- Profile Identity -->
        <div>
          <!-- Clean portrait -->
          <div class="w-[170px] h-[212px] rounded overflow-hidden mb-3.5 bg-black/[0.03] dark:bg-white/[0.04] border border-black/[0.07] dark:border-white/[0.08]">
            <img 
              src="/images/pitief.jpg" 
              alt="François Pitié" 
              class="w-full h-full object-cover object-[center_15%]"
              loading="eager"
            />
          </div>

          <h1 class="text-lg font-semibold text-[#1a1e22] dark:text-[#edf2f7] tracking-tight">François Pitié</h1>
          <p class="text-xs text-[#235789] dark:text-[#82B4DC] font-medium mt-0.5">Ussher Assistant Professor</p>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Fellow of Trinity College Dublin (FTCD)</p>
          
          <div class="mt-3 text-xs text-slate-600 dark:text-slate-400 space-y-0.5 leading-relaxed">
            <p>
              <a href="https://www.tcd.ie/eleceng/" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 dark:hover:text-slate-200">
                Dept. of Electronic & Elec. Eng.
              </a>
            </p>
            <p>
              <a href="https://www.tcd.ie" target="_blank" rel="noopener noreferrer" class="text-slate-800 dark:text-slate-200 hover:underline">
                Trinity College Dublin
              </a>
            </p>
            <p class="text-xs text-slate-400 dark:text-slate-500 pt-0.5">
              Affiliated with <a href="https://www.adaptcentre.ie" target="_blank" rel="noopener noreferrer" class="hover:underline">ADAPT Centre</a>
            </p>
          </div>
        </div>

        <!-- Contact & Office -->
        <div class="pt-3 border-t border-black/[0.08] dark:border-white/[0.08] text-xs space-y-1.5 text-slate-600 dark:text-slate-400">
          <div>
            <span class="text-slate-400 dark:text-slate-500 text-xs">Email: </span>
            <a href="mailto:pitief@tcd.ie" class="text-slate-800 dark:text-slate-200 hover:text-[#235789] dark:hover:text-[#82B4DC]">pitief@tcd.ie</a>
          </div>
          <div>
            <span class="text-slate-400 dark:text-slate-500 text-xs">Office: </span>
            <span>Room 3-22, Áras an Phiarsaigh</span>
          </div>
        </div>

        <!-- Academic Profiles Links -->
        <div class="pt-3 border-t border-black/[0.08] dark:border-white/[0.08] text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          <a href="https://scholar.google.com/citations?user=lOaoO74AAAAJ" target="_blank" rel="noopener noreferrer" class="hover:text-[#235789] dark:hover:text-[#82B4DC]">Scholar</a>
          <span class="mx-1 text-slate-300 dark:text-slate-700">&bull;</span>
          <a href="https://orcid.org/0000-0002-3925-5020" target="_blank" rel="noopener noreferrer" class="hover:text-[#235789] dark:hover:text-[#82B4DC]">ORCID</a>
          <span class="mx-1 text-slate-300 dark:text-slate-700">&bull;</span>
          <a href="https://github.com/frcs" target="_blank" rel="noopener noreferrer" class="hover:text-[#235789] dark:hover:text-[#82B4DC]">GitHub</a>
          <span class="mx-1 text-slate-300 dark:text-slate-700">&bull;</span>
          <a href="https://ie.linkedin.com/in/fran%C3%A7ois-piti%C3%A9-6182718b" target="_blank" rel="noopener noreferrer" class="hover:text-[#235789] dark:hover:text-[#82B4DC]">LinkedIn</a>
        </div>

        <!-- Flat minimal navigation menu -->
        <nav class="hidden md:block pt-3 border-t border-black/[0.08] dark:border-white/[0.08]">
          <ul class="space-y-1 text-xs sm:text-sm">
            {navItems.map(item => {
              const isExactActive = currentPath === item.href;
              const isParentActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
              return (
                <li>
                  <a
                    href={item.href}
                    class={`block py-1 transition-colors ${
                      isExactActive
                        ? 'text-[#235789] dark:text-[#82B4DC] font-semibold pl-2.5 border-l-2 border-[#235789]'
                        : isParentActive
                        ? 'text-[#235789] dark:text-[#82B4DC] font-medium pl-2.5 border-l-2 border-[#235789]/30'
                        : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 pl-3 border-l-2 border-transparent'
                    }`}
                  >
                    {item.name}
                  </a>

                  {/* Subfolder list */}
                  {item.children && (
                    <ul class="pl-3.5 py-0.5 space-y-1 border-l border-black/[0.07] dark:border-white/[0.08] ml-2.5 my-1">
                      {item.children.map(sub => {
                        const isSubActive = currentPath === sub.href;
                        return (
                          <li>
                            <a
                              href={sub.href}
                              class={`block py-0.5 text-xs transition-colors ${
                                isSubActive
                                  ? 'text-[#235789] dark:text-[#82B4DC] font-medium'
                                  : 'text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200'
                              }`}
                            >
                              {sub.name}
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  )}
                </li>
              );
            })}
          </ul>
        </nav>

        <!-- Institutional & Lab Logos (Subdued, quiet) -->
        <div class="pt-4 border-t border-black/[0.08] dark:border-white/[0.08] space-y-3.5">
          <div>
            <span class="text-[10px] uppercase tracking-wider font-mono text-slate-400 dark:text-slate-500 block mb-1">Research Lab</span>
            <a href="https://sigmedia.tv" target="_blank" rel="noopener noreferrer" class="inline-block opacity-85 hover:opacity-100 transition-opacity">
              <img src="/images/sigmedia-logo.png" alt="Sigmedia Research Group" class="h-8.5 w-auto max-w-[160px] object-contain object-left dark:hidden" />
              <img src="/images/sigmedia-logo-white.png" alt="Sigmedia Research Group" class="h-8.5 w-auto max-w-[160px] object-contain object-left hidden dark:block" />
            </a>
          </div>

          <div>
            <span class="text-[10px] uppercase tracking-wider font-mono text-slate-400 dark:text-slate-500 block mb-1">Institution</span>
            <a href="https://www.tcd.ie" target="_blank" rel="noopener noreferrer" class="inline-block opacity-85 hover:opacity-100 transition-opacity">
              <img src="/images/tcd-logo.png" alt="Trinity College Dublin" class="h-8.5 w-auto max-w-[160px] object-contain object-left dark:hidden" />
              <img src="/images/tcd-logo-white.png" alt="Trinity College Dublin" class="h-8.5 w-auto max-w-[160px] object-contain object-left hidden dark:block" />
            </a>
          </div>
        </div>

      </div>
    </aside>

    <!-- Right Content Area -->
    <main class="flex-1 min-w-0">
      <slot />
    </main>

  </div>

  <!-- Footer with Quiet Theme Toggle -->
  <footer class="mt-auto border-t border-slate-200/70 dark:border-slate-800 py-6 text-xs text-slate-500 dark:text-slate-400">
    <div class="max-w-5xl mx-auto px-5 sm:px-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
      <p>&copy; {new Date().getFullYear()} François Pitié &bull; Dept. of Electronic & Electrical Engineering &bull; Trinity College Dublin</p>
      
      <button id="theme-toggle-desktop" class="inline-flex items-center gap-1.5 text-xs text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-white transition-colors cursor-pointer">
        <svg class="w-3.5 h-3.5 hidden dark:block text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707-.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"/></svg>
        <svg class="w-3.5 h-3.5 block dark:hidden" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
        <span>Toggle Theme</span>
      </button>
    </div>
  </footer>

  <script>
    function setupThemeToggle(id) {
      const btn = document.getElementById(id);
      if (!btn) return;
      btn.addEventListener('click', () => {
        if (document.documentElement.classList.contains('dark')) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('color-theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('color-theme', 'dark');
        }
      });
    }
    setupThemeToggle('theme-toggle-desktop');
    setupThemeToggle('theme-toggle-mobile');

    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    if (menuToggle && mobileMenu) {
      menuToggle.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
    }
  </script>
</body>
</html>
