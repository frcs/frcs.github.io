---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentSection?: string;
}

const {
  title = "François Pitié - Academic Homepage",
  description = "Webpage of François Pitié, Ussher Assistant Professor at Trinity College Dublin",
  currentSection = "home"
} = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = currentPath === '/';

const navItems = [
  { name: "about", href: "/" },
  { 
    name: "research", 
    href: "/research",
    children: [
      { name: "Overview", href: "/research" },
      { name: "Colour Transfer", href: "/research/colour-transfer" },
      { name: "Deflicker", href: "/research/deflicker" },
      { name: "Scene Matching", href: "/research/scene-matching" },
      { name: "Selection & Matting", href: "/research/matting-laplacian" },
      { name: "Video Compression", href: "/research/video-compression" },
      { name: "Efficient AI", href: "/research/efficient-ai" }
    ]
  },
  { name: "publications", href: "/publications" },
  { 
    name: "teaching", 
    href: "/teaching",
    children: [
      { name: "Overview", href: "/teaching" },
      { name: "4C16 Deep Learning", href: "/teaching/4c16" },
      { name: "5C34 Advanced AI", href: "/teaching/5c34" },
      { name: "2E10 Design Project", href: "/teaching/2e10" },
      { name: "4C8 Image & Video", href: "/teaching/4c8" }
    ]
  },
  { name: "team", href: "/team" },
  { name: "grants", href: "/grants-impact" }
];
---

<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2">
  <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico?v=2">

  <!-- KaTeX CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous">

  <!-- Font Awesome & Academicons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/jpswalsh/academicons@1/css/academicons.min.css">

  <script is:inline>
    document.documentElement.classList.remove('dark');
    localStorage.removeItem('color-theme');
  </script>
</head>
<body class="min-h-screen flex flex-col antialiased bg-[var(--theme-bg)] text-[var(--theme-fg)]">
  
  <!-- Fixed Top Navbar (al-folio style) -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-[var(--theme-bg)]/90 backdrop-blur-md border-b border-[var(--theme-border)] transition-colors duration-200">
    <div class={`max-w-4xl mx-auto px-5 sm:px-8 h-14 flex items-center ${!isHome ? 'justify-between' : 'justify-end'}`}>
      
      {!isHome && (
        <a href="/" class="font-medium text-base tracking-tight text-[var(--theme-heading)] hover:text-[var(--theme-accent)] transition-colors inline-flex items-center">
          <span>François Pitié</span>
        </a>
      )}

      <!-- Desktop Navigation Menu -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2 text-sm">
        {navItems.map(item => {
          const isExactActive = currentPath === item.href;
          const isSectionActive = (item.href !== '/' && currentPath.startsWith(item.href)) ||
                                  (item.href === '/research' && currentSection === 'research') ||
                                  (item.href === '/teaching' && currentSection === 'teaching');
          const isActive = isExactActive || isSectionActive;

          if (item.children) {
            return (
              <div class="relative group">
                <a
                  href={item.href}
                  class={`px-2.5 py-1.5 rounded transition-colors inline-flex items-center gap-1 ${
                    isActive 
                      ? 'text-[var(--theme-accent)] font-semibold' 
                      : 'text-[var(--theme-fg)] hover:text-[var(--theme-accent)]'
                  }`}
                >
                  <span>{item.name}</span>
                  <svg class="w-3.5 h-3.5 opacity-60 group-hover:opacity-100 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </a>

                <!-- Dropdown Menu -->
                <div class="absolute left-0 top-full hidden group-hover:block pt-1 z-50">
                  <div class="bg-[var(--theme-card)] border border-[var(--theme-border)] shadow-lg rounded-md py-1.5 min-w-[175px] backdrop-blur-sm">
                    {item.children.map(sub => {
                      const isSubActive = currentPath === sub.href;
                      return (
                        <a
                          href={sub.href}
                          class={`block px-3.5 py-1.5 text-xs transition-colors ${
                            isSubActive
                              ? 'text-[var(--theme-accent)] font-semibold bg-black/[0.03]'
                              : 'text-[var(--theme-fg)] hover:text-[var(--theme-accent)] hover:bg-black/[0.03]'
                          }`}
                        >
                          {sub.name}
                        </a>
                      );
                    })}
                  </div>
                </div>
              </div>
            );
          }

          return (
            <a
              href={item.href}
              class={`px-2.5 py-1.5 rounded transition-colors ${
                isActive 
                  ? 'text-[var(--theme-accent)] font-semibold' 
                  : 'text-[var(--theme-fg)] hover:text-[var(--theme-accent)]'
              }`}
            >
              {item.name}
            </a>
          );
        })}
      </nav>

      <!-- Mobile Right Controls (Hamburger only) -->
      <div class="flex items-center gap-1 md:hidden">
        <button
          id="menu-toggle"
          aria-label="Toggle navigation menu"
          class="p-2 text-[var(--theme-fg)] hover:text-[var(--theme-accent)] transition-colors rounded cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>

    <!-- Mobile Drawer Menu -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-[var(--theme-border)] bg-[var(--theme-bg)] px-5 py-4 space-y-2">
      {navItems.map(item => {
        const isExactActive = currentPath === item.href;
        const isSectionActive = (item.href !== '/' && currentPath.startsWith(item.href)) ||
                                (item.href === '/research' && currentSection === 'research') ||
                                (item.href === '/teaching' && currentSection === 'teaching');
        const isActive = isExactActive || isSectionActive;

        return (
          <div>
            <a
              href={item.href}
              class={`block py-1.5 text-sm transition-colors ${
                isActive 
                  ? 'text-[var(--theme-accent)] font-semibold' 
                  : 'text-[var(--theme-fg)]'
              }`}
            >
              {item.name}
            </a>

            {item.children && (
              <div class="pl-4 py-1 space-y-1">
                {item.children.map(sub => {
                  const isSubActive = currentPath === sub.href;
                  return (
                    <a
                      href={sub.href}
                      class={`block py-1 text-xs transition-colors ${
                        isSubActive
                          ? 'text-[var(--theme-accent)] font-medium'
                          : 'text-[var(--theme-muted)] hover:text-[var(--theme-accent)]'
                      }`}
                    >
                      {sub.name}
                    </a>
                  );
                })}
              </div>
            )}
          </div>
        );
      })}
    </div>
  </header>

  <!-- Main Centered Content Container (al-folio single-column format) -->
  <main class="max-w-4xl mx-auto w-full px-5 sm:px-8 pt-20 sm:pt-24 pb-16 flex-1">
    <slot />
  </main>

  <!-- Footer (al-folio style) -->
  <footer class="border-t border-[var(--theme-border)] py-8 text-xs text-[var(--theme-muted)] transition-colors duration-200">
    <div class="max-w-4xl mx-auto px-5 sm:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div>
        <p>&copy; {new Date().getFullYear()} François Pitié &bull; Department of Electronic & Electrical Engineering &bull; Trinity College Dublin</p>
      </div>

      <div class="flex items-center gap-5 sm:gap-6">
        <a 
          href="https://www.tcd.ie" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="opacity-80 hover:opacity-100 transition-opacity inline-flex items-center" 
          title="Trinity College Dublin"
        >
          <img src="/images/tcd-logo.png" alt="Trinity College Dublin" class="h-9 sm:h-10 w-auto" />
        </a>

        <span class="text-[var(--theme-border)] text-sm">&bull;</span>

        <a 
          href="https://sigmedia.tv" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="opacity-80 hover:opacity-100 transition-opacity inline-flex items-center" 
          title="Sigmedia Research Group"
        >
          <img src="/images/sigmedia-logo.svg" alt="Sigmedia Research Group" class="h-8 sm:h-9 w-auto" />
        </a>
      </div>
    </div>
  </footer>

  <script>
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    if (menuToggle && mobileMenu) {
      menuToggle.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
    }
  </script>
</body>
</html>
