---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentSection?: string;
}

const {
  title = "François Pitié - Academic Homepage",
  description = "Webpage of François Pitié, Ussher Assistant Professor at Trinity College Dublin",
  currentSection = "home"
} = Astro.props;

const navItems = [
  { name: "Home", href: "/" },
  { name: "Research", href: "/research" },
  { name: "Publications", href: "/publications" },
  { name: "Teaching", href: "/teaching" },
  { name: "Team & Alumni", href: "/team" },
  { name: "Grants & Impact", href: "/grants-impact" }
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <script is:inline>
    // Dark mode detection / persistence
    if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>
</head>
<body class="min-h-screen flex flex-col bg-[#fafbfc] dark:bg-[#0b1120] text-slate-800 dark:text-slate-200 antialiased transition-colors duration-200 text-sm sm:text-base">
  
  <!-- Top TCD Accent Bar -->
  <div class="h-1 w-full bg-[#0569B9]"></div>

  <!-- Mobile Header -->
  <header class="md:hidden flex items-center justify-between px-4 py-3 bg-white dark:bg-[#111928] border-b border-slate-200 dark:border-slate-800 sticky top-0 z-40">
    <div class="flex items-center gap-2.5">
      <img src="/images/tcd-logo-min.jpg" alt="Trinity College Dublin" class="h-8 w-auto" />
      <a href="/" class="font-bold text-slate-900 dark:text-white text-base">François Pitié</a>
    </div>
    <div class="flex items-center gap-2">
      <button id="theme-toggle-mobile" aria-label="Toggle dark mode" class="p-2 rounded text-slate-500 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800">
        <svg class="w-5 h-5 hidden dark:block text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"/></svg>
        <svg class="w-5 h-5 block dark:hidden" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
      </button>
      <button id="menu-toggle" aria-label="Open Navigation" class="p-2 rounded text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </header>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden md:hidden bg-white dark:bg-[#111928] border-b border-slate-200 dark:border-slate-800 px-4 py-3 space-y-1">
    {navItems.map(item => (
      <a
        href={item.href}
        class={`block px-3 py-2 text-base font-medium transition-colors ${
          Astro.url.pathname === item.href || (item.href !== '/' && Astro.url.pathname.startsWith(item.href))
            ? 'text-[#0569B9] dark:text-[#82B4DC] font-semibold pl-2 border-l-2 border-[#0569B9]'
            : 'text-slate-600 dark:text-slate-300 hover:text-slate-900'
        }`}
      >
        {item.name}
      </a>
    ))}
  </div>

  <!-- Main 2-Column Container -->
  <div class="max-w-6xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-10 flex-1 flex flex-col md:flex-row gap-12">
    
    <!-- Left Column (Compact profiles, clear hierarchy) -->
    <aside class="w-full md:w-56 lg:w-60 shrink-0">
      <div class="sticky top-10 space-y-5">
        
        <!-- Profile Identity -->
        <div>
          <!-- Perfectly sized portrait: 180px wide with accurate 4:5 crop -->
          <div class="w-[180px] h-[225px] rounded-lg overflow-hidden mb-3.5 bg-slate-100 dark:bg-slate-800 shadow-xs border border-slate-200/60 dark:border-slate-800">
            <img 
              src="/images/pitief.jpg" 
              alt="François Pitié" 
              class="w-full h-full object-cover object-[center_15%]"
              loading="eager"
            />
          </div>

          <h1 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight">François Pitié</h1>
          <p class="text-sm text-[#0569B9] dark:text-[#82B4DC] font-semibold mt-0.5">Ussher Assistant Professor</p>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Fellow of Trinity College Dublin (FTCD)</p>
          
          <div class="mt-3 text-sm text-slate-600 dark:text-slate-300 space-y-0.5 leading-normal">
            <p>
              <a href="https://www.tcd.ie/eleceng/" target="_blank" rel="noopener noreferrer" class="hover:underline">
                Dept. of Electronic & Elec. Eng.
              </a>
            </p>
            <p>
              <a href="https://www.tcd.ie" target="_blank" rel="noopener noreferrer" class="hover:underline font-medium text-slate-800 dark:text-slate-200">
                Trinity College Dublin
              </a>
            </p>
            <p class="text-xs text-slate-500 dark:text-slate-400 pt-0.5">
              <a href="https://sigmedia.tv" target="_blank" rel="noopener noreferrer" class="hover:underline">Sigmedia</a> &bull; 
              <a href="https://www.adaptcentre.ie" target="_blank" rel="noopener noreferrer" class="hover:underline">ADAPT Centre</a>
            </p>
          </div>
        </div>

        <!-- Contact & Office -->
        <div class="pt-3 border-t border-slate-200 dark:border-slate-800 text-xs sm:text-sm space-y-1 text-slate-600 dark:text-slate-300">
          <div>
            <span class="text-slate-400 dark:text-slate-500 font-mono text-xs">Email: </span>
            <a href="mailto:pitief@tcd.ie" class="text-slate-800 dark:text-slate-200 hover:text-[#0569B9] dark:hover:text-[#82B4DC] font-medium">pitief@tcd.ie</a>
          </div>
          <div class="leading-snug">
            <span class="text-slate-400 dark:text-slate-500 font-mono text-xs">Office: </span>
            <span>Room 3-22, Áras an Phiarsaigh</span>
          </div>
        </div>

        <!-- Compact Academic Profiles Links -->
        <div class="pt-3 border-t border-slate-200 dark:border-slate-800 text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          <a href="https://scholar.google.com/citations?user=lOaoO74AAAAJ" target="_blank" rel="noopener noreferrer" class="hover:text-[#0569B9] dark:hover:text-[#82B4DC]">Google Scholar</a>
          <span class="mx-1 text-slate-300 dark:text-slate-700">&bull;</span>
          <a href="https://orcid.org/0000-0002-3925-5020" target="_blank" rel="noopener noreferrer" class="hover:text-[#0569B9] dark:hover:text-[#82B4DC]">ORCID</a>
          <span class="mx-1 text-slate-300 dark:text-slate-700">&bull;</span>
          <a href="https://github.com/frcs" target="_blank" rel="noopener noreferrer" class="hover:text-[#0569B9] dark:hover:text-[#82B4DC]">GitHub</a>
          <span class="mx-1 text-slate-300 dark:text-slate-700">&bull;</span>
          <a href="https://ie.linkedin.com/in/fran%C3%A7ois-piti%C3%A9-6182718b" target="_blank" rel="noopener noreferrer" class="hover:text-[#0569B9] dark:hover:text-[#82B4DC]">LinkedIn</a>
          <span class="mx-1 text-slate-300 dark:text-slate-700">&bull;</span>
          <a href="https://www.researchgate.net/profile/F_Pitie" target="_blank" rel="noopener noreferrer" class="hover:text-[#0569B9] dark:hover:text-[#82B4DC]">ResearchGate</a>
        </div>

        <!-- Flat navigation menu -->
        <nav class="hidden md:block pt-3 border-t border-slate-200 dark:border-slate-800">
          <ul class="space-y-0.5">
            {navItems.map(item => {
              const isActive = Astro.url.pathname === item.href || (item.href !== '/' && Astro.url.pathname.startsWith(item.href));
              return (
                <li>
                  <a
                    href={item.href}
                    class={`block py-1.5 text-sm transition-colors ${
                      isActive
                        ? 'text-[#0569B9] dark:text-[#82B4DC] font-semibold pl-2.5 border-l-2 border-[#0569B9]'
                        : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 pl-3 border-l-2 border-transparent'
                    }`}
                  >
                    {item.name}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>

        <!-- Theme toggle & TCD Logo -->
        <div class="hidden md:flex items-center justify-between pt-3 border-t border-slate-200 dark:border-slate-800 text-xs text-slate-500">
          <button id="theme-toggle-desktop" class="flex items-center gap-1.5 hover:text-slate-700 dark:hover:text-slate-200 transition-colors">
            <svg class="w-4 h-4 hidden dark:block text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"/></svg>
            <svg class="w-4 h-4 block dark:hidden" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
            <span>Theme toggle</span>
          </button>
        </div>

        <div class="pt-2">
          <a href="https://www.tcd.ie" target="_blank" rel="noopener noreferrer" class="inline-block opacity-80 hover:opacity-100 transition-opacity">
            <img src="/images/tcd-logo-min.jpg" alt="Trinity College Dublin" class="h-8 w-auto" />
          </a>
        </div>

      </div>
    </aside>

    <!-- Right Content Area -->
    <main class="flex-1 min-w-0">
      <slot />
    </main>

  </div>

  <!-- Footer -->
  <footer class="mt-auto border-t border-slate-200 dark:border-slate-800 py-6 text-center text-xs text-slate-500 dark:text-slate-400">
    <div class="max-w-6xl mx-auto px-4">
      <p>&copy; {new Date().getFullYear()} François Pitié &bull; Department of Electronic & Electrical Engineering &bull; Trinity College Dublin</p>
    </div>
  </footer>

  <script>
    function setupThemeToggle(id) {
      const btn = document.getElementById(id);
      if (!btn) return;
      btn.addEventListener('click', () => {
        if (document.documentElement.classList.contains('dark')) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('color-theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('color-theme', 'dark');
        }
      });
    }
    setupThemeToggle('theme-toggle-desktop');
    setupThemeToggle('theme-toggle-mobile');

    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    if (menuToggle && mobileMenu) {
      menuToggle.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
    }
  </script>
</body>
</html>
