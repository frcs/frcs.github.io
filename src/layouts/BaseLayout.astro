---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentSection?: string;
}

const {
  title = "François Pitié - Academic Homepage",
  description = "Webpage of François Pitié, Ussher Assistant Professor at Trinity College Dublin",
  currentSection = "home"
} = Astro.props;

const navItems = [
  { name: "Home", href: "/" },
  { name: "Research", href: "/research" },
  { name: "Publications", href: "/publications" },
  { name: "Teaching", href: "/teaching" },
  { name: "Team & Alumni", href: "/team" },
  { name: "Grants & Impact", href: "/grants-impact" }
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <script is:inline>
    // Simple dark mode detection / persistence
    if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>
</head>
<body class="min-h-screen flex flex-col bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-200 antialiased transition-colors duration-200">
  
  <!-- Mobile Header -->
  <header class="md:hidden flex items-center justify-between px-4 py-3 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 sticky top-0 z-40">
    <a href="/" class="font-semibold text-slate-900 dark:text-white">François Pitié</a>
    <div class="flex items-center gap-2">
      <button id="theme-toggle-mobile" aria-label="Toggle dark mode" class="p-2 rounded-lg text-slate-500 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800">
        <svg class="w-5 h-5 hidden dark:block" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"/></svg>
        <svg class="w-5 h-5 block dark:hidden" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
      </button>
      <button id="menu-toggle" aria-label="Open Navigation" class="p-2 rounded-lg text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </header>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden md:hidden bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 px-4 py-3 space-y-1">
    {navItems.map(item => (
      <a
        href={item.href}
        class={`block px-3 py-2 rounded-md text-sm font-medium transition-colors ${
          Astro.url.pathname === item.href || (item.href !== '/' && Astro.url.pathname.startsWith(item.href))
            ? 'bg-slate-100 dark:bg-slate-800 text-sky-700 dark:text-sky-400 font-semibold'
            : 'text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/60'
        }`}
      >
        {item.name}
      </a>
    ))}
  </div>

  <!-- Main 2-Column Container -->
  <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 flex-1 flex flex-col md:flex-row gap-8">
    
    <!-- Left Sidebar (jemdoc-inspired, modern & clean) -->
    <aside class="w-full md:w-64 lg:w-72 shrink-0">
      <div class="sticky top-8 space-y-6">
        
        <!-- Profile Card -->
        <div class="bg-white dark:bg-slate-900 rounded-xl p-5 border border-slate-200 dark:border-slate-800 shadow-xs text-center md:text-left">
          <div class="relative w-36 h-36 mx-auto md:mx-0 rounded-xl overflow-hidden border border-slate-200 dark:border-slate-700 shadow-inner mb-4 bg-slate-100 dark:bg-slate-800">
            <img 
              src="/images/deepart-francois-2.jpg" 
              alt="François Pitié" 
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>

          <h1 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight">François Pitié</h1>
          <p class="text-xs font-medium text-sky-700 dark:text-sky-400 mt-0.5">Ussher Assistant Professor</p>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">FTCD (Fellow of Trinity College Dublin)</p>
          
          <div class="mt-3 text-xs text-slate-600 dark:text-slate-300 space-y-1">
            <p>
              <a href="https://www.tcd.ie/eleceng/" target="_blank" rel="noopener noreferrer" class="hover:underline text-slate-700 dark:text-slate-200">
                Dept. of Electronic & Electrical Eng.
              </a>
            </p>
            <p>
              <a href="https://www.tcd.ie" target="_blank" rel="noopener noreferrer" class="hover:underline text-slate-700 dark:text-slate-200">
                Trinity College Dublin
              </a>
            </p>
            <p class="text-slate-500 dark:text-slate-400">
              <a href="https://sigmedia.tv" target="_blank" rel="noopener noreferrer" class="hover:underline">Sigmedia</a> &bull; 
              <a href="https://www.adaptcentre.ie" target="_blank" rel="noopener noreferrer" class="hover:underline">ADAPT Centre</a>
            </p>
          </div>

          <hr class="my-4 border-slate-100 dark:border-slate-800" />

          <!-- Contact & Profiles -->
          <div class="text-xs space-y-2 text-slate-600 dark:text-slate-300">
            <div class="flex items-center gap-2">
              <span class="text-slate-400 font-mono text-[11px]">Email:</span>
              <a href="mailto:pitief@tcd.ie" class="text-sky-700 dark:text-sky-400 hover:underline">pitief@tcd.ie</a>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-slate-400 font-mono text-[11px]">Office:</span>
              <span>Room 3-22, Áras an Phiarsaigh, TCD</span>
            </div>
          </div>

          <hr class="my-4 border-slate-100 dark:border-slate-800" />

          <!-- Academic Links -->
          <div class="flex flex-wrap gap-1.5 justify-center md:justify-start">
            <a href="https://scholar.google.com/citations?user=lOaoO74AAAAJ" target="_blank" rel="noopener noreferrer" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-[11px] font-medium rounded text-slate-700 dark:text-slate-300 transition-colors">
              Google Scholar
            </a>
            <a href="https://orcid.org/0000-0002-3925-5020" target="_blank" rel="noopener noreferrer" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-[11px] font-medium rounded text-slate-700 dark:text-slate-300 transition-colors">
              ORCID
            </a>
            <a href="https://github.com/frcs" target="_blank" rel="noopener noreferrer" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-[11px] font-medium rounded text-slate-700 dark:text-slate-300 transition-colors">
              GitHub
            </a>
            <a href="https://ie.linkedin.com/in/fran%C3%A7ois-piti%C3%A9-6182718b" target="_blank" rel="noopener noreferrer" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-[11px] font-medium rounded text-slate-700 dark:text-slate-300 transition-colors">
              LinkedIn
            </a>
            <a href="https://www.researchgate.net/profile/F_Pitie" target="_blank" rel="noopener noreferrer" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-[11px] font-medium rounded text-slate-700 dark:text-slate-300 transition-colors">
              ResearchGate
            </a>
          </div>
        </div>

        <!-- Navigation Menu -->
        <nav class="hidden md:block bg-white dark:bg-slate-900 rounded-xl p-2 border border-slate-200 dark:border-slate-800 shadow-xs">
          <ul class="space-y-1">
            {navItems.map(item => (
              <li>
                <a
                  href={item.href}
                  class={`flex items-center px-3 py-2 rounded-lg text-sm transition-colors ${
                    Astro.url.pathname === item.href || (item.href !== '/' && Astro.url.pathname.startsWith(item.href))
                      ? 'bg-sky-50 dark:bg-sky-950/50 text-sky-700 dark:text-sky-300 font-semibold border-l-3 border-sky-600 pl-2.5'
                      : 'text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-slate-100'
                  }`}
                >
                  {item.name}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <!-- Dark Mode & Affiliations Badge -->
        <div class="hidden md:flex items-center justify-between px-3 py-2 text-xs text-slate-500 dark:text-slate-400">
          <span>Theme</span>
          <button id="theme-toggle-desktop" class="flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-slate-200 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors text-slate-600 dark:text-slate-300">
            <svg class="w-3.5 h-3.5 hidden dark:block" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"/></svg>
            <svg class="w-3.5 h-3.5 block dark:hidden" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
            <span class="text-[11px]">Mode</span>
          </button>
        </div>

        <div class="pt-2 text-center md:text-left">
          <img src="/images/tcd-logo-min.jpg" alt="Trinity College Dublin" class="h-10 opacity-75 dark:opacity-90 inline-block" />
        </div>

      </div>
    </aside>

    <!-- Right Content Area -->
    <main class="flex-1 min-w-0">
      <div class="bg-white dark:bg-slate-900 rounded-xl p-6 sm:p-8 border border-slate-200 dark:border-slate-800 shadow-xs">
        <slot />
      </div>
    </main>

  </div>

  <!-- Footer -->
  <footer class="mt-auto border-t border-slate-200 dark:border-slate-800/80 bg-white/50 dark:bg-slate-900/50 py-6 text-center text-xs text-slate-500 dark:text-slate-400">
    <div class="max-w-7xl mx-auto px-4">
      <p>&copy; {new Date().getFullYear()} François Pitié &bull; Department of Electronic & Electrical Engineering &bull; Trinity College Dublin</p>
    </div>
  </footer>

  <script>
    // Theme toggle setup
    function setupThemeToggle(id) {
      const btn = document.getElementById(id);
      if (!btn) return;
      btn.addEventListener('click', () => {
        if (document.documentElement.classList.contains('dark')) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('color-theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('color-theme', 'dark');
        }
      });
    }
    setupThemeToggle('theme-toggle-desktop');
    setupThemeToggle('theme-toggle-mobile');

    // Mobile menu toggle
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    if (menuToggle && mobileMenu) {
      menuToggle.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
    }
  </script>
</body>
</html>
