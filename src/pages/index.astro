---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadPublications, cleanLatex, formatAuthors } from '../utils/bibtex';

const allPubs = loadPublications();
const selectedKeys = [
  'Piti:2007:automated',
  'Pitie:2005:ndimensional',
  'Forte:2020:interactive',
  'Forte:2020:fb',
  'Bled:2024:lightweight',
  'Bled:2023:pushing',
  'Ringis:2025:demystifying',
  'Ringis:2023:disparity'
];

const selectedPubs = selectedKeys
  .map(key => allPubs.find(p => p.citationKey.toLowerCase() === key.toLowerCase()))
  .filter(Boolean);

const news = [
  {
    date: '2026',
    text: 'Awarded the <strong>University Excellence in Teaching Award</strong> and the <strong>Inspiring Educator Award</strong> by Trinity College Dublin.'
  },
  {
    date: '2026',
    text: 'Elected Fellow of Trinity College Dublin (FTCD).'
  },
  {
    date: '2025',
    text: 'Paper on <em>Demystifying the use of Compression in Virtual Production</em> published in the SMPTE Motion Imaging Journal.'
  },
  {
    date: '2025',
    text: 'Released course lecture notes on <a href="https://doi.org/10.5281/zenodo.17954655" target="_blank" class="text-[#0569B9] dark:text-[#82B4DC] hover:underline">Deep Learning and its Applications</a> on Zenodo.'
  },
  {
    date: '2024',
    text: 'Paper on <em>Lightweight Video Denoising Using a Classic Bayesian Backbone</em> presented at IEEE ICME 2024.'
  },
  {
    date: '2023',
    text: 'Horizon Europe project <strong>EMERALD</strong> (AI and Process Automation for Sustainable Entertainment and Media) commenced with European partners.'
  },
  {
    date: '2023',
    text: 'Paper on <em>Pushing the Limits of the Wiener Filter in Image Denoising</em> presented at IEEE ICIP 2023.'
  }
];

const researchThemes = [
  {
    title: "Colour Transfer & Optimal Transport",
    desc: "Mathematical formulations based on continuous Monge-Kantorovich optimal transport and probability density transfer for automated colour grading and film restoration."
  },
  {
    title: "Interactive Vision & Alpha Matting",
    desc: "Human-in-the-loop deep learning architectures (F, B, Alpha Matting and interactive object selection) providing boundary control with minimal user interactions."
  },
  {
    title: "Sustainable Video Processing & Codecs",
    desc: "Lightweight statistical/neural hybrid backbones and perceptual rate-distortion optimization (AOMedia AV1/AVM) to reduce computational footprint and energy consumption."
  }
];
---

<BaseLayout title="François Pitié - Academic Homepage" currentSection="home">
  
  <!-- Academic Bio Section -->
  <section class="mb-12">
    <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white mb-4 pb-2 border-b border-slate-200 dark:border-slate-800">
      Academic Bio
    </h2>
    <div class="text-sm sm:text-base leading-relaxed space-y-3.5 text-slate-700 dark:text-slate-300">
      <p>
        I am an <strong>Ussher Assistant Professor</strong> in Media Signal Processing at the 
        <a href="https://www.tcd.ie/eleceng/" target="_blank" rel="noopener noreferrer" class="text-[#0569B9] dark:text-[#82B4DC] hover:underline font-medium">Department of Electronic & Electrical Engineering</a>, 
        <a href="https://www.tcd.ie" target="_blank" rel="noopener noreferrer" class="text-[#0569B9] dark:text-[#82B4DC] hover:underline font-medium">Trinity College Dublin</a>. 
        I am a Principal Investigator with the <a href="https://sigmedia.tv" target="_blank" rel="noopener noreferrer" class="text-[#0569B9] dark:text-[#82B4DC] hover:underline font-medium">Sigmedia Research Group</a>, 
        an Academic Collaborator at the <a href="https://www.adaptcentre.ie" target="_blank" rel="noopener noreferrer" class="text-[#0569B9] dark:text-[#82B4DC] hover:underline font-medium">ADAPT Research Centre</a>, 
        and an elected <strong>Fellow of Trinity College Dublin (FTCD)</strong>.
      </p>
      <p>
        My research focuses on applied mathematics and machine learning models for visual media processing, film postproduction, and video compression. 
        Core areas include continuous optimal transport for automated colour transfer, interactive trimap-free alpha matting, and energy-efficient neural video processing.
      </p>
      <p>
        Applied outcomes of this work include algorithms licensed in commercial postproduction suites (such as The Foundry’s Furnace suite for Nuke), 
        technology transfers to visual AI platforms including PhotoRoom, and ongoing contributions to international video compression standards within the Alliance for Open Media (AOMedia).
      </p>
    </div>
  </section>

  <!-- Research Themes (Flat list with sober left border) -->
  <section class="mb-12">
    <div class="flex items-center justify-between mb-4 pb-2 border-b border-slate-200 dark:border-slate-800">
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Research Themes</h2>
      <a href="/research" class="text-xs sm:text-sm text-[#0569B9] dark:text-[#82B4DC] hover:underline font-medium">Details &rarr;</a>
    </div>

    <div class="space-y-4">
      {researchThemes.map(theme => (
        <div class="border-l-2 border-[#0569B9]/60 pl-4 py-1">
          <h3 class="text-base sm:text-lg font-semibold text-slate-900 dark:text-slate-100">{theme.title}</h3>
          <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 mt-1 leading-relaxed">{theme.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Recent News (Flat list) -->
  <section class="mb-12">
    <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white mb-4 pb-2 border-b border-slate-200 dark:border-slate-800">
      Recent News
    </h2>
    <div class="space-y-3">
      {news.map(item => (
        <div class="flex items-baseline gap-3 text-sm sm:text-base">
          <span class="font-mono text-sm font-semibold text-[#0569B9] dark:text-[#82B4DC] shrink-0">
            [{item.date}]
          </span>
          <span class="text-slate-700 dark:text-slate-300" set:html={item.text} />
        </div>
      ))}
    </div>
  </section>

  <!-- Selected Publications (Flat list) -->
  <section>
    <div class="flex items-center justify-between mb-4 pb-2 border-b border-slate-200 dark:border-slate-800">
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Selected Publications</h2>
      <a href="/publications" class="text-xs sm:text-sm text-[#0569B9] dark:text-[#82B4DC] hover:underline font-medium">All publications &rarr;</a>
    </div>

    <div class="space-y-4">
      {selectedPubs.map((pub, idx) => (
        <div class="border-l-2 border-slate-200 dark:border-slate-800 pl-3.5 py-0.5 hover:border-[#0569B9] transition-colors">
          <div class="text-base sm:text-lg font-semibold text-slate-900 dark:text-slate-100 leading-snug">
            {pub.entryTags.url ? (
              <a href={pub.entryTags.url} target="_blank" rel="noopener noreferrer" class="hover:text-[#0569B9] dark:hover:text-[#82B4DC]">
                {cleanLatex(pub.entryTags.title)}
              </a>
            ) : pub.entryTags.doi ? (
              <a href={`https://doi.org/${pub.entryTags.doi}`} target="_blank" rel="noopener noreferrer" class="hover:text-[#0569B9] dark:hover:text-[#82B4DC]">
                {cleanLatex(pub.entryTags.title)}
              </a>
            ) : (
              cleanLatex(pub.entryTags.title)
            )}
          </div>
          
          <div class="text-sm text-slate-600 dark:text-slate-400 mt-1" set:html={formatAuthors(pub.entryTags.author || pub.entryTags.editor)} />
          
          <div class="text-xs sm:text-sm text-slate-500 dark:text-slate-500 mt-1 flex items-center gap-2 flex-wrap">
            <span class="italic">{cleanLatex(pub.entryTags.journal || pub.entryTags.booktitle || pub.entryTags.howpublished)}</span>
            <span>&bull;</span>
            <span>{pub.entryTags.year}</span>
            {pub.entryTags.doi && (
              <a href={`https://doi.org/${pub.entryTags.doi}`} target="_blank" rel="noopener noreferrer" class="text-[#0569B9] dark:text-[#82B4DC] hover:underline font-mono text-xs font-medium">
                [DOI]
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

</BaseLayout>
