---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadPublications, cleanLatex, formatAuthors } from '../utils/bibtex';

const allPubs = loadPublications();
const selectedKeys = [
  'Piti:2007:automated',
  'Pitie:2005:ndimensional',
  'Forte:2020:interactive',
  'Forte:2020:fb',
  'Bled:2024:lightweight',
  'Bled:2023:pushing',
  'Ringis:2025:demystifying',
  'Ringis:2023:disparity'
];

const selectedPubs = selectedKeys
  .map(key => allPubs.find(p => p.citationKey.toLowerCase() === key.toLowerCase()))
  .filter(Boolean);

const news = [
  {
    date: '2026',
    text: 'Awarded the <strong>University Excellence in Teaching Award</strong> and the <strong>Inspiring Educator Award</strong> by Trinity College Dublin.'
  },
  {
    date: '2026',
    text: 'Elected Fellow of Trinity College Dublin (FTCD).'
  },
  {
    date: '2025',
    text: 'Paper on <em>Demystifying the use of Compression in Virtual Production</em> published in the SMPTE Motion Imaging Journal.'
  },
  {
    date: '2025',
    text: 'Released course lecture notes on <a href="https://doi.org/10.5281/zenodo.17954655" target="_blank" class="text-[#2B79C2] dark:text-[#73D0FF] hover:underline">Deep Learning and its Applications</a> on Zenodo.'
  },
  {
    date: '2024',
    text: 'Paper on <em>Lightweight Video Denoising Using a Classic Bayesian Backbone</em> presented at IEEE ICME 2024.'
  },
  {
    date: '2023',
    text: 'Horizon Europe project <strong>EMERALD</strong> (AI and Process Automation for Sustainable Entertainment and Media) commenced with European partners.'
  },
  {
    date: '2023',
    text: 'Paper on <em>Pushing the Limits of the Wiener Filter in Image Denoising</em> presented at IEEE ICIP 2023.'
  }
];

const researchThemes = [
  {
    title: "Colour Transfer & Optimal Transport",
    desc: "Mathematical formulations based on continuous Monge-Kantorovich optimal transport and probability density transfer for automated colour grading and film restoration."
  },
  {
    title: "Interactive Vision & Alpha Matting",
    desc: "Human-in-the-loop deep learning architectures (F, B, Alpha Matting and interactive object selection) providing boundary control with minimal user interactions."
  },
  {
    title: "Sustainable Video Processing & Codecs",
    desc: "Lightweight statistical/neural hybrid backbones and perceptual rate-distortion optimization (AOMedia AV1/AVM) to reduce computational footprint and energy consumption."
  }
];
---

<BaseLayout title="François Pitié - Academic Homepage" currentSection="home">
  
  <!-- Academic Bio Section -->
  <section class="mb-12">
    <h2 class="text-lg font-semibold tracking-tight text-[#242936] dark:text-[#ECEFF4] mb-3.5 pb-2 border-b border-[#E6E8EB] dark:border-white/[0.08]">
      Academic Bio
    </h2>
    <div class="leading-relaxed space-y-3.5 text-[#5C6166] dark:text-[#ECEFF4]">
      <p>
        I am an <strong>Ussher Assistant Professor</strong> in Media Signal Processing at the 
        <a href="https://www.tcd.ie/eleceng/" target="_blank" rel="noopener noreferrer" class="text-[#2B79C2] dark:text-[#73D0FF] hover:underline">Department of Electronic & Electrical Engineering</a>, 
        <a href="https://www.tcd.ie" target="_blank" rel="noopener noreferrer" class="text-[#2B79C2] dark:text-[#73D0FF] hover:underline">Trinity College Dublin</a>. 
        I am a Principal Investigator with the <a href="https://sigmedia.tv" target="_blank" rel="noopener noreferrer" class="text-[#2B79C2] dark:text-[#73D0FF] hover:underline">Sigmedia Research Group</a>, 
        an Academic Collaborator at the <a href="https://www.adaptcentre.ie" target="_blank" rel="noopener noreferrer" class="text-[#2B79C2] dark:text-[#73D0FF] hover:underline">ADAPT Research Centre</a>, 
        and an elected <strong>Fellow of Trinity College Dublin (FTCD)</strong>.
      </p>
      <p>
        My research focuses on applied mathematics and machine learning models for visual media processing, film postproduction, and video compression. 
        Core areas include continuous optimal transport for automated colour transfer, interactive trimap-free alpha matting, and energy-efficient neural video processing.
      </p>
      <p>
        Applied outcomes of this work include algorithms licensed in commercial postproduction suites (such as The Foundry’s Furnace suite for Nuke), 
        technology transfers to visual AI platforms including PhotoRoom, and ongoing contributions to international video compression standards within the Alliance for Open Media (AOMedia).
      </p>
    </div>
  </section>

  <!-- Research Themes -->
  <section class="mb-12">
    <div class="flex items-center justify-between mb-3.5 pb-2 border-b border-[#E6E8EB] dark:border-white/[0.08]">
      <h2 class="text-lg font-semibold tracking-tight text-[#242936] dark:text-[#ECEFF4]">Research Themes</h2>
      <a href="/research" class="text-xs text-[#2B79C2] dark:text-[#73D0FF] hover:underline">Details &rarr;</a>
    </div>

    <div class="space-y-4">
      {researchThemes.map(theme => (
        <div class="py-0.5">
          <h3 class="font-medium text-[#242936] dark:text-[#ECEFF4]">{theme.title}</h3>
          <p class="text-sm text-[#828E9F] dark:text-[#707A8C] mt-0.5 leading-relaxed">{theme.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Recent News -->
  <section class="mb-12">
    <h2 class="text-lg font-semibold tracking-tight text-[#242936] dark:text-[#ECEFF4] mb-3.5 pb-2 border-b border-[#E6E8EB] dark:border-white/[0.08]">
      Recent News
    </h2>
    <div class="space-y-3">
      {news.map(item => (
        <div class="flex items-baseline gap-3 text-sm">
          <span class="font-mono text-xs text-[#F29718] shrink-0">
            {item.date}
          </span>
          <span class="text-[#5C6166] dark:text-[#ECEFF4] leading-relaxed" set:html={item.text} />
        </div>
      ))}
    </div>
  </section>

  <!-- Selected Publications -->
  <section>
    <div class="flex items-center justify-between mb-3.5 pb-2 border-b border-[#E6E8EB] dark:border-white/[0.08]">
      <h2 class="text-lg font-semibold tracking-tight text-[#242936] dark:text-[#ECEFF4]">Selected Publications</h2>
      <a href="/publications" class="text-xs text-[#2B79C2] dark:text-[#73D0FF] hover:underline">All publications &rarr;</a>
    </div>

    <div class="space-y-3">
      {selectedPubs.map((pub, idx) => (
        <div class="py-0.5">
          <div class="font-medium text-[#242936] dark:text-[#ECEFF4] leading-snug text-sm">
            {pub.entryTags.url ? (
              <a href={pub.entryTags.url} target="_blank" rel="noopener noreferrer" class="hover:text-[#2B79C2] dark:hover:text-[#73D0FF]">
                {cleanLatex(pub.entryTags.title)}
              </a>
            ) : pub.entryTags.doi ? (
              <a href={`https://doi.org/${pub.entryTags.doi}`} target="_blank" rel="noopener noreferrer" class="hover:text-[#2B79C2] dark:hover:text-[#73D0FF]">
                {cleanLatex(pub.entryTags.title)}
              </a>
            ) : (
              cleanLatex(pub.entryTags.title)
            )}
          </div>
          
          <div class="text-xs text-[#828E9F] dark:text-[#707A8C] mt-0.5" set:html={formatAuthors(pub.entryTags.author || pub.entryTags.editor)} />
          
          <div class="text-xs text-[#828E9F] dark:text-[#707A8C] mt-0.5 flex items-center gap-2 flex-wrap">
            <span class="italic">{cleanLatex(pub.entryTags.journal || pub.entryTags.booktitle || pub.entryTags.howpublished)}</span>
            <span>&bull;</span>
            <span>{pub.entryTags.year}</span>
            {pub.entryTags.doi && (
              <a href={`https://doi.org/${pub.entryTags.doi}`} target="_blank" rel="noopener noreferrer" class="text-[#2B79C2] dark:text-[#73D0FF] hover:underline font-mono text-[11px]">
                [DOI]
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

</BaseLayout>
