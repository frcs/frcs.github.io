---
import BaseLayout from '../../layouts/BaseLayout.astro';
import katex from 'katex';

const renderLatex = (latex: string, displayMode = false) => {
  return katex.renderToString(latex, { displayMode, throwOnError: false });
};

const eqModel = renderLatex("C_i = \\alpha_i F_i + (1 - \\alpha_i) B_i", true);
const eqColorLine = renderLatex("\\alpha_i = a_i^T C_i + b_i", true);
const eqLevinCost = renderLatex("J(\\alpha, a, b) = \\sum_i \\sum_{j \\in w_i} \\left(a_i^T C_j + b_i - \\alpha_j\\right)^2", true);
const eqLevinMin = renderLatex("J^*(\\alpha) = \\min_{a,b} J(\\alpha, a, b)", true);
const eqOurMin = renderLatex("J^*(a,b) = \\min_{\\alpha} J(\\alpha, a, b)", true);
const eqPde = renderLatex("\\mathrm{div}\\left( \\begin{bmatrix} C_i \\\\ 1 \\end{bmatrix} \\begin{bmatrix} C_i^T & 1 \\end{bmatrix} \\nabla \\begin{bmatrix} a_i \\\\ b_i \\end{bmatrix} \\right) = 0", true);
---

<BaseLayout title="Interactive Vision, Object Selection & Alpha Matting - François Pitié" currentSection="research">
  <div class="post">
    <header class="post-header mb-8">
      <div class="mb-2">
        <a href="/research" class="text-xs font-mono text-[var(--theme-link)] hover:text-[var(--theme-accent)]">&larr; back to research</a>
      </div>
      <h1 class="post-title">Interactive Vision, Object Selection &amp; Alpha Matting</h1>
      <p class="desc text-xs sm:text-sm text-[var(--theme-muted)] mt-1.5 pb-3 border-b border-[var(--theme-border)]">
        From closed-form parameter diffusion to deep interactive selection, $F|B|\alpha$ matting, and commercial deployment.
      </p>
    </header>

    <article class="space-y-10">
      <!-- Visual Grid of Results -->
      <section class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="rounded overflow-hidden border border-[var(--theme-border)] bg-[var(--theme-card)]/40 p-2">
            <img src="/images/troll.jpg" alt="Original Troll Image" class="w-full h-auto rounded" />
            <p class="text-xs text-[var(--theme-muted)] mt-1.5 text-center font-medium">Input Test Image (alphamatting.com)</p>
          </div>

          <div class="rounded overflow-hidden border border-[var(--theme-border)] bg-[var(--theme-card)]/40 p-2">
            <img src="/images/troll_colourfilter.jpg" alt="Colour Filter Visualisation" class="w-full h-auto rounded" />
            <p class="text-xs text-[var(--theme-muted)] mt-1.5 text-center font-medium">Revealing &alpha; through Local Colour Filter</p>
          </div>

          <div class="rounded overflow-hidden border border-[var(--theme-border)] bg-[var(--theme-card)]/40 p-2">
            <img src="/images/troll_a_ours.jpg" alt="Diffused Model Parameter a" class="w-full h-auto rounded" />
            <p class="text-xs text-[var(--theme-muted)] mt-1.5 text-center font-medium">Our Parameter Map (a) with Smoothness Priors</p>
          </div>

          <div class="rounded overflow-hidden border border-[var(--theme-border)] bg-[var(--theme-card)]/40 p-2">
            <img src="/images/troll_alpha_ours.jpg" alt="Extracted Alpha Matte" class="w-full h-auto rounded" />
            <p class="text-xs text-[var(--theme-muted)] mt-1.5 text-center font-medium">Extracted Alpha Matte (&alpha;)</p>
          </div>
        </div>
      </section>

      <!-- Overview -->
      <section class="space-y-3 text-sm sm:text-base text-[var(--theme-fg)] leading-relaxed">
        <h2 class="text-lg font-light tracking-tight text-[var(--theme-heading)] pb-1.5 border-b border-[var(--theme-border)]">
          Overview
        </h2>
        <p>
          Extracting foreground objects from complex backgrounds—<strong>alpha matting</strong> and <strong>object selection</strong>—is a core task in visual effects and photo editing. In natural image matting, an observed pixel colour <span set:html={renderLatex("C_i")} /> is modelled as a mixture of unknown foreground <span set:html={renderLatex("F_i")} />, background <span set:html={renderLatex("B_i")} />, and transparency <span set:html={renderLatex("\\alpha_i")} />:
        </p>
        <div class="p-3 my-2 rounded bg-[var(--theme-card)]/50 border border-[var(--theme-border)] overflow-x-auto text-center" set:html={eqModel} />
        <p>
          Because there are seven unknown values for only three colour measurements per pixel, the problem is severely ill-posed. Full automation without user input often struggles on fine details like hair, fur, and transparency.
        </p>
        <p>
          My research in this area combines closed-form mathematical models with deep learning and simple user interactions (clicks, scribbles, and trimaps) to give artists precise control over segmentation and matting.
        </p>
      </section>

      <!-- The Alternative Matting Laplacian -->
      <section class="space-y-3 text-sm sm:text-base text-[var(--theme-fg)] leading-relaxed">
        <h2 class="text-lg font-light tracking-tight text-[var(--theme-heading)] pb-1.5 border-b border-[var(--theme-border)]">
          The Alternative Matting Laplacian
        </h2>
        <p>
          In classic matting, Levin et al. assumed that alpha is locally an affine transformation of colour components (<span set:html={renderLatex("\\alpha_i = a_i^T C_i + b_i")} />), eliminating the model parameters <span set:html={renderLatex("a, b")} /> to produce the Levin Matting Laplacian linear system <span set:html={renderLatex("L\\alpha = 0")} />:
        </p>
        <div class="p-3 my-2 rounded bg-[var(--theme-card)]/50 border border-[var(--theme-border)] overflow-x-auto text-center" set:html={eqLevinCost} />
        <p>
          <strong>Our Approach:</strong> We take the opposite approach and eliminate <span set:html={renderLatex("\\alpha")} /> instead to solve directly for the model parameters:
        </p>
        <div class="p-2 my-1 rounded bg-[var(--theme-card)]/50 border border-[var(--theme-border)] overflow-x-auto text-center" set:html={eqOurMin} />
        <p>
          This reveals that parameter propagation corresponds to an anisotropic diffusion partial differential equation (PDE):
        </p>
        <div class="p-3 my-2 rounded bg-[var(--theme-card)]/50 border border-[var(--theme-border)] overflow-x-auto text-center" set:html={eqPde} />
        <p>
          Solving directly for local colour filter parameters (<span set:html={renderLatex("a, b")} />) yields simpler, faster linear systems and makes it possible to impose spatial smoothness directly on the colour model.
        </p>
      </section>

      <!-- Deep Interactive Selection & F|B|Alpha Matting -->
      <section class="space-y-3 text-sm sm:text-base text-[var(--theme-fg)] leading-relaxed">
        <h2 class="text-lg font-light tracking-tight text-[var(--theme-heading)] pb-1.5 border-b border-[var(--theme-border)]">
          Deep Selection &amp; $F|B|\alpha$ Matting
        </h2>
        <p>
          Building on these foundations, we extended interactive selection to deep learning. At IEEE ICME 2020, Dr. Marco Forte and our group presented an interactive deep learning model trained directly on simulated user clicks to segment objects with minimal interaction, receiving the <strong>Best Paper Runner-Up Award</strong>.
        </p>
        <p>
          We then developed <strong>$F|B|\alpha$ Matting</strong> (Forte &amp; Pitié, 2020), which estimates foreground, background, and alpha simultaneously. $F|B|\alpha$ Matting reached the <strong>#1 position</strong> on the <a href="http://www.alphamatting.com" target="_blank" rel="noopener noreferrer" class="text-[var(--theme-link)] hover:text-[var(--theme-accent)] underline">alphamatting.com</a> benchmark.
        </p>
        <p>
          In 2021, the underlying technology was licensed to <strong>PhotoRoom</strong>, and Dr. Marco Forte joined the company to lead key AI engineering teams.
        </p>
      </section>

      <!-- Code & Resources -->
      <section class="p-4 rounded border border-[var(--theme-border)] bg-[var(--theme-card)]/40">
        <h2 class="text-sm font-semibold text-[var(--theme-heading)] mb-2 flex items-center gap-2">
          <i class="fa-brands fa-github text-base"></i>
          Open Source Code &amp; Benchmarks
        </h2>
        <div class="flex flex-wrap items-center gap-3 text-xs sm:text-sm font-mono mt-2">
          <a href="https://github.com/MarcoForte/FBA_Matting" target="_blank" rel="noopener noreferrer" class="pub-btn">
            FBA_Matting (PyTorch) &rarr;
          </a>
          <a href="https://github.com/frcs/alternative-matting-laplacian" target="_blank" rel="noopener noreferrer" class="pub-btn">
            Alternative Matting Laplacian &rarr;
          </a>
          <a href="http://www.alphamatting.com" target="_blank" rel="noopener noreferrer" class="pub-btn">
            alphamatting.com Benchmark &rarr;
          </a>
          <a href="https://www.photoroom.com" target="_blank" rel="noopener noreferrer" class="pub-btn">
            PhotoRoom &rarr;
          </a>
        </div>
      </section>

      <!-- Key Publications -->
