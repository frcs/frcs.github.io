---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadPublications, cleanLatex, formatAuthors, formatBibtex, getPublicationUrl, type BibEntry } from '../utils/bibtex';

const allPubs = loadPublications();

// 1. Lecture Notes
const lectureNotesKeys = ['Pitie:2025:4c16notes'];
const lectureNotes = allPubs.filter(p => lectureNotesKeys.includes(p.citationKey));

// 2. Visual Productions (Clockhead, iDuet)
const visualProdKeys = ['Merry:2011:sophie', 'Woods:2015:steve'];
const visualProductions = allPubs.filter(p => visualProdKeys.includes(p.citationKey));

// 3. Software
const softwareKeys = [
  'The:2008:foundry',
  'The:2007:foundry',
  'Pixelpuffin:2012:pixelpuffin',
  'Pixelpuffin:2011:pixelpuffin',
  'Greenparrotpictures:2004:greenparrotpictures'
];
const software = allPubs.filter(p => softwareKeys.includes(p.citationKey));

// 4. Theses
const thesisKeys = ['Piti:2006:francois', 'Piti:2002:fran'];
const theses = allPubs.filter(p => thesisKeys.includes(p.citationKey) || p.entryType?.toLowerCase().includes('thesis'));

// 5. Patents
const patentKeys = ['Xu:2023:conran', 'Kelly:2016:patent', 'Crawford:2013:patent', 'Pitie:2010:patent'];
const patents = allPubs.filter(p => patentKeys.includes(p.citationKey) || (p.entryTags.sapc_category || '').toLowerCase() === 'patents');

// Special keys set
const specialKeys = new Set([...lectureNotesKeys, ...visualProdKeys, ...softwareKeys, ...thesisKeys, ...patentKeys]);

// Peer-reviewed vs preprints/other
const nonPeerReviewedCategories = [
  'non peer-reviewed works',
  'other materials subject to external evaluation'
];

const peerReviewedPubs = allPubs.filter(p => {
  if (specialKeys.has(p.citationKey)) return false;
  const cat = (p.entryTags.sapc_category || '').trim().toLowerCase();
  return !nonPeerReviewedCategories.includes(cat);
});

const preprintsAndOther = allPubs.filter(p => {
  if (specialKeys.has(p.citationKey)) return false;
  const cat = (p.entryTags.sapc_category || '').trim().toLowerCase();
  return nonPeerReviewedCategories.includes(cat);
});

// Group by year (for Year view)
const groupedByYear = allPubs.reduce((acc, entry) => {
  const year = entry.entryTags.year || 'Other';
  if (!acc[year]) acc[year] = [];
  acc[year].push(entry);
  return acc;
}, {} as Record<string, typeof allPubs>);

const years = Object.keys(groupedByYear).sort((a, b) => b.localeCompare(a));
---

<BaseLayout title="Publications - François Pitié" currentSection="publications">
  <div class="post">
    <!-- Header (al-folio style) -->
    <header class="post-header mb-8">
      <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-3 pb-3 border-b border-[var(--theme-border)]">
        <div>
          <h1 class="post-title">Publications</h1>
          <p class="desc text-xs sm:text-sm text-[var(--theme-muted)] mt-1.5 mb-0">
            Master bibliography ({allPubs.length} items). Also on <a href="https://scholar.google.com/citations?user=lOaoO74AAAAJ" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--theme-accent)]">Google Scholar</a> and <a href="https://www.researchgate.net/profile/F_Pitie" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--theme-accent)]">ResearchGate</a>.
          </p>
        </div>

        <!-- Filter Toggle -->
        <div class="flex items-center gap-1.5 text-xs font-mono self-start sm:self-auto shrink-0">
          <button id="btn-by-category" class="px-2.5 py-1 text-[var(--theme-accent)] border-b-2 border-[var(--theme-accent)] font-semibold cursor-pointer">By Category</button>
          <span class="text-[var(--theme-border)]">|</span>
          <button id="btn-by-year" class="px-2.5 py-1 text-[var(--theme-muted)] hover:text-[var(--theme-heading)] border-b-2 border-transparent cursor-pointer">By Year</button>
        </div>
      </div>
    </header>

    <article>
      <!-- Category View -->
      <div id="view-by-category" class="space-y-12">
        
        <!-- 1. Open Courseware & Lecture Notes -->
        {lectureNotes.length > 0 && (
          <section>
            <h2 class="text-lg font-light tracking-tight text-[var(--theme-heading)] mb-4 pb-1.5 border-b border-[var(--theme-border)] flex items-center justify-between">
              <span>Course Lecture Notes & Open Courseware</span>
              <span class="text-xs font-mono text-[var(--theme-muted)]">({lectureNotes.length})</span>
            </h2>
            <ol class="bibliography space-y-5">
              {lectureNotes.map((pub, idx) => {
                const uniqueKey = `note-${idx}`;
                const pubUrl = getPublicationUrl(pub);
                return (
                  <li class="bibliography-item">
                    <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-4">
                      <div class="sm:w-28 shrink-0">
                        <span class="badge-abbr">courseware</span>
                      </div>
                      <div class="flex-1 min-w-0">
                        <div class="font-semibold text-sm text-[var(--theme-heading)] leading-snug">
                          {pubUrl ? (
                            <a href={pubUrl} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--theme-accent)]">
                              {cleanLatex(pub.entryTags.title)}
                            </a>
                          ) : cleanLatex(pub.entryTags.title)}
                        </div>
                        <div class="text-xs text-[var(--theme-muted)] mt-1" set:html={formatAuthors(pub.entryTags.author || pub.entryTags.editor)} />
                        <div class="text-xs text-[var(--theme-muted)] mt-0.5">
                          <span>{pub.entryTags.note || 'Open Courseware'}</span>, <span>{pub.entryTags.year}</span>
                        </div>
                        <div class="flex items-center gap-1.5 mt-2 flex-wrap">
                          {pub.entryTags.doi && (
                            <a href={`https://doi.org/${pub.entryTags.doi}`} target="_blank" rel="noopener noreferrer" class="pub-btn">DOI</a>
                          )}
                          <a href="https://frcs.github.io/4C16-LectureNotes/" target="_blank" rel="noopener noreferrer" class="pub-btn">Interactive Book &rarr;</a>
                          <button type="button" class="pub-btn toggle-bib-btn" data-target={`bib-${uniqueKey}`}>Bib</button>
                        </div>
                        <div id={`bib-${uniqueKey}`} class="hidden mt-2 p-2.5 rounded bg-[var(--theme-card)] border border-[var(--theme-border)] text-[11px] font-mono overflow-x-auto text-[var(--theme-fg)]">
                          <pre class="m-0 whitespace-pre">{formatBibtex(pub)}</pre>
                        </div>
                      </div>
                    </div>
                  </li>
                );
              })}
            </ol>
          </section>
        )}

        <!-- 2. Peer-Reviewed Publications -->
        <section>
          <h2 class="text-lg font-light tracking-tight text-[var(--theme-heading)] mb-4 pb-1.5 border-b border-[var(--theme-border)] flex items-center justify-between">
            <span>Peer-Reviewed Publications</span>
            <span class="text-xs font-mono text-[var(--theme-muted)]">({peerReviewedPubs.length})</span>
          </h2>
          <ol class="bibliography space-y-5">
            {peerReviewedPubs.map((pub, idx) => {
              const uniqueKey = `peer-${idx}`;
              const pubUrl = getPublicationUrl(pub);
              const venue = cleanLatex(pub.entryTags.journal || pub.entryTags.booktitle || pub.entryTags.publisher || 'Publication');
              return (
                <li class="bibliography-item">
                  <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-4">
                    <div class="sm:w-28 shrink-0">
                      <span class="badge-abbr">journal/conf</span>
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="font-semibold text-sm text-[var(--theme-heading)] leading-snug">
                        {pubUrl ? (
                          <a href={pubUrl} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--theme-accent)]">
                            {cleanLatex(pub.entryTags.title)}
                          </a>
                        ) : cleanLatex(pub.entryTags.title)}
                      </div>
                      <div class="text-xs text-[var(--theme-muted)] mt-1" set:html={formatAuthors(pub.entryTags.author || pub.entryTags.editor)} />
                      <div class="text-xs text-[var(--theme-muted)] mt-0.5">
                        <span class="italic">{venue}</span>, <span>{pub.entryTags.year}</span>
                      </div>
                      <div class="flex items-center gap-1.5 mt-2 flex-wrap">
                        {pub.entryTags.doi && (
                          <a href={`https://doi.org/${pub.entryTags.doi}`} target="_blank" rel="noopener noreferrer" class="pub-btn">DOI</a>
                        )}
                        {pubUrl && !pub.entryTags.doi && (
                          <a href={pubUrl} target="_blank" rel="noopener noreferrer" class="pub-btn">Link</a>
                        )}
                        <button type="button" class="pub-btn toggle-bib-btn" data-target={`bib-${uniqueKey}`}>Bib</button>
                      </div>
                      <div id={`bib-${uniqueKey}`} class="hidden mt-2 p-2.5 rounded bg-[var(--theme-card)] border border-[var(--theme-border)] text-[11px] font-mono overflow-x-auto text-[var(--theme-fg)]">
                        <pre class="m-0 whitespace-pre">{formatBibtex(pub)}</pre>
                      </div>
                    </div>
                  </div>
                </li>
              );
            })}
          </ol>
        </section>

        <!-- 3. Preprints & Other Works -->
        {preprintsAndOther.length > 0 && (
          <section>
            <h2 class="text-lg font-light tracking-tight text-[var(--theme-heading)] mb-4 pb-1.5 border-b border-[var(--theme-border)] flex items-center justify-between">
              <span>Preprints & Other Works</span>
              <span class="text-xs font-mono text-[var(--theme-muted)]">({preprintsAndOther.length})</span>
            </h2>
            <ol class="bibliography space-y-5">
              {preprintsAndOther.map((pub, idx) => {
                const uniqueKey = `prep-${idx}`;
                const pubUrl = getPublicationUrl(pub);
                const venue = cleanLatex(pub.entryTags.journal || pub.entryTags.booktitle || pub.entryTags.publisher || pub.entryTags.note || 'Preprint');
                return (
                  <li class="bibliography-item">
                    <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-4">
                      <div class="sm:w-28 shrink-0">
                        <span class="badge-abbr">preprint</span>
                      </div>
                      <div class="flex-1 min-w-0">
                        <div class="font-semibold text-sm text-[var(--theme-heading)] leading-snug">
                          {pubUrl ? (
                            <a href={pubUrl} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--theme-accent)]">
                              {cleanLatex(pub.entryTags.title)}
                            </a>
                          ) : cleanLatex(pub.entryTags.title)}
                        </div>
                        <div class="text-xs text-[var(--theme-muted)] mt-1" set:html={formatAuthors(pub.entryTags.author || pub.entryTags.editor)} />
                        <div class="text-xs text-[var(--theme-muted)] mt-0.5">
                          <span class="italic">{venue}</span>, <span>{pub.entryTags.year}</span>
                        </div>
                        <div class="flex items-center gap-1.5 mt-2 flex-wrap">
                          {pub.entryTags.eprint && (
                            <a href={`https://arxiv.org/abs/${pub.entryTags.eprint}`} target="_blank" rel="noopener noreferrer" class="pub-btn">arXiv</a>
                          )}
                          {pub.entryTags.doi && (
                            <a href={`https://doi.org/${pub.entryTags.doi}`} target="_blank" rel="noopener noreferrer" class="pub-btn">DOI</a>
                          )}
                          {pub.entryTags.url && !pub.entryTags.doi && !pub.entryTags.eprint && (
                            <a href={pub.entryTags.url} target="_blank" rel="noopener noreferrer" class="pub-btn">Link</a>
                          )}
                          <button type="button" class="pub-btn toggle-bib-btn" data-target={`bib-${uniqueKey}`}>Bib</button>
                        </div>
                        <div id={`bib-${uniqueKey}`} class="hidden mt-2 p-2.5 rounded bg-[var(--theme-card)] border border-[var(--theme-border)] text-[11px] font-mono overflow-x-auto text-[var(--theme-fg)]">
                          <pre class="m-0 whitespace-pre">{formatBibtex(pub)}</pre>
                        </div>
                      </div>
                    </div>
                  </li>
                );
              })}
            </ol>
          </section>
        )}

        <!-- 4. Software & Tools -->
        {software.length > 0 && (
          <section>
            <h2 class="text-lg font-light tracking-tight text-[var(--theme-heading)] mb-4 pb-1.5 border-b border-[var(--theme-border)] flex items-center justify-between">
              <span>Software & Commercial Tools</span>
              <span class="text-xs font-mono text-[var(--theme-muted)]">({software.length})</span>
            </h2>
            <ol class="bibliography space-y-5">
              {software.map((pub, idx) => {
                const uniqueKey = `soft-${idx}`;
                return (
                  <li class="bibliography-item">
                    <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-4">
                      <div class="sm:w-28 shrink-0">
                        <span class="badge-abbr">software</span>
                      </div>
                      <div class="flex-1 min-w-0">
                        <div class="font-semibold text-sm text-[var(--theme-heading)] leading-snug">
                          {cleanLatex(pub.entryTags.title)}
                        </div>
                        <div class="text-xs text-[var(--theme-muted)] mt-1" set:html={formatAuthors(pub.entryTags.author || pub.entryTags.editor)} />
                        <div class="text-xs text-[var(--theme-muted)] mt-0.5">
                          <span>{pub.entryTags.howpublished || pub.entryTags.publisher}</span>
                          {pub.entryTags.note && <span> &bull; <span class="italic">{pub.entryTags.note}</span></span>}
                          <span> &bull; {pub.entryTags.year}</span>
                        </div>
                        <div class="flex items-center gap-1.5 mt-2 flex-wrap">
                          <button type="button" class="pub-btn toggle-bib-btn" data-target={`bib-${uniqueKey}`}>Bib</button>
                        </div>
                        <div id={`bib-${uniqueKey}`} class="hidden mt-2 p-2.5 rounded bg-[var(--theme-card)] border border-[var(--theme-border)] text-[11px] font-mono overflow-x-auto text-[var(--theme-fg)]">
                          <pre class="m-0 whitespace-pre">{formatBibtex(pub)}</pre>
                        </div>
                      </div>
                    </div>
                  </li>
                );
              })}
            </ol>
          </section>
        )}

        <!-- 5. Visual Productions -->
        {visualProductions.length > 0 && (
          <section>
            <h2 class="text-lg font-light tracking-tight text-[var(--theme-heading)] mb-4 pb-1.5 border-b border-[var(--theme-border)] flex items-center justify-between">
              <span>Visual Productions</span>
              <span class="text-xs font-mono text-[var(--theme-muted)]">({visualProductions.length})</span>
            </h2>
            <ol class="bibliography space-y-5">
              {visualProductions.map((pub, idx) => {
                const uniqueKey = `vis-${idx}`;
                return (
                  <li class="bibliography-item">
                    <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-4">
                      <div class="sm:w-28 shrink-0">
                        <span class="badge-abbr">film/vfx</span>
                      </div>
                      <div class="flex-1 min-w-0">
                        <div class="font-semibold text-sm text-[var(--theme-heading)] leading-snug">
                          {cleanLatex(pub.entryTags.title)}
                        </div>
                        <div class="text-xs text-[var(--theme-muted)] mt-1" set:html={formatAuthors(pub.entryTags.author || pub.entryTags.editor)} />
                        <div class="text-xs text-[var(--theme-muted)] mt-0.5">
                          <span>{pub.entryTags.howpublished}</span>
                          {pub.entryTags.note && <span> &bull; <span class="italic">{pub.entryTags.note}</span></span>}
                          <span> &bull; {pub.entryTags.year}</span>
                        </div>
                        <div class="flex items-center gap-1.5 mt-2 flex-wrap">
                          <button type="button" class="pub-btn toggle-bib-btn" data-target={`bib-${uniqueKey}`}>Bib</button>
                        </div>
                        <div id={`bib-${uniqueKey}`} class="hidden mt-2 p-2.5 rounded bg-[var(--theme-card)] border border-[var(--theme-border)] text-[11px] font-mono overflow-x-auto text-[var(--theme-fg)]">
                          <pre class="m-0 whitespace-pre">{formatBibtex(pub)}</pre>
                        </div>
                      </div>
                    </div>
                  </li>
                );
              })}
            </ol>
          </section>
        )}

        <!-- 6. Theses -->
        {theses.length > 0 && (
          <section>
            <h2 class="text-lg font-light tracking-tight text-[var(--theme-heading)] mb-4 pb-1.5 border-b border-[var(--theme-border)] flex items-center justify-between">
              <span>Theses</span>
              <span class="text-xs font-mono text-[var(--theme-muted)]">({theses.length})</span>
            </h2>
            <ol class="bibliography space-y-5">
              {theses.map((pub, idx) => {
                const uniqueKey = `thes-${idx}`;
                return (
                  <li class="bibliography-item">
                    <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-4">
                      <div class="sm:w-28 shrink-0">
                        <span class="badge-abbr">thesis</span>
                      </div>
                      <div class="flex-1 min-w-0">
                        <div class="font-semibold text-sm text-[var(--theme-heading)] leading-snug">
                          {cleanLatex(pub.entryTags.title)}
                        </div>
                        <div class="text-xs text-[var(--theme-muted)] mt-1" set:html={formatAuthors(pub.entryTags.author || pub.entryTags.editor)} />
                        <div class="text-xs text-[var(--theme-muted)] mt-0.5">
                          <span class="italic">{pub.entryTags.school}</span>
                          {pub.entryTags.note && <span> &bull; {pub.entryTags.note}</span>}
                          <span> &bull; {pub.entryTags.year}</span>
                        </div>
                        <div class="flex items-center gap-1.5 mt-2 flex-wrap">
                          <button type="button" class="pub-btn toggle-bib-btn" data-target={`bib-${uniqueKey}`}>Bib</button>
                        </div>
                        <div id={`bib-${uniqueKey}`} class="hidden mt-2 p-2.5 rounded bg-[var(--theme-card)] border border-[var(--theme-border)] text-[11px] font-mono overflow-x-auto text-[var(--theme-fg)]">
                          <pre class="m-0 whitespace-pre">{formatBibtex(pub)}</pre>
                        </div>
                      </div>
                    </div>
                  </li>
                );
              })}
            </ol>
          </section>
        )}

        <!-- 7. Patents -->
        {patents.length > 0 && (
          <section>
            <h2 class="text-lg font-light tracking-tight text-[var(--theme-heading)] mb-4 pb-1.5 border-b border-[var(--theme-border)] flex items-center justify-between">
              <span>Patents</span>
              <span class="text-xs font-mono text-[var(--theme-muted)]">({patents.length})</span>
            </h2>
            <ol class="bibliography space-y-5">
              {patents.map((pub, idx) => {
                const uniqueKey = `pat-${idx}`;
                const pubUrl = pub.entryTags.url || null;
                return (
                  <li class="bibliography-item">
                    <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-4">
                      <div class="sm:w-28 shrink-0">
                        <span class="badge-abbr">patent</span>
                      </div>
                      <div class="flex-1 min-w-0">
                        <div class="font-semibold text-sm text-[var(--theme-heading)] leading-snug">
                          {pubUrl ? (
                            <a href={pubUrl} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--theme-accent)]">
                              {cleanLatex(pub.entryTags.title)}
                            </a>
                          ) : cleanLatex(pub.entryTags.title)}
                        </div>
                        <div class="text-xs text-[var(--theme-muted)] mt-1" set:html={formatAuthors(pub.entryTags.author || pub.entryTags.editor)} />
                        <div class="text-xs text-[var(--theme-muted)] mt-0.5">
                          <span class="font-mono font-medium">{pub.entryTags.number}</span>
                          {pub.entryTags.note && <span> &bull; {pub.entryTags.note}</span>}
                          <span> &bull; {pub.entryTags.year}</span>
                        </div>
                        <div class="flex items-center gap-1.5 mt-2 flex-wrap">
                          {pubUrl && (
                            <a href={pubUrl} target="_blank" rel="noopener noreferrer" class="pub-btn">Patent &rarr;</a>
                          )}
                          <button type="button" class="pub-btn toggle-bib-btn" data-target={`bib-${uniqueKey}`}>Bib</button>
                        </div>
                        <div id={`bib-${uniqueKey}`} class="hidden mt-2 p-2.5 rounded bg-[var(--theme-card)] border border-[var(--theme-border)] text-[11px] font-mono overflow-x-auto text-[var(--theme-fg)]">
                          <pre class="m-0 whitespace-pre">{formatBibtex(pub)}</pre>
                        </div>
                      </div>
                    </div>
                  </li>
                );
              })}
            </ol>
          </section>
        )}

      </div>

      <!-- Year View -->
      <div id="view-by-year" class="space-y-12 hidden">
        {years.map(year => (
          <section>
            <h2 class="text-lg font-light tracking-tight text-[var(--theme-heading)] mb-4 pb-1.5 border-b border-[var(--theme-border)] flex items-center justify-between">
              <span>{year}</span>
              <span class="text-xs font-mono text-[var(--theme-muted)]">({groupedByYear[year].length})</span>
            </h2>
            <ol class="bibliography space-y-5">
              {groupedByYear[year].map((pub, idx) => {
                const uniqueKey = `year-${year}-${idx}`;
                const pubUrl = getPublicationUrl(pub);
                const venue = cleanLatex(pub.entryTags.journal || pub.entryTags.booktitle || pub.entryTags.howpublished || pub.entryTags.publisher || pub.entryTags.school || 'Publication');
                const badge = pub.entryType === 'phdthesis' || pub.entryType === 'mastersthesis' ? 'thesis' : (pub.entryTags.eprint ? 'preprint' : 'pub');
                return (
                  <li class="bibliography-item">
                    <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-4">
                      <div class="sm:w-28 shrink-0">
                        <span class="badge-abbr">{badge}</span>
                      </div>
                      <div class="flex-1 min-w-0">
                        <div class="font-semibold text-sm text-[var(--theme-heading)] leading-snug">
                          {pubUrl ? (
                            <a href={pubUrl} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--theme-accent)]">
                              {cleanLatex(pub.entryTags.title)}
                            </a>
                          ) : cleanLatex(pub.entryTags.title)}
                        </div>
                        <div class="text-xs text-[var(--theme-muted)] mt-1" set:html={formatAuthors(pub.entryTags.author || pub.entryTags.editor)} />
                        <div class="text-xs text-[var(--theme-muted)] mt-0.5">
                          <span class="italic">{venue}</span>, <span>{pub.entryTags.year}</span>
                        </div>
                        <div class="flex items-center gap-1.5 mt-2 flex-wrap">
                          {pub.entryTags.doi && (
                            <a href={`https://doi.org/${pub.entryTags.doi}`} target="_blank" rel="noopener noreferrer" class="pub-btn">DOI</a>
                          )}
                          {pub.entryTags.eprint && (
                            <a href={`https://arxiv.org/abs/${pub.entryTags.eprint}`} target="_blank" rel="noopener noreferrer" class="pub-btn">arXiv</a>
                          )}
                          {pub.entryTags.url && !pub.entryTags.doi && !pub.entryTags.eprint && (
                            <a href={pub.entryTags.url} target="_blank" rel="noopener noreferrer" class="pub-btn">Link</a>
                          )}
                          <button type="button" class="pub-btn toggle-bib-btn" data-target={`bib-${uniqueKey}`}>Bib</button>
                        </div>
                        <div id={`bib-${uniqueKey}`} class="hidden mt-2 p-2.5 rounded bg-[var(--theme-card)] border border-[var(--theme-border)] text-[11px] font-mono overflow-x-auto text-[var(--theme-fg)]">
                          <pre class="m-0 whitespace-pre">{formatBibtex(pub)}</pre>
                        </div>
                      </div>
                    </div>
                  </li>
                );
              })}
            </ol>
          </section>
        ))}
      </div>
    </article>
  </div>

  <script>
    // Tab switching between Category View and Year View
    const btnCat = document.getElementById('btn-by-category');
    const btnYear = document.getElementById('btn-by-year');
    const viewCat = document.getElementById('view-by-category');
    const viewYear = document.getElementById('view-by-year');

    btnCat?.addEventListener('click', () => {
      btnCat.classList.add('text-[var(--theme-accent)]', 'border-[var(--theme-accent)]', 'font-semibold');
      btnCat.classList.remove('text-[var(--theme-muted)]', 'border-transparent');
      btnYear?.classList.remove('text-[var(--theme-accent)]', 'border-[var(--theme-accent)]', 'font-semibold');
      btnYear?.classList.add('text-[var(--theme-muted)]', 'border-transparent');
      viewCat?.classList.remove('hidden');
      viewYear?.classList.add('hidden');
    });

    btnYear?.addEventListener('click', () => {
      btnYear.classList.add('text-[var(--theme-accent)]', 'border-[var(--theme-accent)]', 'font-semibold');
      btnYear.classList.remove('text-[var(--theme-muted)]', 'border-transparent');
      btnCat?.classList.remove('text-[var(--theme-accent)]', 'border-[var(--theme-accent)]', 'font-semibold');
      btnCat?.classList.add('text-[var(--theme-muted)]', 'border-transparent');
      viewYear?.classList.remove('hidden');
      viewCat?.classList.add('hidden');
    });

    // Handle inline BibTeX toggles
    document.querySelectorAll('.toggle-bib-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;
        const targetEl = document.getElementById(targetId);
        if (targetEl) {
          targetEl.classList.toggle('hidden');
        }
      });
    });
  </script>
</BaseLayout>
