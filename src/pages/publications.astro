---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadPublications, cleanLatex, formatAuthors, type BibEntry } from '../utils/bibtex';

const allPubs = loadPublications();

// 1. Lecture Notes
const lectureNotesKeys = ['Pitie:2025:4c16notes'];
const lectureNotes = allPubs.filter(p => lectureNotesKeys.includes(p.citationKey));

// 2. Visual Productions (Clockhead, iDuet)
const visualProdKeys = ['Merry:2011:sophie', 'Woods:2015:steve'];
const visualProductions = allPubs.filter(p => visualProdKeys.includes(p.citationKey));

// 3. Software
const softwareKeys = [
  'The:2008:foundry',
  'The:2007:foundry',
  'Pixelpuffin:2012:pixelpuffin',
  'Pixelpuffin:2011:pixelpuffin',
  'Greenparrotpictures:2004:greenparrotpictures'
];
const software = allPubs.filter(p => softwareKeys.includes(p.citationKey));

// 4. Theses
const thesisKeys = ['Piti:2006:francois', 'Piti:2002:fran'];
const theses = allPubs.filter(p => thesisKeys.includes(p.citationKey) || p.entryType?.toLowerCase().includes('thesis'));

// 5. Patents
const patentKeys = ['Xu:2023:conran'];
const patents = allPubs.filter(p => patentKeys.includes(p.citationKey) || (p.entryTags.sapc_category || '').toLowerCase() === 'patents');

// Special keys set
const specialKeys = new Set([...lectureNotesKeys, ...visualProdKeys, ...softwareKeys, ...thesisKeys, ...patentKeys]);

// Peer-reviewed vs preprints/other
const nonPeerReviewedCategories = [
  'non peer-reviewed works',
  'other materials subject to external evaluation'
];

const peerReviewedPubs = allPubs.filter(p => {
  if (specialKeys.has(p.citationKey)) return false;
  const cat = (p.entryTags.sapc_category || '').trim().toLowerCase();
  return !nonPeerReviewedCategories.includes(cat);
});

const preprintsAndOther = allPubs.filter(p => {
  if (specialKeys.has(p.citationKey)) return false;
  const cat = (p.entryTags.sapc_category || '').trim().toLowerCase();
  return nonPeerReviewedCategories.includes(cat);
});

// Group by year (for Year view)
const groupedByYear = allPubs.reduce((acc, entry) => {
  const year = entry.entryTags.year || 'Other';
  if (!acc[year]) acc[year] = [];
  acc[year].push(entry);
  return acc;
}, {} as Record<string, typeof allPubs>);

const years = Object.keys(groupedByYear).sort((a, b) => b.localeCompare(a));
---

<BaseLayout title="Publications - François Pitié" currentSection="publications">
  <div class="mb-6 pb-2 border-b border-[#E6E8EB] dark:border-white/[0.08] flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2">
    <div>
      <h1 class="text-xl font-semibold tracking-tight text-[#242936] dark:text-[#ECEFF4]">Publications</h1>
      <p class="text-xs sm:text-sm text-[#828E9F] dark:text-[#707A8C] mt-0.5">
        Master bibliography ({allPubs.length} items). Also on <a href="https://scholar.google.com/citations?user=lOaoO74AAAAJ" target="_blank" rel="noopener noreferrer" class="text-[#2B79C2] dark:text-[#73D0FF] hover:underline font-medium">Google Scholar</a> and <a href="https://www.researchgate.net/profile/F_Pitie" target="_blank" rel="noopener noreferrer" class="text-[#2B79C2] dark:text-[#73D0FF] hover:underline font-medium">ResearchGate</a>.
      </p>
    </div>

    <!-- Quick filter view toggle -->
    <div class="flex items-center gap-1 text-xs self-start sm:self-auto font-medium">
      <button id="btn-by-category" class="px-2 py-0.5 text-[#2B79C2] dark:text-[#73D0FF] border-b border-[#2B79C2] cursor-pointer">By Category</button>
      <span class="text-slate-300 dark:text-slate-700">|</span>
      <button id="btn-by-year" class="px-2 py-0.5 text-[#828E9F] dark:text-[#707A8C] hover:text-slate-900 dark:hover:text-white border-b border-transparent cursor-pointer">By Year</button>
    </div>
  </div>

  <!-- Category View -->
  <div id="view-by-category" class="space-y-8">
    
    <!-- 1. Open Courseware & Lecture Notes (Featured on Top) -->
    {lectureNotes.length > 0 && (
      <section>
        <h2 class="text-base font-semibold tracking-tight text-[#242936] dark:text-[#ECEFF4] mb-3 pb-1 border-b border-[#E6E8EB] dark:border-white/[0.08] flex items-center justify-between">
          <span>Course Lecture Notes & Open Courseware</span>
          <span class="text-xs font-normal text-[#828E9F] dark:text-[#707A8C] font-mono">({lectureNotes.length})</span>
        </h2>
        
        <div class="space-y-2.5">
          {lectureNotes.map(pub => (
          <div class="py-1">
              <div class="font-medium text-[#242936] dark:text-[#ECEFF4] text-sm leading-snug">
                <a href={pub.entryTags.url || `https://doi.org/${pub.entryTags.doi}`} target="_blank" rel="noopener noreferrer" class="hover:text-[#2B79C2] dark:hover:text-[#73D0FF]">
                  {cleanLatex(pub.entryTags.title)}
                </a>
              </div>
              <div class="text-xs text-[#828E9F] dark:text-[#707A8C] mt-0.5" set:html={formatAuthors(pub.entryTags.author || pub.entryTags.editor)} />
              <div class="text-xs text-[#828E9F] dark:text-[#707A8C] mt-0.5 flex items-center gap-2 flex-wrap">
                <span>{pub.entryTags.note || 'Open Courseware'}</span>
                <span>&bull;</span>
                <span>{pub.entryTags.year}</span>
                {pub.entryTags.doi && (
                  <a href={`https://doi.org/${pub.entryTags.doi}`} target="_blank" rel="noopener noreferrer" class="text-[#2B79C2] dark:text-[#73D0FF] hover:underline font-mono text-[11px]">
                    [DOI: {pub.entryTags.doi}]
                  </a>
                )}
                <a href="https://frcs.github.io/4C16-LectureNotes/" target="_blank" rel="noopener noreferrer" class="text-[#2B79C2] dark:text-[#73D0FF] hover:underline font-medium text-[11px]">
                  [Interactive Book &rarr;]
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 2. Peer-Reviewed Publications -->
    <section>
      <h2 class="text-base font-semibold tracking-tight text-[#242936] dark:text-[#ECEFF4] mb-3 pb-1 border-b border-[#E6E8EB] dark:border-white/[0.08] flex items-center justify-between">
        <span>Peer-Reviewed Publications</span>
        <span class="text-xs font-normal text-[#828E9F] dark:text-[#707A8C] font-mono">({peerReviewedPubs.length})</span>
      </h2>
      
      <div class="space-y-2.5">
        {peerReviewedPubs.map(pub => (
          <div class="py-1">
            <div class="font-medium text-[#242936] dark:text-[#ECEFF4] text-sm leading-snug">
              {pub.entryTags.url ? (
                <a href={pub.entryTags.url} target="_blank" rel="noopener noreferrer" class="hover:text-[#2B79C2] dark:hover:text-[#73D0FF]">
                  {cleanLatex(pub.entryTags.title)}
                </a>
              ) : pub.entryTags.doi ? (
                <a href={`https://doi.org/${pub.entryTags.doi}`} target="_blank" rel="noopener noreferrer" class="hover:text-[#2B79C2] dark:hover:text-[#73D0FF]">
                  {cleanLatex(pub.entryTags.title)}
                </a>
              ) : (
                cleanLatex(pub.entryTags.title)
              )}
            </div>
            
            <div class="text-xs text-[#828E9F] dark:text-[#707A8C] mt-0.5" set:html={formatAuthors(pub.entryTags.author || pub.entryTags.editor)} />
            
            <div class="text-xs text-[#828E9F] dark:text-[#707A8C] mt-0.5 flex items-center gap-1.5 flex-wrap">
              <span class="italic">{cleanLatex(pub.entryTags.journal || pub.entryTags.booktitle || pub.entryTags.publisher)}</span>
              <span>&bull;</span>
              <span>{pub.entryTags.year}</span>
              {pub.entryTags.doi && (
                <a href={`https://doi.org/${pub.entryTags.doi}`} target="_blank" rel="noopener noreferrer" class="text-[#2B79C2] dark:text-[#73D0FF] hover:underline font-mono text-[11px]">
                  [DOI]
                </a>
              )}
              {pub.entryTags.url && !pub.entryTags.doi && (
                <a href={pub.entryTags.url} target="_blank" rel="noopener noreferrer" class="text-[#2B79C2] dark:text-[#73D0FF] hover:underline font-mono text-[11px]">
                  [Link]
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. Preprints & Other Works -->
    {preprintsAndOther.length > 0 && (
      <section>
        <h2 class="text-base font-semibold tracking-tight text-[#242936] dark:text-[#ECEFF4] mb-3 pb-1 border-b border-[#E6E8EB] dark:border-white/[0.08] flex items-center justify-between">
          <span>Preprints & Other Works</span>
          <span class="text-xs font-normal text-[#828E9F] dark:text-[#707A8C] font-mono">({preprintsAndOther.length})</span>
        </h2>
        
        <div class="space-y-2.5">
          {preprintsAndOther.map(pub => (
            <div class="py-1">
              <div class="font-medium text-[#242936] dark:text-[#ECEFF4] text-sm leading-snug">
                {pub.entryTags.url ? (
                  <a href={pub.entryTags.url} target="_blank" rel="noopener noreferrer" class="hover:text-[#2B79C2] dark:hover:text-[#73D0FF]">
                    {cleanLatex(pub.entryTags.title)}
                  </a>
                ) : pub.entryTags.doi ? (
                  <a href={`https://doi.org/${pub.entryTags.doi}`} target="_blank" rel="noopener noreferrer" class="hover:text-[#2B79C2] dark:hover:text-[#73D0FF]">
                    {cleanLatex(pub.entryTags.title)}
                  </a>
                ) : (
                  cleanLatex(pub.entryTags.title)
                )}
              </div>
              
              <div class="text-xs text-[#828E9F] dark:text-[#707A8C] mt-0.5" set:html={formatAuthors(pub.entryTags.author || pub.entryTags.editor)} />
              
              <div class="text-xs text-[#828E9F] dark:text-[#707A8C] mt-0.5 flex items-center gap-1.5 flex-wrap">
                <span class="italic">{cleanLatex(pub.entryTags.journal || pub.entryTags.booktitle || pub.entryTags.publisher || pub.entryTags.note)}</span>
                {pub.entryTags.number && (
                  <span>({pub.entryTags.number})</span>
                )}
                <span>&bull;</span>
                <span>{pub.entryTags.year}</span>
                {pub.entryTags.eprint && (
                  <a href={`https://arxiv.org/abs/${pub.entryTags.eprint}`} target="_blank" rel="noopener noreferrer" class="text-[#2B79C2] dark:text-[#73D0FF] hover:underline font-mono text-[11px]">
                    [arXiv:{pub.entryTags.eprint}]
                  </a>
                )}
                {pub.entryTags.doi && (
                  <a href={`https://doi.org/${pub.entryTags.doi}`} target="_blank" rel="noopener noreferrer" class="text-[#2B79C2] dark:text-[#73D0FF] hover:underline font-mono text-[11px]">
                    [DOI]
                  </a>
                )}
                {pub.entryTags.url && !pub.entryTags.doi && !pub.entryTags.eprint && (
                  <a href={pub.entryTags.url} target="_blank" rel="noopener noreferrer" class="text-[#2B79C2] dark:text-[#73D0FF] hover:underline font-mono text-[11px]">
                    [Link]
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 4. Software & Commercial Plugins -->
    {software.length > 0 && (
      <section>
        <h2 class="text-base font-semibold tracking-tight text-[#242936] dark:text-[#ECEFF4] mb-3 pb-1 border-b border-[#E6E8EB] dark:border-white/[0.08] flex items-center justify-between">
          <span>Software & Commercial Tools</span>
          <span class="text-xs font-normal text-[#828E9F] dark:text-[#707A8C] font-mono">({software.length})</span>
        </h2>
        
        <div class="space-y-2.5">
          {software.map(pub => (
          <div class="py-1">
              <div class="font-medium text-[#242936] dark:text-[#ECEFF4] text-sm leading-snug">
                {cleanLatex(pub.entryTags.title)}
              </div>
              <div class="text-xs text-[#828E9F] dark:text-[#707A8C] mt-0.5" set:html={formatAuthors(pub.entryTags.author || pub.entryTags.editor)} />
              <div class="text-xs text-[#828E9F] dark:text-[#707A8C] mt-0.5 flex items-center gap-1.5 flex-wrap">
                <span>{pub.entryTags.howpublished || pub.entryTags.publisher}</span>
                {pub.entryTags.note && (
                  <>
                    <span>&bull;</span>
                    <span class="italic text-[#828E9F] dark:text-[#707A8C]">{pub.entryTags.note}</span>
                  </>
                )}
                <span>&bull;</span>
                <span>{pub.entryTags.year}</span>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 5. Visual Productions -->
    {visualProductions.length > 0 && (
      <section>
        <h2 class="text-base font-semibold tracking-tight text-[#242936] dark:text-[#ECEFF4] mb-3 pb-1 border-b border-[#E6E8EB] dark:border-white/[0.08] flex items-center justify-between">
          <span>Visual Productions</span>
          <span class="text-xs font-normal text-[#828E9F] dark:text-[#707A8C] font-mono">({visualProductions.length})</span>
        </h2>
        
        <div class="space-y-2.5">
          {visualProductions.map(pub => (
          <div class="py-1">
              <div class="font-medium text-[#242936] dark:text-[#ECEFF4] text-sm leading-snug">
                {cleanLatex(pub.entryTags.title)}
              </div>
              <div class="text-xs text-[#828E9F] dark:text-[#707A8C] mt-0.5" set:html={formatAuthors(pub.entryTags.author || pub.entryTags.editor)} />
              <div class="text-xs text-[#828E9F] dark:text-[#707A8C] mt-0.5 flex items-center gap-1.5 flex-wrap">
                <span>{pub.entryTags.howpublished}</span>
                {pub.entryTags.note && (
                  <>
                    <span>&bull;</span>
                    <span class="italic text-[#828E9F] dark:text-[#707A8C]">{pub.entryTags.note}</span>
                  </>
                )}
                <span>&bull;</span>
                <span>{pub.entryTags.year}</span>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 6. Theses -->
    {theses.length > 0 && (
      <section>
        <h2 class="text-base font-semibold tracking-tight text-[#242936] dark:text-[#ECEFF4] mb-3 pb-1 border-b border-[#E6E8EB] dark:border-white/[0.08] flex items-center justify-between">
          <span>Theses</span>
          <span class="text-xs font-normal text-[#828E9F] dark:text-[#707A8C] font-mono">({theses.length})</span>
        </h2>
        
        <div class="space-y-2.5">
          {theses.map(pub => (
          <div class="py-1">
              <div class="font-medium text-[#242936] dark:text-[#ECEFF4] text-sm leading-snug">
                {cleanLatex(pub.entryTags.title)}
              </div>
              <div class="text-xs text-[#828E9F] dark:text-[#707A8C] mt-0.5" set:html={formatAuthors(pub.entryTags.author || pub.entryTags.editor)} />
              <div class="text-xs text-[#828E9F] dark:text-[#707A8C] mt-0.5 flex items-center gap-1.5 flex-wrap">
                <span class="italic">{pub.entryTags.school}</span>
                {pub.entryTags.note && (
                  <>
                    <span>&bull;</span>
                    <span>{pub.entryTags.note}</span>
                  </>
                )}
                <span>&bull;</span>
                <span>{pub.entryTags.year}</span>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 7. Patents & Intellectual Property -->
    {patents.length > 0 && (
      <section>
        <h2 class="text-base font-semibold tracking-tight text-[#242936] dark:text-[#ECEFF4] mb-3 pb-1 border-b border-[#E6E8EB] dark:border-white/[0.08] flex items-center justify-between">
          <span>Patents</span>
          <span class="text-xs font-normal text-[#828E9F] dark:text-[#707A8C] font-mono">({patents.length})</span>
        </h2>
        
        <div class="space-y-2.5">
          {patents.map(pub => (
            <div class="py-1">
              <div class="font-medium text-[#242936] dark:text-[#ECEFF4] text-sm leading-snug">
                {cleanLatex(pub.entryTags.title)}
              </div>
              <div class="text-xs text-[#828E9F] dark:text-[#707A8C] mt-0.5" set:html={formatAuthors(pub.entryTags.author || pub.entryTags.editor)} />
              <div class="text-xs text-[#828E9F] dark:text-[#707A8C] mt-0.5 flex items-center gap-1.5 flex-wrap">
                <span class="font-mono text-xs text-[#2B79C2] dark:text-[#73D0FF]">{pub.entryTags.number || pub.entryTags.note}</span>
                <span>&bull;</span>
                <span>{pub.entryTags.year}</span>
                <a href="/grants-impact" class="text-[#2B79C2] dark:text-[#73D0FF] hover:underline font-mono text-[11px]">
                  [All Patents &rarr;]
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

  </div>

  <!-- Year View -->
  <div id="view-by-year" class="space-y-6 hidden">
    {years.map(year => (
      <section>
        <h2 class="text-base font-semibold tracking-tight text-[#242936] dark:text-[#ECEFF4] mb-3 pb-1 border-b border-[#E6E8EB] dark:border-white/[0.08] flex items-center justify-between">
          <span>{year}</span>
          <span class="text-xs font-normal text-[#828E9F] dark:text-[#707A8C] font-mono">({groupedByYear[year].length})</span>
        </h2>
        <div class="space-y-2.5">
          {groupedByYear[year].map(pub => (
          <div class="py-1">
              <div class="font-medium text-[#242936] dark:text-[#ECEFF4] text-sm leading-snug">
                {pub.entryTags.url ? (
                  <a href={pub.entryTags.url} target="_blank" rel="noopener noreferrer" class="hover:text-[#2B79C2] dark:hover:text-[#73D0FF]">
                    {cleanLatex(pub.entryTags.title)}
                  </a>
                ) : pub.entryTags.doi ? (
                  <a href={`https://doi.org/${pub.entryTags.doi}`} target="_blank" rel="noopener noreferrer" class="hover:text-[#2B79C2] dark:hover:text-[#73D0FF]">
                    {cleanLatex(pub.entryTags.title)}
                  </a>
                ) : (
                  cleanLatex(pub.entryTags.title)
                )}
              </div>
              <div class="text-xs text-[#828E9F] dark:text-[#707A8C] mt-0.5" set:html={formatAuthors(pub.entryTags.author || pub.entryTags.editor)} />
              <div class="text-xs text-[#828E9F] dark:text-[#707A8C] mt-0.5 flex items-center gap-1.5 flex-wrap">
                <span class="italic">{cleanLatex(pub.entryTags.journal || pub.entryTags.booktitle || pub.entryTags.howpublished || pub.entryTags.publisher || pub.entryTags.school)}</span>
                <span>&bull;</span>
                <span>{pub.entryTags.year}</span>
                {pub.entryTags.doi && (
                  <a href={`https://doi.org/${pub.entryTags.doi}`} target="_blank" rel="noopener noreferrer" class="text-[#2B79C2] dark:text-[#73D0FF] hover:underline font-mono text-[11px]">
                    [DOI]
                  </a>
                )}
                {pub.entryTags.eprint && (
                  <a href={`https://arxiv.org/abs/${pub.entryTags.eprint}`} target="_blank" rel="noopener noreferrer" class="text-[#2B79C2] dark:text-[#73D0FF] hover:underline font-mono text-[11px]">
                    [arXiv]
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>

  <script>
    const btnCat = document.getElementById('btn-by-category');
    const btnYear = document.getElementById('btn-by-year');
    const viewCat = document.getElementById('view-by-category');
    const viewYear = document.getElementById('view-by-year');

    btnCat?.addEventListener('click', () => {
      btnCat.classList.add('text-[#2B79C2]', 'dark:text-[#73D0FF]', 'border-[#2B79C2]');
      btnCat.classList.remove('text-[#828E9F]', 'dark:text-[#828E9F] dark:text-[#707A8C]', 'border-transparent');
      btnYear?.classList.remove('text-[#2B79C2]', 'dark:text-[#73D0FF]', 'border-[#2B79C2]');
      btnYear?.classList.add('text-[#828E9F]', 'dark:text-[#828E9F] dark:text-[#707A8C]', 'border-transparent');
      viewCat?.classList.remove('hidden');
      viewYear?.classList.add('hidden');
    });

    btnYear?.addEventListener('click', () => {
      btnYear.classList.add('text-[#2B79C2]', 'dark:text-[#73D0FF]', 'border-[#2B79C2]');
      btnYear.classList.remove('text-[#828E9F]', 'dark:text-[#828E9F] dark:text-[#707A8C]', 'border-transparent');
      btnCat?.classList.remove('text-[#2B79C2]', 'dark:text-[#73D0FF]', 'border-[#2B79C2]');
      btnCat?.classList.add('text-[#828E9F]', 'dark:text-[#828E9F] dark:text-[#707A8C]', 'border-transparent');
      viewYear?.classList.remove('hidden');
      viewCat?.classList.add('hidden');
    });
  </script>
</BaseLayout>
