---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadPublications, cleanLatex, formatAuthors } from '../utils/bibtex';

const allPubs = loadPublications();

const categoryOrder = [
  'Journal Articles',
  'Papers in Conference Proceedings',
  'Book Chapters',
  'Edited books or special issues of journals',
  'Non Peer-reviewed Works'
];

const pubsByCategory = categoryOrder.reduce((acc, cat) => {
  acc[cat] = allPubs.filter(p => (p.entryTags.sapc_category || '').trim().toLowerCase() === cat.toLowerCase());
  return acc;
}, {} as Record<string, typeof allPubs>);

const unclassified = allPubs.filter(p => {
  const c = (p.entryTags.sapc_category || '').trim().toLowerCase();
  return !categoryOrder.map(x => x.toLowerCase()).includes(c);
});
if (unclassified.length > 0) {
  pubsByCategory['Other / Miscellaneous'] = unclassified;
}

const groupedByYear = allPubs.reduce((acc, entry) => {
  const year = entry.entryTags.year || 'Other';
  if (!acc[year]) acc[year] = [];
  acc[year].push(entry);
  return acc;
}, {} as Record<string, typeof allPubs>);

const years = Object.keys(groupedByYear).sort((a, b) => b.localeCompare(a));
---

<BaseLayout title="Publications - François Pitié" currentSection="publications">
  <div class="mb-6 pb-2 border-b border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
    <div>
      <h1 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">Publications</h1>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
        Master bibliography ({allPubs.length} entries). Also on <a href="https://scholar.google.com/citations?user=lOaoO74AAAAJ" target="_blank" rel="noopener noreferrer" class="text-[#0569B9] dark:text-[#82B4DC] hover:underline">Google Scholar</a> and <a href="https://www.researchgate.net/profile/F_Pitie" target="_blank" rel="noopener noreferrer" class="text-[#0569B9] dark:text-[#82B4DC] hover:underline">ResearchGate</a>.
      </p>
    </div>

    <!-- Quick filter view toggle -->
    <div class="flex items-center gap-1 text-xs self-start sm:self-auto">
      <button id="btn-by-category" class="px-2.5 py-1 text-xs font-semibold text-[#0569B9] dark:text-[#82B4DC] border-b-2 border-[#0569B9]">By Category</button>
      <span class="text-slate-300 dark:text-slate-700">|</span>
      <button id="btn-by-year" class="px-2.5 py-1 text-xs text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white border-b-2 border-transparent">By Year</button>
    </div>
  </div>

  <!-- Category View -->
  <div id="view-by-category" class="space-y-8">
    {Object.entries(pubsByCategory).map(([cat, list]) => list.length > 0 && (
      <section>
        <h2 class="text-base font-bold tracking-tight text-slate-900 dark:text-white mb-3 pb-1 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
          <span>{cat}</span>
          <span class="text-xs font-normal text-slate-400 font-mono">({list.length})</span>
        </h2>
        <div class="space-y-3">
          {list.map(pub => (
            <div class="border-l-2 border-slate-200 dark:border-slate-800 pl-3 py-0.5 hover:border-[#0569B9] transition-colors">
              <div class="text-sm font-semibold text-slate-900 dark:text-slate-100 leading-snug">
                {pub.entryTags.url ? (
                  <a href={pub.entryTags.url} target="_blank" rel="noopener noreferrer" class="hover:text-[#0569B9] dark:hover:text-[#82B4DC]">
                    {cleanLatex(pub.entryTags.title)}
                  </a>
                ) : pub.entryTags.doi ? (
                  <a href={`https://doi.org/${pub.entryTags.doi}`} target="_blank" rel="noopener noreferrer" class="hover:text-[#0569B9] dark:hover:text-[#82B4DC]">
                    {cleanLatex(pub.entryTags.title)}
                  </a>
                ) : (
                  cleanLatex(pub.entryTags.title)
                )}
              </div>
              <div class="text-xs text-slate-600 dark:text-slate-400 mt-1" set:html={formatAuthors(pub.entryTags.author || pub.entryTags.editor)} />
              <div class="text-xs text-slate-500 dark:text-slate-500 mt-1 flex items-center gap-2 flex-wrap">
                <span class="italic">{cleanLatex(pub.entryTags.journal || pub.entryTags.booktitle || pub.entryTags.howpublished || pub.entryTags.publisher)}</span>
                <span>&bull;</span>
                <span>{pub.entryTags.year}</span>
                {pub.entryTags.doi && (
                  <a href={`https://doi.org/${pub.entryTags.doi}`} target="_blank" rel="noopener noreferrer" class="text-[#0569B9] dark:text-[#82B4DC] hover:underline font-mono text-[11px]">
                    [DOI]
                  </a>
                )}
                {pub.entryTags.url && !pub.entryTags.doi && (
                  <a href={pub.entryTags.url} target="_blank" rel="noopener noreferrer" class="text-[#0569B9] dark:text-[#82B4DC] hover:underline font-mono text-[11px]">
                    [Link]
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>

  <!-- Year View (hidden by default) -->
  <div id="view-by-year" class="space-y-8 hidden">
    {years.map(year => (
      <section>
        <h2 class="text-base font-bold tracking-tight text-slate-900 dark:text-white mb-3 pb-1 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
          <span>{year}</span>
          <span class="text-xs font-normal text-slate-400 font-mono">({groupedByYear[year].length})</span>
        </h2>
        <div class="space-y-3">
          {groupedByYear[year].map(pub => (
            <div class="border-l-2 border-slate-200 dark:border-slate-800 pl-3 py-0.5 hover:border-[#0569B9] transition-colors">
              <div class="text-sm font-semibold text-slate-900 dark:text-slate-100 leading-snug">
                {pub.entryTags.url ? (
                  <a href={pub.entryTags.url} target="_blank" rel="noopener noreferrer" class="hover:text-[#0569B9] dark:hover:text-[#82B4DC]">
                    {cleanLatex(pub.entryTags.title)}
                  </a>
                ) : pub.entryTags.doi ? (
                  <a href={`https://doi.org/${pub.entryTags.doi}`} target="_blank" rel="noopener noreferrer" class="hover:text-[#0569B9] dark:hover:text-[#82B4DC]">
                    {cleanLatex(pub.entryTags.title)}
                  </a>
                ) : (
                  cleanLatex(pub.entryTags.title)
                )}
              </div>
              <div class="text-xs text-slate-600 dark:text-slate-400 mt-1" set:html={formatAuthors(pub.entryTags.author || pub.entryTags.editor)} />
              <div class="text-xs text-slate-500 dark:text-slate-500 mt-1 flex items-center gap-2 flex-wrap">
                <span class="italic">{cleanLatex(pub.entryTags.journal || pub.entryTags.booktitle || pub.entryTags.howpublished || pub.entryTags.publisher)}</span>
                {pub.entryTags.doi && (
                  <>
                    <span>&bull;</span>
                    <a href={`https://doi.org/${pub.entryTags.doi}`} target="_blank" rel="noopener noreferrer" class="text-[#0569B9] dark:text-[#82B4DC] hover:underline font-mono text-[11px]">
                      [DOI]
                    </a>
                  </>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>

  <script>
    const btnCat = document.getElementById('btn-by-category');
    const btnYear = document.getElementById('btn-by-year');
    const viewCat = document.getElementById('view-by-category');
    const viewYear = document.getElementById('view-by-year');

    btnCat?.addEventListener('click', () => {
      btnCat.classList.add('font-semibold', 'text-[#0569B9]', 'dark:text-[#82B4DC]', 'border-[#0569B9]');
      btnCat.classList.remove('text-slate-500', 'dark:text-slate-400', 'border-transparent');
      btnYear?.classList.remove('font-semibold', 'text-[#0569B9]', 'dark:text-[#82B4DC]', 'border-[#0569B9]');
      btnYear?.classList.add('text-slate-500', 'dark:text-slate-400', 'border-transparent');
      viewCat?.classList.remove('hidden');
      viewYear?.classList.add('hidden');
    });

    btnYear?.addEventListener('click', () => {
      btnYear.classList.add('font-semibold', 'text-[#0569B9]', 'dark:text-[#82B4DC]', 'border-[#0569B9]');
      btnYear.classList.remove('text-slate-500', 'dark:text-slate-400', 'border-transparent');
      btnCat?.classList.remove('font-semibold', 'text-[#0569B9]', 'dark:text-[#82B4DC]', 'border-[#0569B9]');
      btnCat?.classList.add('text-slate-500', 'dark:text-slate-400', 'border-transparent');
      viewYear?.classList.remove('hidden');
      viewCat?.classList.add('hidden');
    });
  </script>
</BaseLayout>
