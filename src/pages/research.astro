---
import BaseLayout from '../layouts/BaseLayout.astro';

const researchDirections = [
  {
    title: "Colour Transfer & Automated Colour Grading",
    meta: "Optimal Transport · Visual Computing",
    body: "I developed mathematical formulations for transferring colour distributions between images and video, based on continuous Monge–Kantorovich optimal transport and N-dimensional probability density transfer. This work transformed colour matching from a largely manual process into an automated one and became the basis of commercial tools including MatchGrade in The Foundry's Furnace suite.",
    link: {
      text: "Read the technical article →",
      href: "/research/colour-transfer"
    }
  },
  {
    title: "Human-in-the-Loop Vision & Alpha Matting",
    meta: "Interactive Computer Vision · Image Compositing",
    body: "For professional visual editing, automation must remain under human control. I develop models that combine neural processing with simple user interactions, including interactive object selection from clicks and scribbles, and foreground/background/alpha estimation for image matting. The work was recognised with an IEEE ICME Best Paper Runner-Up and has been licensed to PhotoRoom.",
    link: {
      text: "Read the technical article →",
      href: "/research/matting-laplacian"
    }
  },
  {
    title: "Efficient AI for Video",
    meta: "Signal Processing · Lightweight Neural Networks · Video Compression",
    body: "Rather than relying on ever-larger neural networks, I investigate how classical signal processing and compact learned models can be combined to achieve high-quality results at much lower computational cost. Current work spans video denoising, encoder control, perceptual quality assessment and next-generation video compression, including contributions to AV1 and AVM through the Alliance for Open Media.",
    link: null
  }
];
---

<BaseLayout title="Research - François Pitié" currentSection="research">
  <div class="post">
    <!-- Header -->
    <header class="post-header mb-8">
      <h1 class="post-title">Research</h1>
      <p class="text-base sm:text-lg font-medium text-[var(--theme-heading)] mt-1.5 pb-3 border-b border-[var(--theme-border)]">
        Making pictures better
      </p>
    </header>

    <article class="space-y-12">
      <!-- Introductory Narrative -->
      <div class="space-y-4 text-sm sm:text-base leading-relaxed text-[var(--theme-fg)]">
        <p>
          I work on applied mathematics, signal processing and machine learning for visual media. My research spans film and visual-effects production, image and video processing, and large-scale video streaming.
        </p>
        <p>
          A recurring question in my work is how to make visual computing better, more controllable and more efficient. I develop mathematical and AI models that can improve images and video, automate tasks that traditionally required manual intervention, and reduce the computational cost of increasingly sophisticated media processing.
        </p>
      </div>

      <!-- Research Directions -->
      <section class="space-y-6">
        <h2 class="text-lg font-light tracking-tight text-[var(--theme-heading)] pb-2 border-b border-[var(--theme-border)]">
          Research Directions
        </h2>

        <div class="divide-y divide-[var(--theme-border)]/40 space-y-8">
          {researchDirections.map((dir, idx) => (
            <div class={idx > 0 ? "pt-8 space-y-2.5" : "space-y-2.5"}>
              <div>
                <h3 class="text-base sm:text-lg font-semibold text-[var(--theme-heading)]">
                  {dir.title}
                </h3>
                <div class="text-xs font-mono text-[var(--theme-muted)] mt-0.5">
                  {dir.meta}
                </div>
              </div>
              <p class="text-sm sm:text-base text-[var(--theme-fg)] leading-relaxed">
                {dir.body}
              </p>
              {dir.link && (
                <div class="pt-1">
                  <a 
                    href={dir.link.href} 
                    class="text-xs sm:text-sm text-[var(--theme-link)] hover:text-[var(--theme-accent)] font-medium inline-flex items-center gap-1 hover:underline"
                  >
                    {dir.link.text}
                  </a>
                </div>
              )}
            </div>
          ))}
        </div>
      </section>
    </article>
  </div>
</BaseLayout>
