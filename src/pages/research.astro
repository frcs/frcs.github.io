---
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  {
    id: "colour",
    tabTitle: "Colour",
    heading: "Colour Manipulation & Film Restoration",
    narrative: [
      "My work in colour manipulation focuses on developing principled mathematical frameworks for film post-production, visual effects, and archival restoration. This began with continuous probability density function (PDF) transfer and 1D Radon projections for example-based colour transfer, which was commercialised in The Foundry's MatchGrade plug-in for Nuke.",
      "It extends to statistical temporal estimators for localised deflickering in degraded archival footage (Furnace Deflicker2), and more recently to scene-aware neural architectures developed with FilmLight (CVMP 2025) that estimate changing illumination across multi-camera setups to maintain consistent colour appearance across complex scene cuts."
    ],
    focusTags: [
      "Optimal Transport",
      "Radon Projections",
      "Exposure Stabilisation",
      "Scene Illuminant Estimation"
    ],
    dossiers: [
      {
        title: "Optimal Transport (Colour Transfer)",
        href: "/research/colour-transfer",
        desc: "Probability density transfer, N-D continuous formulations, and The Foundry's MatchGrade."
      },
      {
        title: "Deflicker & Exposure Stabilisation",
        href: "/research/deflicker",
        desc: "Statistical signal processing and archival film restoration in Furnace Deflicker2."
      },
      {
        title: "Scene Matching & Illuminant Estimation",
        href: "/research/scene-matching",
        desc: "Multi-camera colour consistency and illuminant estimation with FilmLight (CVMP 2025)."
      }
    ],
    partners: [
      "The Foundry (MatchGrade & Deflicker2)",
      "FilmLight (Baselight grading workflows)",
      "Horizon Europe EMERALD Project"
    ],
    resources: [
      {
        name: "frcs/colour-transfer (GitHub)",
        href: "https://github.com/frcs/colour-transfer"
      }
    ]
  },
  {
    id: "segmentation-keying",
    tabTitle: "Segmentation & Keying",
    heading: "Interactive Segmentation & Keying",
    narrative: [
      "Extracting foreground elements from complex imagery—traditionally divided into green-screen keying, rotoscoping, and natural image matting—is one of the most labour-intensive stages in visual effects and photo editing. Because solving for foreground colour, background, and opacity simultaneously is severely ill-posed, automated methods often fail along subtle boundaries like hair, fur, and motion blur.",
      "My research combines closed-form mathematical physics with deep learning to provide intuitive, human-in-the-loop control. This includes formulating matting as an anisotropic parameter diffusion PDE (the Alternative Matting Laplacian), click-based interactive deep selection (IEEE ICME Runner-Up), and F|B|α matting, which ranked #1 on alphamatting.com and was licensed to PhotoRoom."
    ],
    focusTags: [
      "Closed-Form Matting PDEs",
      "Deep Interactive Selection",
      "F|B|α Matting",
      "Natural Image Keying"
    ],
    dossiers: [
      {
        title: "The Alternative Matting Laplacian (Research Note)",
        href: "/research/matting-laplacian",
        desc: "Technical note on parameter diffusion PDEs and comparison with Levin's Laplacian."
      },
      {
        title: "F|B|α Matting & Deep Selection",
        href: "https://github.com/MarcoForte/FBA_Matting",
        external: true,
        desc: "#1 on alphamatting.com benchmark, licensed to PhotoRoom."
      }
    ],
    partners: [
      "PhotoRoom (commercial technology licensing)",
      "IEEE ICME 2020 (Best Paper Runner-Up Award)"
    ],
    resources: [
      {
        name: "MarcoForte/FBA_Matting (GitHub)",
        href: "https://github.com/MarcoForte/FBA_Matting"
      },
      {
        name: "alphamatting.com Benchmark (#1 Rank)",
        href: "http://www.alphamatting.com"
      }
    ]
  },
  {
    id: "video-compression",
    tabTitle: "Video Compression",
    heading: "Video Compression & Open Standards",
    narrative: [
      "With video representing the vast majority of internet traffic, improving video coding efficiency and perceptual fidelity is critical for streaming services, virtual production, and mobile devices. As an academic member of the Alliance for Open Media (AOMedia) Video Quality Working Group, I contribute to the design and subjective evaluation of royalty-free standards including AV1 and the next-generation AVM codec.",
      "Our research tackles per-clip Lagrangian multiplier (λ) optimisation for High Dynamic Range (HDR) content, lightweight neural networks like LiteVPNet for one-pass quality and rate prediction (commercialised via TrueFrame), and novel methods that reuse motion vectors already present in compressed bitstreams to accelerate 3D Gaussian Splatting by over 60% (IEEE ICIP 2026)."
    ],
    focusTags: [
      "AOMedia AV1 & AVM",
      "Perceptual Rate-Distortion (VMAF)",
      "Per-Clip λ Optimisation",
      "Codec-Assisted 3DGS"
    ],
    dossiers: [
      {
        title: "Video Compression & Codecs",
        href: "/research/video-compression",
        desc: "AV1/AVM standards, LiteVPNet/TrueFrame one-pass control, and 3D Gaussian Splatting."
      }
    ],
    partners: [
      "Alliance for Open Media (Google, Netflix, Meta)",
      "YouTube / Google Faculty Award",
      "TrueFrame (Research Ireland ARC Hub ICT, €149.5k)"
    ],
    resources: [
      {
        name: "AOMedia AVM Repository (GitLab)",
        href: "https://gitlab.com/AOMediaCodec/avm"
      },
      {
        name: "ICIP 2026 Paper (arXiv:2605.14629)",
        href: "https://arxiv.org/abs/2605.14629"
      }
    ]
  },
  {
    id: "efficient-ai",
    tabTitle: "Efficient AI",
    heading: "Efficient AI & Inverse Problems",
    narrative: [
      "While modern deep learning achieves remarkable image restoration quality, state-of-the-art models often rely on massive architectures that incur prohibitive computational latency and energy costs in camera hardware and real-time workflows. Our research explores how classical signal processing theory can dramatically reduce the scale of neural networks.",
      "We investigate hybrid pipelines that combine classical Bayesian Wiener filtering with compact parameter-estimation networks for fast video and image denoising. Furthermore, at CVMP 2025, we demonstrated that instead of training separate models for individual degradations, a single compact multi-task denoiser can serve as a shared, regularising prior across multiple linear inverse problems, improving reconstruction quality while converging in fewer iterations."
    ],
    focusTags: [
      "Multi-Task Image Priors",
      "Linear Inverse Problems",
      "Bayesian Wiener Backbones",
      "Low-Latency Denoising"
    ],
    dossiers: [
      {
        title: "Multi-Task Denoisers & Bayesian Backbones",
        href: "/research/efficient-ai",
        desc: "Shared multi-task denoisers (CVMP 2025) and classical Wiener filter hybrid models."
      }
    ],
    partners: [
      "ACM SIGGRAPH CVMP 2025 (London)",
      "Frontiers in Signal Processing & IEEE ICME/ICIP"
    ],
    resources: [
      {
        name: "CVMP 2025 Paper Proceedings",
        href: "https://doi.org/10.1145/3702580.3702583"
      }
    ]
  }
];
---

<BaseLayout title="Research - François Pitié" currentSection="research">
  <div class="post">
    <!-- Header -->
    <header class="post-header mb-6">
      <h1 class="post-title">Research</h1>
      <p class="desc text-xs sm:text-sm text-[var(--theme-muted)] mt-1.5 pb-3 border-b border-[var(--theme-border)]">
        Applied mathematics, signal processing, and lightweight machine learning for visual media.
      </p>

      <!-- Segmented Tabs (Variant 1, Teaching Style) -->
      <div class="flex flex-wrap items-center gap-2 mt-5 text-xs font-mono">
        {sections.map((sec, idx) => (
          <button 
            type="button" 
            id={`tab-btn-${sec.id}`}
            data-tab={sec.id}
            class={`research-tab-btn px-3.5 py-1.5 rounded border transition-colors cursor-pointer ${
              idx === 0
                ? "active border-[var(--theme-heading)] bg-[var(--theme-heading)] text-[var(--theme-bg)] font-medium"
                : "border-[var(--theme-border)] text-[var(--theme-muted)] hover:text-[var(--theme-accent)]"
            }`}
          >
            {sec.tabTitle}
          </button>
        ))}
      </div>
    </header>

    <article class="mt-8">
      {sections.map((sec, idx) => (
        <div 
          id={`pane-${sec.id}`} 
          class={`research-tab-pane ${idx > 0 ? "hidden" : ""}`}
        >
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 sm:gap-10">
            <!-- Main Column: Substantive Narrative (2/3 width) -->
            <div class="md:col-span-2 space-y-5">
              <h2 class="text-lg font-light tracking-tight text-[var(--theme-heading)] pb-1.5 border-b border-[var(--theme-border)]">
                {sec.heading}
              </h2>

              <div class="space-y-4 text-sm sm:text-base leading-relaxed text-[var(--theme-fg)]">
                {sec.narrative.map((p) => (
                  <p>{p}</p>
                ))}
              </div>

              <!-- Research Focus Tags -->
              <div class="pt-2">
                <div class="text-xs font-mono uppercase tracking-wider text-[var(--theme-muted)] mb-2">
                  Key Research Areas
                </div>
                <div class="flex flex-wrap gap-1.5 text-xs font-mono text-[var(--theme-muted)]">
                  {sec.focusTags.map(tag => (
                    <span class="px-2 py-0.5 rounded border border-[var(--theme-border)] bg-[var(--theme-card)]">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <!-- Margin Sidebar: In-jugged Dossiers & Metadata (1/3 width) -->
            <aside class="space-y-6 text-xs sm:text-sm md:border-l md:border-[var(--theme-border)]/60 md:pl-8">
              <!-- In-jugged Dossiers & Notes -->
              <div>
                <div class="text-xs font-mono uppercase tracking-wider text-[var(--theme-muted)] mb-2.5">
                  Projects &amp; Dossiers
                </div>
                <ul class="space-y-3 font-medium">
                  {sec.dossiers.map(d => (
                    <li class="pl-3.5 border-l-2 border-[var(--theme-border)] hover:border-[var(--theme-accent)] transition-colors">
                      <a 
                        href={d.href} 
                        target={d.external ? "_blank" : undefined}
                        rel={d.external ? "noopener noreferrer" : undefined}
                        class="text-[var(--theme-link)] hover:text-[var(--theme-accent)] block leading-snug hover:underline"
                      >
                        {d.title} &rarr;
                      </a>
                      <span class="text-xs font-normal text-[var(--theme-muted)] block mt-0.5 leading-normal">
                        {d.desc}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Industry Collaborations -->
              {sec.partners && sec.partners.length > 0 && (
                <div>
                  <div class="text-xs font-mono uppercase tracking-wider text-[var(--theme-muted)] mb-2">
                    Industry &amp; Partners
                  </div>
                  <ul class="space-y-1.5 text-xs text-[var(--theme-muted)] pl-4 list-disc">
                    {sec.partners.map(partner => (
                      <li>{partner}</li>
                    ))}
                  </ul>
                </div>
              )}

              <!-- Code & Resources -->
              {sec.resources && sec.resources.length > 0 && (
                <div>
                  <div class="text-xs font-mono uppercase tracking-wider text-[var(--theme-muted)] mb-2">
                    Code &amp; Resources
                  </div>
                  <ul class="space-y-1.5 text-xs">
                    {sec.resources.map(res => (
                      <li>
                        <a 
                          href={res.href} 
                          target="_blank" 
                          rel="noopener noreferrer" 
                          class="text-[var(--theme-link)] hover:text-[var(--theme-accent)] inline-flex items-center gap-1 font-mono hover:underline"
                        >
                          <span>{res.name}</span> &rarr;
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </aside>
          </div>
        </div>
      ))}
    </article>
  </div>

  <script is:inline>
    function setupResearchTabs() {
      const tabBtns = document.querySelectorAll('.research-tab-btn');
      const tabPanes = document.querySelectorAll('.research-tab-pane');

      function setActiveTab(tabId) {
        let found = false;
        tabPanes.forEach(pane => {
          if (pane.id === 'pane-' + tabId) {
            pane.classList.remove('hidden');
            found = true;
          } else {
            pane.classList.add('hidden');
          }
        });

        if (!found && tabPanes.length > 0) {
          tabPanes[0].classList.remove('hidden');
          tabId = tabPanes[0].id.replace('pane-', '');
        }

        tabBtns.forEach(btn => {
          const isCurrent = btn.getAttribute('data-tab') === tabId;
          if (isCurrent) {
            btn.className = 'research-tab-btn active px-3.5 py-1.5 rounded border border-[var(--theme-heading)] bg-[var(--theme-heading)] text-[var(--theme-bg)] transition-colors cursor-pointer font-medium';
          } else {
            btn.className = 'research-tab-btn px-3.5 py-1.5 rounded border border-[var(--theme-border)] text-[var(--theme-muted)] hover:text-[var(--theme-accent)] transition-colors cursor-pointer';
          }
        });
      }

      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const tabId = btn.getAttribute('data-tab');
          if (tabId) {
            setActiveTab(tabId);
            history.replaceState(null, '', '#' + tabId);
          }
        });
      });

      function handleHash() {
        const hash = window.location.hash.replace('#', '');
        if (hash) {
          setActiveTab(hash);
        }
      }

      handleHash();
      window.addEventListener('hashchange', handleHash);
    }

    document.addEventListener('DOMContentLoaded', setupResearchTabs);
    if (document.readyState === 'interactive' || document.readyState === 'complete') {
      setupResearchTabs();
    }
  </script>
</BaseLayout>
