---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: "EMERALD: AI and Process Automation for Sustainable Entertainment and Media",
    period: "2023 – 2026",
    funding: "Horizon Europe (Consortium €3.79M, TCD €505k)",
    role: "Co-Principal Investigator",
    summary: "Collaborative European project with academic and industrial partners (including FilmLight, Brainstorm Multimedia, Disguise, UPF). The research focuses on developing energy-efficient neural processing pipelines, scene-aware illuminant estimation, and green media AI architectures that reduce computational and environmental overhead across virtual production and broadcast workflows."
  },
  {
    title: "Alliance for Open Media (AOMedia) Video Quality Research",
    period: "Ongoing",
    funding: "Alliance for Open Media",
    role: "Academic Representative / Principal Investigator",
    summary: "Contributing to the Video Quality Working Group alongside partners such as Google, Netflix, and Apple to advance next-generation royalty-free video compression standards (AV1 and AVM). Focus areas include perceptual rate-distortion optimization, clip-level Lagrangian multiplier adaptation for 4K HDR streaming, and lightweight encoder control models."
  },
  {
    title: "Interactive Vision & Alpha Matting (F, B, Alpha Matting)",
    period: "2019 – Present",
    funding: "Industry Collaboration & Technology Transfer",
    role: "Lead Supervisor / Senior Author",
    summary: "Investigation of human-in-the-loop computer vision architectures. Developing deep models capable of refining segmentation from minimal user clicks (ICME Best Paper Runner-Up with Adobe Research) and simultaneous estimation of foreground, background, and alpha matte. Research licensed commercially to PhotoRoom in 2021."
  },
  {
    title: "Statistical & Applied Optimal Transport in Visual Media",
    period: "Foundational & Ongoing",
    funding: "Enterprise Ireland / Marie-Curie / Industry",
    role: "Principal Investigator",
    summary: "Mathematical formulation of colour grading and image restoration using N-dimensional probability density transfer and continuous Monge-Kantorovich optimal transport. Integrated into commercial tools including The Foundry's Furnace suite (MatchGrade, Deflicker2) and utilised in high-end VFX and map imagery."
  }
];
---

<BaseLayout title="Research & Projects - François Pitié" currentSection="research">
  <div class="mb-6 pb-2 border-b border-slate-200 dark:border-slate-800">
    <h1 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">Research & Projects</h1>
    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
      Applied mathematics, signal processing, and machine learning for visual media and video streaming.
    </p>
  </div>

  <!-- Key Projects (Flat list with sober left border) -->
  <section class="space-y-6">
    {projects.map(p => (
      <div class="border-l-2 border-slate-200 dark:border-slate-800 pl-4 py-1 hover:border-[#0569B9] transition-colors">
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-1">
          <h2 class="text-sm sm:text-base font-semibold text-slate-900 dark:text-slate-100">{p.title}</h2>
          <span class="text-xs font-mono text-slate-500 shrink-0">{p.period}</span>
        </div>
        <div class="text-xs text-[#0569B9] dark:text-[#82B4DC] mb-2 font-medium">
          {p.role} &bull; {p.funding}
        </div>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          {p.summary}
        </p>
      </div>
    ))}
  </section>
</BaseLayout>
