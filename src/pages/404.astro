---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found - François Pitié">
  <div class="py-16 text-center">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900 dark:text-white mb-2">404</h1>
    <p class="text-sm text-[#5C6166] dark:text-[#CBCCC6] mb-6">The page you were looking for could not be found.</p>
    <a href="/" class="inline-flex items-center px-4 py-2 text-xs font-medium rounded-lg bg-sky-600 text-white hover:bg-sky-700 transition-colors">
      Return Home
    </a>
  </div>
</BaseLayout>
