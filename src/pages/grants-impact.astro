---
import BaseLayout from '../layouts/BaseLayout.astro';

const competitiveGrants = [
  {
    title: "AI and Process Automation for Sustainable Entertainment and Media (EMERALD)",
    funder: "European Commission — Horizon Europe",
    period: "2023 – 2026",
    role: "Co-Principal Investigator",
    details: "Developing green media AI algorithms and neural processing pipelines for sustainable video production, live broadcast, and virtual studios.",
    logo: "/images/collaborations/european_commission.png"
  },
  {
    title: "SYZE: Computer Vision for 3D Body Measurement from Smartphone Imagery",
    funder: "Enterprise Ireland Commercialisation Fund",
    period: "2019 – 2020",
    role: "Lead Principal Investigator",
    details: "Pioneered neural reconstruction and metric scale estimation for apparel sizing; subsequently spun out as Swan AI.",
    logo: "/images/collaborations/enterprise_ireland.png"
  },
  {
    title: "SFI Research Centres Programme (Huawei Industry Collaboration)",
    funder: "Huawei Technologies / SFI",
    period: "2018 – 2020",
    role: "Lead Principal Investigator",
    details: "High-performance video analysis, perceptual coding, and computer vision systems.",
    logo: "/images/collaborations/huawei.png"
  },
  {
    title: "SFI Research Centres Programme (Huawei Phase 1)",
    funder: "Huawei Technologies / SFI",
    period: "2017 – 2018",
    role: "Lead Principal Investigator",
    details: "Intelligent video processing algorithms for next-generation mobile hardware.",
    logo: "/images/collaborations/sfi.png"
  },
  {
    title: "eBay Image Processing and Machine Translation Project",
    funder: "eBay / SFI ADAPT",
    period: "2017",
    role: "Lead Principal Investigator",
    details: "Visual search and product image quality enhancement.",
    logo: "/images/collaborations/adapt.png"
  },
  {
    title: "Advanced Video Debanding",
    funder: "Google Research Award",
    period: "2013",
    role: "Lead Principal Investigator",
    details: "Development of statistical debanding algorithms for compressed internet video.",
    logo: "/images/collaborations/google.png"
  },
  {
    title: "3DScam: 2D-to-3D Video Conversion",
    funder: "Enterprise Ireland Commercialisation Fund",
    period: "2011 – 2013",
    role: "Lead Principal Investigator",
    details: "Developed stereoscopic depth estimation systems; led to the formation of TCD campus company PixelPuffin.",
    logo: "/images/collaborations/enterprise_ireland.png"
  }
];

const patents = [
  {
    title: "Method for Embedding Advertisement in Video and Computer Device",
    patentNo: "US 2021/0044877 A1 / US 16/990,011",
    year: "2023",
    assignee: "Tencent / Trinity College Dublin",
    inventors: "Wei Xu, Clare Conran, François Pitié"
  },
  {
    title: "Automated video production system and method",
    patentNo: "US 9305600 B2",
    year: "2016",
    assignee: "Provost, Fellows and Scholars of Trinity College Dublin",
    inventors: "Damien Kelly, Frank Boland, François Pitié, Anil Kokaram"
  },
  {
    title: "Dominant motion estimation for image sequence processing",
    patentNo: "US 8385418 B2",
    year: "2013",
    assignee: "Google LLC",
    inventors: "Andrew Crawford, Anil Kokaram, Francis Kelly, Hugh Denman, François Pitié"
  },
  {
    title: "Method for matching color in images",
    patentNo: "US 7796812 B2",
    year: "2010",
    assignee: "Google LLC",
    inventors: "François Pitié, Anil Kokaram"
  }
];
---

<BaseLayout title="Grants & Patents - François Pitié" currentSection="grants-impact">
  <div class="mb-8 pb-2 border-b border-[#E6E8EB] dark:border-white/[0.08]">
    <h1 class="text-xl font-semibold tracking-tight text-[#242936] dark:text-[#ECEFF4]">Grants & Patents</h1>
    <p class="text-xs sm:text-sm text-[#828E9F] dark:text-[#707A8C] mt-1">
      Competitive research funding and granted intellectual property.
    </p>
  </div>

  <!-- Competitive Research Grants with Funding Body Logos -->
  <section class="mb-12">
    <h2 class="text-lg font-semibold tracking-tight text-[#242936] dark:text-[#ECEFF4] pb-1.5 border-b border-[#E6E8EB] dark:border-white/[0.08] mb-4">
      Competitive Research Grants
    </h2>
    <div class="space-y-6">
      {competitiveGrants.map(g => (
        <div class="py-1 flex flex-col sm:flex-row sm:items-start justify-between gap-4">
          <div class="flex-1">
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-0.5">
              <h3 class="font-medium text-[#242936] dark:text-[#ECEFF4]">{g.title}</h3>
              <span class="text-xs font-mono text-[#828E9F] dark:text-[#707A8C] shrink-0">{g.period}</span>
            </div>
            <div class="text-xs text-[#2B79C2] dark:text-[#73D0FF] font-medium mb-1">
              {g.funder} &bull; {g.role}
            </div>
            <p class="text-sm text-[#5C6166] dark:text-[#CBCCC6] leading-relaxed">
              {g.details}
            </p>
          </div>
          {g.logo && (
            <div class="shrink-0 flex items-center justify-center p-1 rounded bg-black/[0.02] dark:bg-white/[0.04] border border-[#E6E8EB] dark:border-white/[0.08] w-24 h-12 self-start">
              <img 
                src={g.logo} 
                alt={g.funder} 
                class="max-w-full max-h-full object-contain"
              />
            </div>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- Patents (Flat list) -->
  <section>
    <h2 class="text-lg font-semibold tracking-tight text-[#242936] dark:text-[#ECEFF4] pb-1.5 border-b border-[#E6E8EB] dark:border-white/[0.08] mb-4">
      Granted Patents
    </h2>
    <div class="space-y-4">
      {patents.map(pat => (
        <div class="py-0.5">
          <div class="flex items-baseline justify-between gap-2">
            <h3 class="font-medium text-[#242936] dark:text-[#ECEFF4]">{pat.title}</h3>
            <span class="text-xs font-mono text-[#2B79C2] dark:text-[#73D0FF] shrink-0 font-medium">{pat.patentNo}</span>
          </div>
          <div class="text-xs text-[#828E9F] dark:text-[#707A8C] mt-0.5">
            Inventors: {pat.inventors}
          </div>
          <div class="text-xs text-[#828E9F] dark:text-[#707A8C] dark:text-[#828E9F] mt-0.5">
            Assignee: {pat.assignee} ({pat.year})
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
