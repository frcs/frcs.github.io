---
import BaseLayout from '../layouts/BaseLayout.astro';

const completedPhDs = [
  {
    name: "Dr. Clément Bled",
    year: "2025",
    role: "Primary Supervisor",
    topic: "Energy-efficient video denoising and restoration architectures",
    destination: "Postdoctoral Researcher, Trinity College Dublin"
  },
  {
    name: "Dr. Hao Wu",
    year: "2023",
    role: "Primary Supervisor",
    topic: "Deep multimodal learning and video-text generation",
    destination: "Huawei Technologies"
  },
  {
    name: "Dr. Daniel J. Ringis",
    year: "2022",
    role: "Secondary Supervisor",
    topic: "Perceptual optimization and rate-distortion in video compression",
    destination: "Lecturer, University of the West Indies"
  },
  {
    name: "Dr. Marco Forte",
    year: "2022",
    role: "Primary Supervisor",
    topic: "Interactive object selection and trimap-free image matting",
    destination: "Senior Computer Vision Engineer, PhotoRoom"
  },
  {
    name: "Dr. Félix Raimbault",
    year: "2014",
    role: "Secondary Supervisor",
    topic: "Video restoration and motion estimation",
    destination: ""
  },
  {
    name: "Dr. Roisin Rowley-Brooke",
    year: "2013",
    role: "Secondary Supervisor",
    topic: "Archive film restoration and defect removal",
    destination: ""
  },
  {
    name: "Dr. Mohammed Ahmed",
    year: "2011",
    role: "Secondary Supervisor",
    topic: "Motion analysis and video processing",
    destination: ""
  }
];

const currentResearchers = [
  {
    name: "Bold-Erdene Ganbaatar",
    status: "PhD Candidate",
    role: "Primary Supervisor",
    topic: "Colour grading (neural automated scene matching)"
  }
];
---

<BaseLayout title="Team & Alumni - François Pitié" currentSection="team">
  <div class="mb-8 pb-3 border-b border-slate-200 dark:border-slate-800">
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Team & Alumni</h1>
    <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 mt-1">
      Doctoral researchers, postdocs, and postgraduate alumni supervised at Trinity College Dublin.
    </p>
  </div>

  <!-- Current Researchers (Flat style) -->
  <section class="mb-12">
    <h2 class="text-lg sm:text-xl font-bold tracking-tight text-slate-900 dark:text-white mb-4 pb-2 border-b border-slate-200 dark:border-slate-800">
      Current Doctoral Researchers
    </h2>
    <div class="space-y-4">
      {currentResearchers.map(r => (
        <div class="border-l-2 border-[#0569B9] pl-3.5 py-1">
          <div class="flex items-baseline gap-2">
            <span class="text-base sm:text-lg font-semibold text-slate-900 dark:text-slate-100">{r.name}</span>
            <span class="text-xs sm:text-sm font-mono text-[#0569B9] dark:text-[#82B4DC]">[{r.status}]</span>
          </div>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-0.5">{r.role}</p>
          <p class="text-sm sm:text-base text-slate-700 dark:text-slate-300 mt-0.5">{r.topic}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Completed PhDs (Flat list) -->
  <section>
    <h2 class="text-lg sm:text-xl font-bold tracking-tight text-slate-900 dark:text-white mb-4 pb-2 border-b border-slate-200 dark:border-slate-800">
      Doctoral Alumni
    </h2>
    <div class="space-y-4">
      {completedPhDs.map(phd => (
        <div class="border-l-2 border-slate-200 dark:border-slate-800 pl-3.5 py-1 hover:border-[#0569B9] transition-colors">
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
            <div class="text-base sm:text-lg font-semibold text-slate-900 dark:text-slate-100">
              {phd.name} <span class="text-xs sm:text-sm font-normal text-slate-500 font-mono">({phd.year})</span>
            </div>
            <div class="text-xs sm:text-sm text-slate-400">{phd.role}</div>
          </div>
          <div class="text-sm sm:text-base text-slate-600 dark:text-slate-300 mt-0.5">
            {phd.topic}
          </div>
          {phd.destination && (
            <div class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-0.5">
              <span class="text-slate-400 dark:text-slate-500">Destination:</span> {phd.destination}
            </div>
          )}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
