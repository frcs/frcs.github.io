---
import BaseLayout from '../layouts/BaseLayout.astro';

const currentResearchers = [
  {
    name: "Dr. Clément Bled",
    status: "Postdoctoral Research Fellow",
    role: "Postdoctoral Researcher & Project Lead",
    topic: "Energy-efficient video denoising, inverse problems, and deep video restoration architectures"
  },
  {
    name: "Bold-Erdene Ganbaatar",
    status: "PhD Candidate",
    role: "Primary Supervisor",
    topic: "Colour grading (neural automated scene matching)"
  }
];

const completedPhDs = [
  {
    name: "Dr. Clément Bled",
    year: "2025",
    role: "Primary Supervisor",
    topic: "Energy-efficient video denoising and restoration architectures",
    destination: "Postdoctoral Research Fellow, Trinity College Dublin"
  },
  {
    name: "Dr. Hao Wu",
    year: "2023",
    role: "Primary Supervisor",
    topic: "Deep multimodal learning and video-text generation",
    destination: "Huawei Technologies"
  },
  {
    name: "Dr. Daniel J. Ringis",
    year: "2022",
    role: "Secondary Supervisor",
    topic: "Perceptual optimization and rate-distortion in video compression",
    destination: "Lecturer, University of the West Indies"
  },
  {
    name: "Dr. Marco Forte",
    year: "2022",
    role: "Primary Supervisor",
    topic: "Interactive object selection and trimap-free image matting",
    destination: "Senior Computer Vision Engineer, PhotoRoom"
  },
  {
    name: "Dr. Félix Raimbault",
    year: "2014",
    role: "Secondary Supervisor",
    topic: "Video restoration and motion estimation",
    destination: ""
  },
  {
    name: "Dr. Roisin Rowley-Brooke",
    year: "2013",
    role: "Secondary Supervisor",
    topic: "Archive film restoration and defect removal",
    destination: ""
  },
  {
    name: "Dr. Mohammed Ahmed",
    year: "2011",
    role: "Secondary Supervisor",
    topic: "Motion analysis and video processing",
    destination: ""
  }
];

const postdocAlumni = [
  {
    name: "Prof. Soumyabrata Dev",
    period: "2017 – 2019",
    role: "Postdoctoral Researcher & Project Collaborator (Huawei / SFI ADAPT)",
    topic: "Deep learning for video advertising, 3D product insertion, and computer vision",
    destination: "Associate Professor, School of Computer Science & Statistics, Trinity College Dublin"
  },
  {
    name: "Dr. Hossein Javidnia",
    period: "2018 – 2021",
    role: "Postdoctoral Research Fellow (Huawei Deep Real / ADAPT Centre)",
    topic: "Deep learning for 3D object placement in video, 3D reconstruction, and augmented reality",
    destination: "Assistant Professor in Computational Engineering, Trinity College Dublin"
  }
];
---

<BaseLayout title="Team & Alumni - François Pitié" currentSection="team">
  <div class="mb-8 pb-2 border-b border-[#E6E8EB] dark:border-white/[0.08]">
    <h1 class="text-xl font-semibold tracking-tight text-[#242936] dark:text-[#ECEFF4]">Team & Alumni</h1>
    <p class="text-xs sm:text-sm text-[#828E9F] dark:text-[#707A8C] mt-1">
      Current postdoctoral fellows, doctoral researchers, and research alumni at Trinity College Dublin.
    </p>
  </div>

  <!-- Current Researchers & Postdocs -->
  <section class="mb-12">
    <h2 class="text-lg font-semibold tracking-tight text-[#242936] dark:text-[#ECEFF4] mb-3.5 pb-1.5 border-b border-[#E6E8EB] dark:border-white/[0.08]">
      Current Team
    </h2>
    <div class="space-y-4">
      {currentResearchers.map(r => (
        <div class="py-0.5">
          <div class="flex items-baseline gap-2">
            <span class="font-medium text-[#242936] dark:text-[#ECEFF4]">{r.name}</span>
            <span class="text-xs font-mono text-[#2B79C2] dark:text-[#73D0FF]">[{r.status}]</span>
          </div>
          <p class="text-xs text-[#F29718] mt-0.5">{r.role}</p>
          <p class="text-sm text-[#5C6166] dark:text-[#ECEFF4]/90 mt-0.5 leading-relaxed">{r.topic}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Postdoctoral & Research Fellow Alumni -->
  <section class="mb-12">
    <h2 class="text-lg font-semibold tracking-tight text-[#242936] dark:text-[#ECEFF4] mb-3.5 pb-1.5 border-b border-[#E6E8EB] dark:border-white/[0.08]">
      Postdoctoral & Research Fellow Alumni
    </h2>
    <div class="space-y-4">
      {postdocAlumni.map(p => (
        <div class="py-0.5">
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
            <div class="font-medium text-[#242936] dark:text-[#ECEFF4]">
              {p.name} <span class="text-xs text-[#F29718] font-mono">({p.period})</span>
            </div>
            <div class="text-xs text-[#F29718]">{p.role}</div>
          </div>
          <div class="text-sm text-[#5C6166] dark:text-[#ECEFF4]/90 mt-0.5 leading-relaxed">
            {p.topic}
          </div>
          {p.destination && (
            <div class="text-xs text-[#828E9F] dark:text-[#707A8C] mt-0.5">
              <span class="text-[#F29718]">Current / Subsequent:</span> {p.destination}
            </div>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- Completed PhDs -->
  <section>
    <h2 class="text-lg font-semibold tracking-tight text-[#242936] dark:text-[#ECEFF4] mb-3.5 pb-1.5 border-b border-[#E6E8EB] dark:border-white/[0.08]">
      Doctoral Alumni
    </h2>
    <div class="space-y-4">
      {completedPhDs.map(phd => (
        <div class="py-0.5">
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
            <div class="font-medium text-[#242936] dark:text-[#ECEFF4]">
              {phd.name} <span class="text-xs text-[#F29718] font-mono">({phd.year})</span>
            </div>
            <div class="text-xs text-[#F29718] font-mono shrink-0">{phd.role}</div>
          </div>
          <div class="text-sm text-[#5C6166] dark:text-[#ECEFF4]/90 mt-0.5 leading-relaxed">
            {phd.topic}
          </div>
          {phd.destination && (
            <div class="text-xs text-[#828E9F] dark:text-[#707A8C] mt-0.5">
              <span class="text-[#F29718]">Current / Subsequent:</span> {phd.destination}
            </div>
          )}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
