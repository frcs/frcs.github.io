---
import BaseLayout from '../layouts/BaseLayout.astro';

const currentResearchers = [
  {
    name: "Dr. Clément Bled",
    status: "Postdoctoral Research Fellow",
    role: "Postdoctoral Researcher & Project Lead",
    topic: "Energy-efficient video denoising, inverse problems, and deep video restoration architectures"
  },
  {
    name: "Bold-Erdene Ganbaatar",
    status: "PhD Candidate",
    role: "Primary Supervisor",
    topic: "Colour grading (neural automated scene matching)"
  }
];

const completedPhDs = [
  {
    name: "Dr. Clément Bled",
    year: "2025",
    role: "Primary Supervisor",
    topic: "Energy-efficient video denoising and restoration architectures",
    destination: "Postdoctoral Research Fellow, Trinity College Dublin"
  },
  {
    name: "Dr. Hao Wu",
    year: "2023",
    role: "Primary Supervisor",
    topic: "Deep multimodal learning and video-text generation",
    destination: "Huawei Technologies"
  },
  {
    name: "Dr. Daniel J. Ringis",
    year: "2022",
    role: "Secondary Supervisor",
    topic: "Perceptual optimisation and rate-distortion in video compression",
    destination: "Lecturer, University of the West Indies"
  },
  {
    name: "Dr. Marco Forte",
    year: "2022",
    role: "Primary Supervisor",
    topic: "Interactive object selection and trimap-free image matting",
    destination: "Senior Computer Vision Engineer, PhotoRoom"
  },
  {
    name: "Dr. Félix Raimbault",
    year: "2014",
    role: "Secondary Supervisor",
    topic: "Video restoration and motion estimation",
    destination: ""
  },
  {
    name: "Dr. Roisin Rowley-Brooke",
    year: "2013",
    role: "Secondary Supervisor",
    topic: "Archive film restoration and defect removal",
    destination: ""
  },
  {
    name: "Dr. Mohammed Ahmed",
    year: "2011",
    role: "Secondary Supervisor",
    topic: "Motion analysis and video processing",
    destination: ""
  }
];

const postdocAlumni = [
  {
    name: "Prof. Soumyabrata Dev",
    period: "2017 – 2019",
    role: "Postdoctoral Researcher & Project Collaborator (Huawei / SFI ADAPT)",
    topic: "Deep learning for video advertising, 3D product insertion, and computer vision",
    destination: "Associate Professor, School of Computer Science & Statistics, Trinity College Dublin"
  },
  {
    name: "Dr. Hossein Javidnia",
    period: "2018 – 2021",
    role: "Postdoctoral Research Fellow (Huawei Deep Real / ADAPT Centre)",
    topic: "Deep learning for 3D object placement in video, 3D reconstruction, and augmented reality",
    destination: "Assistant Professor in Computational Engineering, Trinity College Dublin"
  }
];
---

<BaseLayout title="Team & Alumni - François Pitié" currentSection="team">
  <div class="post">
    <header class="post-header mb-8">
      <h1 class="post-title">Team & Alumni</h1>
      <p class="desc text-xs sm:text-sm text-[var(--theme-muted)] mt-1.5 pb-3 border-b border-[var(--theme-border)]">
        Current postdoctoral fellows, doctoral researchers, and research alumni at Trinity College Dublin.
      </p>
    </header>

    <article class="space-y-12">
      <!-- Current Researchers & Postdocs -->
      <section>
        <h2 class="text-lg font-light tracking-tight text-[var(--theme-heading)] pb-2 border-b border-[var(--theme-border)] mb-5">
          Current Team
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {currentResearchers.map(r => (
            <div class="p-4 rounded border border-[var(--theme-border)] bg-[var(--theme-card)]/35">
              <div class="flex items-baseline justify-between gap-2 mb-1">
                <span class="font-semibold text-sm text-[var(--theme-heading)]">{r.name}</span>
                <span class="badge-abbr">{r.status}</span>
              </div>
              <p class="text-xs text-[var(--theme-accent)] font-medium mt-1">{r.role}</p>
              <p class="text-xs sm:text-sm text-[var(--theme-fg)] mt-2 leading-relaxed">{r.topic}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Postdoctoral & Research Fellow Alumni -->
      <section>
        <h2 class="text-lg font-light tracking-tight text-[var(--theme-heading)] pb-2 border-b border-[var(--theme-border)] mb-5">
          Postdoctoral Alumni
        </h2>
        <div class="space-y-4">
          {postdocAlumni.map(p => (
            <div class="p-4 rounded border border-[var(--theme-border)] bg-[var(--theme-card)]/20">
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-1">
                <div class="font-semibold text-sm text-[var(--theme-heading)]">
                  {p.name} <span class="text-xs text-[var(--theme-muted)] font-mono font-normal">({p.period})</span>
                </div>
                <div class="text-xs text-[var(--theme-muted)]">{p.role}</div>
              </div>
              <div class="text-xs sm:text-sm text-[var(--theme-fg)] leading-relaxed mt-1.5">
                {p.topic}
              </div>
              {p.destination && (
                <div class="text-xs text-[var(--theme-muted)] mt-2 pt-2 border-t border-[var(--theme-border)]/40">
                  <span class="font-medium text-[var(--theme-heading)]">Destination:</span> {p.destination}
                </div>
              )}
            </div>
          ))}
        </div>
      </section>

      <!-- Completed PhDs -->
      <section>
        <h2 class="text-lg font-light tracking-tight text-[var(--theme-heading)] pb-2 border-b border-[var(--theme-border)] mb-5">
          Doctoral Alumni
        </h2>
        <div class="space-y-4">
          {completedPhDs.map(phd => (
            <div class="p-4 rounded border border-[var(--theme-border)] bg-[var(--theme-card)]/20">
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-1">
                <div class="font-semibold text-sm text-[var(--theme-heading)]">
                  {phd.name} <span class="text-xs text-[var(--theme-muted)] font-mono font-normal">({phd.year})</span>
                </div>
                <div class="text-xs text-[var(--theme-muted)] font-mono">{phd.role}</div>
              </div>
              <div class="text-xs sm:text-sm text-[var(--theme-fg)] leading-relaxed mt-1.5">
                {phd.topic}
              </div>
              {phd.destination && (
                <div class="text-xs text-[var(--theme-muted)] mt-2 pt-2 border-t border-[var(--theme-border)]/40">
                  <span class="font-medium text-[var(--theme-heading)]">Destination:</span> {phd.destination}
                </div>
              )}
            </div>
          ))}
        </div>
      </section>
    </article>
  </div>
</BaseLayout>
