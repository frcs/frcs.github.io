---
import BaseLayout from '../layouts/BaseLayout.astro';

const modules = [
  {
    code: "EEU44C16 / EE5C16",
    title: "Deep Learning and its Applications",
    level: "Level 9 (Senior Sophister & MAI)",
    desc: "Comprehensive module covering neural networks, backpropagation, CNNs, sequence models, generative models, and transformers, with hands-on PyTorch coding labs and automated evaluation benchmarks.",
    links: [
      { name: "Course Website", url: "https://frcs.github.io/4c16/" },
      { name: "Zenodo Lecture Notes", url: "https://doi.org/10.5281/zenodo.17954655" }
    ]
  },
  {
    code: "EE55C34",
    title: "Advanced AI",
    level: "Level 9 (Postgraduate / MAI)",
    desc: "Advanced graduate-level study of contemporary generative models, diffusion architectures, representation learning, and modern computer vision systems.",
    links: []
  },
  {
    code: "EEU22E10",
    title: "Engineering Design Project: Robotics Buggy",
    level: "Level 8 (Junior Fresh / 2nd Year Engineering)",
    desc: "Hands-on project-based module in which students design, construct, and programme an autonomous wheeled robot to navigate a timed obstacle track.",
    links: []
  }
];
---

<BaseLayout title="Teaching - François Pitié" currentSection="teaching">
  <div class="mb-8 pb-3 border-b border-slate-100 dark:border-slate-800">
    <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Teaching</h1>
    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
      Undergraduate and postgraduate courses at the Department of Electronic & Electrical Engineering, Trinity College Dublin.
    </p>
  </div>

  <!-- Teaching Philosophy Note -->
  <div class="p-4 rounded-xl bg-[#EBF3FA]/60 dark:bg-[#122B44]/50 border border-[#0569B9]/20 dark:border-[#0569B9]/30 mb-8 text-xs sm:text-sm text-slate-700 dark:text-slate-200 leading-relaxed">
    <strong class="text-[#0569B9] dark:text-[#82B4DC] font-semibold block mb-1">Teaching Philosophy & Pedagogy</strong>
    My teaching integrates open-ended challenges with mastery-based learning. By deploying automated evaluation platforms in technical modules such as deep learning and robotics, students are encouraged to iterate rapidly, debug effectively, and achieve deep conceptual mastery in an authentic engineering environment.
  </div>

  <!-- Modules List -->
  <section class="space-y-6">
    {modules.map(m => (
      <div class="p-5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#121c30] shadow-xs">
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-1">
          <h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">
            <span class="font-mono text-[#0569B9] dark:text-[#82B4DC] mr-1.5">{m.code}:</span> {m.title}
          </h2>
          <span class="text-xs text-slate-500 dark:text-slate-400 shrink-0 font-medium">{m.level}</span>
        </div>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">
          {m.desc}
        </p>

        {m.links.length > 0 && (
          <div class="mt-3 flex items-center gap-3 pt-3 border-t border-slate-100 dark:border-slate-800/80">
            {m.links.map(l => (
              <a href={l.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-xs font-semibold text-[#0569B9] dark:text-[#82B4DC] hover:underline">
                {l.name}
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              </a>
            ))}
          </div>
        )}
      </div>
    ))}
  </section>
</BaseLayout>
