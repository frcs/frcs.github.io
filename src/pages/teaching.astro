---
import BaseLayout from '../layouts/BaseLayout.astro';

const currentModules = [
  {
    code: "EEU44C16 / EE5C16",
    title: "Deep Learning and its Applications",
    level: "Level 9 (Senior Sophister & MAI, 10 ECTS)",
    desc: "Comprehensive module covering neural networks, backpropagation, convolutional networks, sequence models, generative models, and transformers, with hands-on PyTorch coding labs and automated evaluation benchmarks.",
    links: [
      { name: "Course Website", url: "https://frcs.github.io/4c16/" },
      { name: "Zenodo Lecture Notes", url: "https://doi.org/10.5281/zenodo.17954655" }
    ]
  },
  {
    code: "EE55C34",
    title: "Advanced AI",
    level: "Level 9 (Postgraduate / MAI, 5 ECTS)",
    desc: "Advanced graduate-level study of contemporary generative models, diffusion architectures, representation learning, and modern computer vision systems.",
    links: []
  },
  {
    code: "EEU22E10",
    title: "Engineering Design Project: Robotics Buggy",
    level: "Level 8 (Junior Fresh / 2nd Year Engineering, 10 ECTS)",
    desc: "Hands-on project-based group module in which students design, construct, and programme an autonomous wheeled robot to navigate a timed obstacle track.",
    links: []
  }
];

const pastModules = [
  {
    code: "EEU44C08 / EEP55M08",
    title: "Digital Image and Video Processing",
    period: "2016 – 2024",
    desc: "Foundations of 2D signal processing, spatial and frequency domain image filtering, motion estimation, restoration, and video coding principles."
  },
  {
    code: "CS7034",
    title: "Augmented Reality",
    period: "2013",
    desc: "Postgraduate course covering camera calibration, projective geometry, tracking, and graphic overlay systems."
  },
  {
    code: "CS7008",
    title: "Computer Vision (Postgraduate)",
    period: "2009",
    desc: "Graduate module on feature detection, robust estimation, image segmentation, and statistical models."
  },
  {
    code: "CS4053 / 4D4",
    title: "Undergraduate Computer Vision",
    period: "2009 – 2011",
    desc: "Foundational computer vision, edge detection, optical flow, and stereoscopic depth estimation."
  }
];
---

<BaseLayout title="Teaching - François Pitié" currentSection="teaching">
  <div class="mb-6 pb-2 border-b border-slate-200 dark:border-slate-800">
    <h1 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">Teaching</h1>
    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
      Undergraduate and postgraduate courses delivered at the Department of Electronic & Electrical Engineering, Trinity College Dublin.
    </p>
  </div>

  <!-- Teaching Philosophy Note -->
  <div class="border-l-2 border-[#0569B9] pl-3 py-1 mb-8 text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
    <strong class="text-slate-900 dark:text-white font-semibold">Teaching Philosophy: </strong>
    My teaching integrates open-ended challenges with mastery-based learning. By deploying automated evaluation platforms in technical modules such as deep learning and robotics, students are encouraged to iterate rapidly, debug effectively, and achieve deep conceptual mastery in an authentic engineering environment.
  </div>

  <!-- Current Modules (Flat list) -->
  <section class="space-y-6 mb-12">
    <h2 class="text-base font-bold tracking-tight text-slate-900 dark:text-white pb-1 border-b border-slate-100 dark:border-slate-800">
      Current Modules
    </h2>

    {currentModules.map(m => (
      <div class="border-l-2 border-slate-200 dark:border-slate-800 pl-4 py-1 hover:border-[#0569B9] transition-colors">
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
          <h3 class="text-sm sm:text-base font-semibold text-slate-900 dark:text-slate-100">
            <span class="font-mono text-[#0569B9] dark:text-[#82B4DC] mr-1.5">{m.code}:</span> {m.title}
          </h3>
          <span class="text-xs text-slate-500 shrink-0 font-mono">{m.level}</span>
        </div>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-1.5 leading-relaxed">
          {m.desc}
        </p>

        {m.links.length > 0 && (
          <div class="mt-2.5 flex items-center gap-4 text-xs font-semibold text-[#0569B9] dark:text-[#82B4DC]">
            {m.links.map(l => (
              <a href={l.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 hover:underline">
                {l.name}
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              </a>
            ))}
          </div>
        )}
      </div>
    ))}
  </section>

  <!-- Previous Modules (Flat list) -->
  <section class="space-y-4">
    <h2 class="text-base font-bold tracking-tight text-slate-900 dark:text-white pb-1 border-b border-slate-100 dark:border-slate-800">
      Previous Modules
    </h2>

    {pastModules.map(m => (
      <div class="border-l-2 border-slate-200 dark:border-slate-800 pl-4 py-1 hover:border-[#0569B9] transition-colors">
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
          <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">
            <span class="font-mono text-slate-500 mr-1.5">{m.code}:</span> {m.title}
          </h3>
          <span class="text-xs text-slate-400 font-mono shrink-0">{m.period}</span>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 mt-1 leading-relaxed">
          {m.desc}
        </p>
      </div>
    ))}
  </section>
</BaseLayout>
