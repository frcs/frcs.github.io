---
import BaseLayout from '../layouts/BaseLayout.astro';

const currentModules = [
  {
    code: "EEU44C16 / EE5C16",
    title: "Deep Learning and its Applications",
    level: "Level 9 (Senior Sophister & MAI)",
    credits: "10 ECTS",
    desc: "Comprehensive module covering neural networks, backpropagation dynamics, convolutional architectures, sequence models, generative models, and transformers, with hands-on PyTorch coding labs and automated evaluation benchmarks.",
    pageUrl: "/teaching/4c16-teaching",
    resources: [
      {
        title: "Open Lecture Notes & Coursebook",
        description: "Full online curriculum covering mathematical formulations, architectural diagrams, loss landscapes, and PyTorch tutorials.",
        links: [
          { name: "Read Online", url: "https://frcs.github.io/4C16-LectureNotes/" },
          { name: "Zenodo DOI", url: "https://doi.org/10.5281/zenodo.17954655" }
        ]
      },
      {
        title: "Continuous Lab Autograder & Course Hub",
        description: "Hands-on coding lab system with automated Git evaluation for Colab assignments and live course schedules.",
        links: [
          { name: "Course Portal", url: "https://frcs.github.io/4c16/" },
          { name: "GitHub Autograder", url: "https://github.com/frcs/4C16-2425" }
        ]
      }
    ]
  },
  {
    code: "EE55C34",
    title: "Advanced AI",
    level: "Level 9 (Postgraduate / MAI)",
    credits: "5 ECTS",
    desc: "Advanced graduate-level study of contemporary generative models, diffusion architectures, representation learning, and modern computer vision systems.",
    pageUrl: "/teaching/5c34-teaching",
    resources: []
  }
];

const pastModules = [
  {
    code: "EEU22E10",
    title: "Engineering Design Project: Robotics Buggy",
    period: "2016 – 2021",
    level: "Level 8 (Junior Fresh / 2nd Year Engineering, 10 ECTS)",
    desc: "Core second-year group design project coordinated and redeveloped to accommodate cohorts of over 200 students. Students design, construct, and programme an autonomous wheeled robot to navigate a timed obstacle track."
  },
  {
    code: "EEU44C08 / EEP55M08",
    title: "Digital Image and Video Processing",
    period: "2016 – 2024",
    level: "Level 9 (5 ECTS)",
    desc: "Foundations of 2D signal processing, spatial and frequency domain image filtering, motion estimation, restoration, and video coding principles."
  }
];

const priorModules = [
  {
    code: "CS7034",
    title: "Augmented Reality",
    period: "2013",
    desc: "Postgraduate course covering camera calibration, projective geometry, tracking, and graphic overlay systems."
  },
  {
    code: "CS7008",
    title: "Computer Vision (Postgraduate)",
    period: "2009",
    desc: "Graduate module on feature detection, robust estimation, image segmentation, and statistical models."
  },
  {
    code: "CS4053 / 4D4",
    title: "Undergraduate Computer Vision",
    period: "2009 – 2011",
    desc: "Foundational computer vision, edge detection, optical flow, and stereoscopic depth estimation."
  }
];
---

<BaseLayout title="Teaching - François Pitié" currentSection="teaching">
  <div class="mb-8 pb-2 border-b border-[#E6E8EB] dark:border-white/[0.08]">
    <h1 class="text-xl font-semibold tracking-tight text-[#242936] dark:text-[#ECEFF4]">Teaching</h1>
    <p class="text-xs sm:text-sm text-[#828E9F] dark:text-[#707A8C] mt-1">
      Undergraduate and postgraduate courses delivered at the Department of Electronic & Electrical Engineering, Trinity College Dublin.
    </p>
  </div>

  <!-- Teaching Honours & Recognition -->
  <div class="mb-6 text-xs sm:text-sm text-[#5C6166] dark:text-[#ECEFF4]">
    <div class="font-medium text-[#242936] dark:text-[#ECEFF4]">
      Teaching Recognition
    </div>
    <p class="mt-0.5 text-xs text-[#828E9F] dark:text-[#707A8C]">
      Recipient of the <strong>University Excellence in Teaching Award</strong> and the <strong>Inspiring Educator Award</strong> (Trinity College Dublin, 2026).
    </p>
  </div>

  <!-- Teaching Philosophy Note -->
  <div class="mb-8 text-xs sm:text-sm text-[#5C6166] dark:text-[#ECEFF4] leading-relaxed">
    <strong class="text-[#242936] dark:text-[#ECEFF4] font-medium">Teaching Philosophy: </strong>
    My teaching integrates open-ended engineering challenges with continuous, mastery-based feedback. By deploying automated evaluation platforms in technical modules such as deep learning and robotics, students iterate rapidly, debug effectively, and achieve deep conceptual mastery.
  </div>

  <!-- Current Modules -->
  <section class="space-y-8 mb-12">
    <h2 class="text-lg font-semibold tracking-tight text-[#242936] dark:text-[#ECEFF4] pb-1.5 border-b border-[#E6E8EB] dark:border-white/[0.08]">
      Current Modules
    </h2>

    {currentModules.map(m => (
      <div class="space-y-2.5">
        <div>
          <div class="flex items-baseline justify-between gap-3">
            <h3 class="font-medium text-[#242936] dark:text-[#ECEFF4]">
              <a href={m.pageUrl} class="hover:text-[#2B79C2] dark:hover:text-[#73D0FF] transition-colors">
                <span class="font-mono text-xs text-[#2B79C2] dark:text-[#73D0FF] mr-1.5">{m.code}:</span>
                <span>{m.title}</span>
              </a>
            </h3>
            <span class="text-xs text-[#828E9F] dark:text-[#707A8C] font-mono shrink-0 font-medium">{m.credits}</span>
          </div>
          <div class="text-xs text-[#828E9F] dark:text-[#707A8C] font-mono mt-0.5">
            {m.level}
          </div>
        </div>

        <p class="text-sm text-[#5C6166] dark:text-[#CBCCC6] leading-relaxed">
          {m.desc}
        </p>

        {m.resources && m.resources.length > 0 && (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
            {m.resources.map(res => (
              <div class="p-3.5 rounded-lg bg-[#F8F9FA]/60 dark:bg-white/[0.03] border border-[#E6E8EB] dark:border-white/[0.08] flex flex-col justify-between">
                <div>
                  <h4 class="text-xs font-semibold text-[#242936] dark:text-[#ECEFF4] mb-1">
                    {res.title}
                  </h4>
                  <p class="text-xs text-[#828E9F] dark:text-[#707A8C] leading-relaxed mb-3">
                    {res.description}
                  </p>
                </div>
                <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-[#E6E8EB]/80 dark:border-white/[0.05] text-xs">
                  {res.links.map(l => (
                    <a
                      href={l.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-black/[0.04] dark:bg-white/[0.05] text-[#2B79C2] dark:text-[#73D0FF] hover:bg-[#2B79C2]/10 dark:hover:bg-[#73D0FF]/10 transition-colors font-medium text-[11px]"
                    >
                      <span>{l.name}</span>
                      <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    ))}
  </section>

  <!-- Previous Modules (Since 2016) -->
  <section class="space-y-4 mb-12">
    <h2 class="text-lg font-semibold tracking-tight text-[#242936] dark:text-[#ECEFF4] pb-1.5 border-b border-[#E6E8EB] dark:border-white/[0.08]">
      Previous Modules (2016 – 2024)
    </h2>

    {pastModules.map(m => (
      <div class="py-0.5">
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
          <h3 class="font-medium text-[#242936] dark:text-[#ECEFF4]">
            <span class="font-mono text-xs text-[#828E9F] dark:text-[#707A8C] mr-1.5">{m.code}:</span> {m.title}
          </h3>
          <span class="text-xs text-[#828E9F] dark:text-[#707A8C] font-mono shrink-0">{m.period}</span>
        </div>
        <p class="text-sm text-[#5C6166] dark:text-[#CBCCC6] mt-0.5 leading-relaxed">
          {m.desc}
        </p>
      </div>
    ))}
  </section>

  <!-- Earlier Teaching (Prior to 2016) -->
  <section class="space-y-4">
    <h2 class="text-lg font-semibold tracking-tight text-[#242936] dark:text-[#ECEFF4] pb-1.5 border-b border-[#E6E8EB] dark:border-white/[0.08]">
      Earlier Teaching (Prior to 2016)
    </h2>

    {priorModules.map(m => (
      <div class="py-0.5">
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
          <h3 class="font-medium text-[#242936] dark:text-[#ECEFF4]">
            <span class="font-mono text-xs text-[#828E9F] dark:text-[#707A8C] mr-1.5">{m.code}:</span> {m.title}
          </h3>
          <span class="text-xs text-[#828E9F] dark:text-[#707A8C] font-mono shrink-0">{m.period}</span>
        </div>
        <p class="text-sm text-[#5C6166] dark:text-[#CBCCC6] mt-0.5 leading-relaxed">
          {m.desc}
        </p>
      </div>
    ))}
  </section>
</BaseLayout>
