---
import BaseLayout from '../layouts/BaseLayout.astro';

const currentModules = [
  {
    code: "EEU44C16 / EE5C16",
    title: "Deep Learning and its Applications",
    level: "Level 9 (Senior Sophister & MAI)",
    credits: "10 ECTS",
    desc: "Comprehensive module covering neural networks, backpropagation dynamics, convolutional architectures, sequence models, generative models, and transformers, with hands-on PyTorch coding labs and automated evaluation benchmarks.",
    pageUrl: "/teaching/4c16",
    resources: [
      {
        title: "Open Lecture Notes & Coursebook",
        description: "Full online curriculum covering mathematical formulations, architectural diagrams, loss landscapes, and PyTorch tutorials.",
        links: [
          { name: "Lecture Notes", url: "https://frcs.github.io/4C16-LectureNotes/" },
          { name: "Zenodo DOI", url: "https://doi.org/10.5281/zenodo.17954655" }
        ]
      },
      {
        title: "Continuous Lab Autograder & Course Hub",
        description: "Hands-on coding lab system with automated Git evaluation for Colab assignments and live course schedules.",
        links: [
          { name: "Course Portal", url: "https://frcs.github.io/4c16/" },
          { name: "4C16 Autograder", url: "https://frcs.github.io/4c16/lab-system/" }
        ]
      }
    ]
  },
  {
    code: "EE55C34",
    title: "Advanced AI",
    level: "Level 9 (Postgraduate / MAI)",
    credits: "5 ECTS",
    desc: "Advanced graduate-level study of contemporary generative models, diffusion architectures, representation learning, and modern computer vision systems.",
    pageUrl: "/teaching/5c34",
    resources: []
  }
];

const pastModules = [
  {
    code: "EEU22E10",
    title: "Engineering Design Project: Robotics Buggy",
    period: "2016 – 2021",
    level: "Level 8 (Junior Fresh / 2nd Year Engineering, 10 ECTS)",
    desc: "Core second-year group design project coordinated and redeveloped to accommodate cohorts of over 200 students. Students design, construct, and programme an autonomous wheeled robot to navigate a timed obstacle track.",
    pageUrl: "/teaching/2e10"
  },
  {
    code: "EEU44C08 / EEP55M08",
    title: "Digital Image and Video Processing",
    period: "2016 – 2024",
    level: "Level 9 (5 ECTS)",
    desc: "Foundations of 2D signal processing, spatial and frequency domain image filtering, motion estimation, restoration, and video coding principles.",
    pageUrl: "/teaching/4c8"
  }
];

const priorModules = [
  {
    code: "CS7034",
    title: "Augmented Reality",
    period: "2013",
    desc: "Postgraduate course covering camera calibration, projective geometry, tracking, and graphic overlay systems."
  },
  {
    code: "CS7008",
    title: "Computer Vision (Postgraduate)",
    period: "2009",
    desc: "Graduate module on feature detection, robust estimation, image segmentation, and statistical models."
  },
  {
    code: "CS4053 / 4D4",
    title: "Undergraduate Computer Vision",
    period: "2009 – 2011",
    desc: "Foundational computer vision, edge detection, optical flow, and stereoscopic depth estimation."
  }
];
---

<BaseLayout title="Teaching - François Pitié" currentSection="teaching">
  <div class="post">
    <header class="post-header mb-6">
      <h1 class="post-title">Teaching</h1>
      <p class="desc text-xs sm:text-sm text-[var(--theme-muted)] mt-1.5 pb-3 border-b border-[var(--theme-border)]">
        Undergraduate and postgraduate courses delivered at the Department of Electronic & Electrical Engineering, Trinity College Dublin.
      </p>

      <!-- Segmented Tabs (Variant C) -->
      <div class="flex items-center gap-2 mt-5 text-xs font-mono">
        <button 
          type="button" 
          id="tab-btn-courses"
          data-tab="courses" 
          class="tab-btn active px-3.5 py-1.5 rounded border border-[var(--theme-heading)] bg-[var(--theme-heading)] text-[var(--theme-bg)] transition-colors cursor-pointer font-medium"
        >
          Current Modules
        </button>
        <button 
          type="button" 
          id="tab-btn-philosophy"
          data-tab="philosophy" 
          class="tab-btn px-3.5 py-1.5 rounded border border-[var(--theme-border)] text-[var(--theme-muted)] hover:text-[var(--theme-accent)] transition-colors cursor-pointer"
        >
          Teaching Philosophy
        </button>
        <button 
          type="button" 
          id="tab-btn-archive"
          data-tab="archive" 
          class="tab-btn px-3.5 py-1.5 rounded border border-[var(--theme-border)] text-[var(--theme-muted)] hover:text-[var(--theme-accent)] transition-colors cursor-pointer"
        >
          Past Archive
        </button>
      </div>
    </header>

    <article class="mt-8">
      
      <!-- TAB 1: Current Modules -->
      <div id="tab-pane-courses" class="tab-pane space-y-8">
        <div class="space-y-8">
          {currentModules.map(m => (
            <div class="space-y-2 pb-6 border-b border-[var(--theme-border)]/50 last:border-b-0 last:pb-0">
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                <h2 class="font-semibold text-base text-[var(--theme-heading)]">
                  <a href={m.pageUrl} class="hover:text-[var(--theme-accent)] transition-colors">
                    <span class="font-mono text-xs text-[var(--theme-muted)] mr-1.5">{m.code}:</span>
                    <span>{m.title}</span>
                  </a>
                </h2>
                <span class="text-xs font-mono text-[var(--theme-muted)] shrink-0">{m.credits}</span>
              </div>

              <div class="text-xs font-mono text-[var(--theme-muted)]">
                {m.level}
              </div>

              <p class="text-sm text-[var(--theme-fg)] leading-relaxed">
                {m.desc}
              </p>

              <div class="flex flex-wrap items-center gap-2 pt-1.5">
                <a href={m.pageUrl} class="pub-btn">
                  <span>Course Details &rarr;</span>
                </a>
                {m.resources && m.resources.flatMap(r => r.links).map(l => (
                  <a
                    href={l.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="pub-btn"
                  >
                    <span>{l.name}</span>
                    <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- TAB 2: Teaching Philosophy -->
      <div id="tab-pane-philosophy" class="tab-pane hidden">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10">
          <!-- Main Column (2/3 width) -->
          <div class="md:col-span-2 space-y-4 text-sm sm:text-base leading-relaxed text-[var(--theme-fg)]">
            <p>
              My approach to teaching has evolved through experience, particularly from teaching large, practical engineering modules.
            </p>

            <p>
              One idea that has had a strong influence on me is <strong>mastery learning</strong>, as described by Salman Khan. The basic idea is simple: students should have the opportunity to make mistakes, learn from them, and try again rather than being defined by a single failed attempt. I try to build this into my courses through repeated submissions, feedback, and opportunities to improve.
            </p>

            <p>
              Another important part of my teaching is giving students <strong>open-ended problems</strong>. Once the basic requirements are met, the most motivated students should have the freedom to go further, experiment, and build something of their own. This is particularly important in engineering and AI, where there is rarely one "correct" solution.
            </p>

            <p>
              In practice, this means I try to make my courses places where students can <strong>build things, break things, learn from the failures, and try again</strong>. Technology helps me make this possible even with large classes, but the goal is ultimately a simple one: to give students the freedom and support to become independent engineers.
            </p>
          </div>

          <!-- Margin Sidebar (1/3 width) -->
          <aside class="space-y-6 text-xs sm:text-sm md:border-l md:border-[var(--theme-border)]/60 md:pl-8">
            <div>
              <div class="text-xs tracking-wider text-[var(--theme-muted)] mb-2">
                A video that had a profound influence on my teaching:
              </div>
              <div class="font-medium text-[var(--theme-heading)]">
                Salman Khan
              </div>
              <div class="text-xs text-[var(--theme-muted)] mt-0.5 italic">
                Let's teach for mastery - not test scores 
              </div>
              <div class="mt-2.5">
                <a 
                  href="https://youtu.be/-MTRxRO5SRA" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-[var(--theme-link)] hover:text-[var(--theme-accent)] hover:underline inline-flex items-center gap-1 font-medium"
                >
                  <span>Watch TED Talk</span> &rarr;
                </a>
              </div>
            </div>
          </aside>
        </div>
      </div>

      <!-- TAB 3: Past Archive -->
      <div id="tab-pane-archive" class="tab-pane hidden space-y-8">
        <!-- Recent Previous Modules -->
        <section>
          <h2 class="text-base font-light tracking-tight text-[var(--theme-heading)] pb-2 border-b border-[var(--theme-border)] mb-4">
            Previous Modules (2016 – 2024)
          </h2>
          <div class="space-y-4">
            {pastModules.map(m => (
              <div class="py-2 border-b border-[var(--theme-border)]/50 last:border-b-0">
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                  <h3 class="font-medium text-sm text-[var(--theme-heading)]">
                    {m.pageUrl ? (
                      <a href={m.pageUrl} class="hover:text-[var(--theme-accent)] transition-colors inline-flex items-center gap-1 group">
                        <span><span class="font-mono text-xs text-[var(--theme-muted)] mr-1.5">{m.code}:</span> {m.title}</span>
                        <span class="text-xs text-[var(--theme-muted)] group-hover:text-[var(--theme-accent)]">&rarr;</span>
                      </a>
                    ) : (
                      <span><span class="font-mono text-xs text-[var(--theme-muted)] mr-1.5">{m.code}:</span> {m.title}</span>
                    )}
                  </h3>
                  <span class="text-xs text-[var(--theme-muted)] font-mono shrink-0">{m.period}</span>
                </div>
                <p class="text-xs sm:text-sm text-[var(--theme-muted)] mt-1 leading-relaxed">
                  {m.desc}
                </p>
              </div>
            ))}
          </div>
        </section>

        <!-- Earlier Teaching -->
        <section>
          <h2 class="text-base font-light tracking-tight text-[var(--theme-heading)] pb-2 border-b border-[var(--theme-border)] mb-4">
            Earlier Teaching (prior to 2016)
          </h2>
          <div class="space-y-4">
            {priorModules.map(m => (
              <div class="py-2 border-b border-[var(--theme-border)]/50 last:border-b-0">
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                  <h3 class="font-medium text-sm text-[var(--theme-heading)]">
                    <span class="font-mono text-xs text-[var(--theme-muted)] mr-1.5">{m.code}:</span> {m.title}
                  </h3>
                  <span class="text-xs text-[var(--theme-muted)] font-mono shrink-0">{m.period}</span>
                </div>
                <p class="text-xs sm:text-sm text-[var(--theme-muted)] mt-1 leading-relaxed">
                  {m.desc}
                </p>
              </div>
            ))}
          </div>
        </section>
      </div>

    </article>
  </div>

  <script>
    function setActiveTab(tabId: string) {
      const panes = document.querySelectorAll<HTMLElement>('.tab-pane');
      const buttons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');

      panes.forEach(pane => {
        pane.classList.add('hidden');
      });

      buttons.forEach(btn => {
        btn.classList.remove('active', 'bg-[var(--theme-heading)]', 'text-[var(--theme-bg)]', 'border-[var(--theme-heading)]', 'font-medium');
        btn.classList.add('text-[var(--theme-muted)]', 'border-[var(--theme-border)]');
      });

      const activePane = document.getElementById(`tab-pane-${tabId}`);
      const activeBtn = document.getElementById(`tab-btn-${tabId}`);

      if (activePane) {
        activePane.classList.remove('hidden');
      }

      if (activeBtn) {
        activeBtn.classList.add('active', 'bg-[var(--theme-heading)]', 'text-[var(--theme-bg)]', 'border-[var(--theme-heading)]', 'font-medium');
        activeBtn.classList.remove('text-[var(--theme-muted)]', 'border-[var(--theme-border)]');
      }

      // Update URL hash
      if (history.replaceState) {
        history.replaceState(null, '', tabId === 'courses' ? window.location.pathname : `#${tabId}`);
      }
    }

    // Attach click handlers
    document.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const tabId = btn.getAttribute('data-tab');
        if (tabId) {
          setActiveTab(tabId);
        }
      });
    });

    // Check initial hash
    const initialHash = window.location.hash.replace('#', '');
    if (['courses', 'philosophy', 'archive'].includes(initialHash)) {
      setActiveTab(initialHash);
    }
  </script>
</BaseLayout>
