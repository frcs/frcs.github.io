---
import BaseLayout from '../layouts/BaseLayout.astro';

const currentModules = [
  {
    code: "EEU44C16 / EE5C16",
    title: "Deep Learning and its Applications",
    level: "Level 9 (Senior Sophister & MAI, 10 ECTS)",
    desc: "Comprehensive module covering neural networks, backpropagation, convolutional networks, sequence models, generative models, and transformers, with hands-on PyTorch coding labs and automated evaluation benchmarks.",
    hasDeepLearningFeature: true,
    pageUrl: "/teaching/4c16-teaching",
    links: [
      { name: "Course Portal", url: "https://frcs.github.io/4c16/" },
      { name: "Online Lecture Notes", url: "https://frcs.github.io/4C16-LectureNotes/" },
      { name: "Zenodo Archive", url: "https://doi.org/10.5281/zenodo.17954655" },
      { name: "Lab & Autograder Repository", url: "https://github.com/frcs/4C16-2425" }
    ]
  },
  {
    code: "EE55C34",
    title: "Advanced AI",
    level: "Level 9 (Postgraduate / MAI, 5 ECTS)",
    desc: "Advanced graduate-level study of contemporary generative models, diffusion architectures, representation learning, and modern computer vision systems.",
    hasDeepLearningFeature: false,
    pageUrl: "/teaching/5c34-teaching",
    links: []
  }
];

const pastModules = [
  {
    code: "EEU22E10",
    title: "Engineering Design Project: Robotics Buggy",
    period: "2016 – 2021",
    level: "Level 8 (Junior Fresh / 2nd Year Engineering, 10 ECTS)",
    desc: "Core second-year group design project coordinated and redeveloped to accommodate cohorts of over 200 students. Students design, construct, and programme an autonomous wheeled robot to navigate a timed obstacle track."
  },
  {
    code: "EEU44C08 / EEP55M08",
    title: "Digital Image and Video Processing",
    period: "2016 – 2024",
    level: "Level 9 (5 ECTS)",
    desc: "Foundations of 2D signal processing, spatial and frequency domain image filtering, motion estimation, restoration, and video coding principles."
  }
];

const priorModules = [
  {
    code: "CS7034",
    title: "Augmented Reality",
    period: "2013",
    desc: "Postgraduate course covering camera calibration, projective geometry, tracking, and graphic overlay systems."
  },
  {
    code: "CS7008",
    title: "Computer Vision (Postgraduate)",
    period: "2009",
    desc: "Graduate module on feature detection, robust estimation, image segmentation, and statistical models."
  },
  {
    code: "CS4053 / 4D4",
    title: "Undergraduate Computer Vision",
    period: "2009 – 2011",
    desc: "Foundational computer vision, edge detection, optical flow, and stereoscopic depth estimation."
  }
];
---

<BaseLayout title="Teaching - François Pitié" currentSection="teaching">
  <div class="mb-8 pb-2 border-b border-black/[0.08] dark:border-white/[0.08]">
    <h1 class="text-xl font-semibold tracking-tight text-[#1a1e22] dark:text-[#edf2f7]">Teaching</h1>
    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
      Undergraduate and postgraduate courses delivered at the Department of Electronic & Electrical Engineering, Trinity College Dublin.
    </p>
  </div>

  <!-- Teaching Honours & Recognition -->
  <div class="mb-6 text-xs sm:text-sm text-[#2e3438] dark:text-[#d8dde3]">
    <div class="font-medium text-[#1a1e22] dark:text-[#edf2f7]">
      Teaching Recognition
    </div>
    <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">
      Recipient of the <strong>University Excellence in Teaching Award</strong> and the <strong>Inspiring Educator Award</strong> (Trinity College Dublin, 2026).
    </p>
  </div>

  <!-- Teaching Philosophy Note -->
  <div class="mb-8 text-xs sm:text-sm text-[#2e3438] dark:text-[#d8dde3] leading-relaxed">
    <strong class="text-[#1a1e22] dark:text-[#edf2f7] font-medium">Teaching Philosophy: </strong>
    My teaching integrates open-ended engineering challenges with continuous, mastery-based feedback. By deploying automated evaluation platforms in technical modules such as deep learning and robotics, students iterate rapidly, debug effectively, and achieve deep conceptual mastery.
  </div>

  <!-- Current Modules -->
  <section class="space-y-6 mb-12">
    <h2 class="text-lg font-semibold tracking-tight text-[#1a1e22] dark:text-[#edf2f7] pb-1.5 border-b border-black/[0.08] dark:border-white/[0.08]">
      Current Modules
    </h2>

    {currentModules.map(m => (
      <div class="py-1">
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
          <h3 class="font-medium text-[#1a1e22] dark:text-[#edf2f7]">
            <a href={m.pageUrl} class="hover:text-[#235789] dark:hover:text-[#82B4DC] transition-colors">
              <span class="font-mono text-xs text-[#235789] dark:text-[#82B4DC] mr-1.5">{m.code}:</span> {m.title}
            </a>
          </h3>
          <span class="text-xs text-slate-400 font-mono shrink-0">{m.level}</span>
        </div>
        <p class="text-sm text-slate-600 dark:text-slate-400 mt-1 leading-relaxed">
          {m.desc}
        </p>

        {m.hasDeepLearningFeature && (
          <div class="mt-2.5 space-y-1.5 text-xs">
            <div>
              <span class="font-medium text-[#1a1e22] dark:text-[#edf2f7]">4C16 Open Lecture Notes: </span>
              <span class="text-slate-500">Comprehensive coursebook covering theory, derivations, and PyTorch tutorials. </span>
              <a href="https://frcs.github.io/4C16-LectureNotes/" target="_blank" rel="noopener noreferrer" class="text-[#235789] dark:text-[#82B4DC] hover:underline font-medium">Read Online &rarr;</a>
              <span class="mx-1 text-slate-300 dark:text-slate-700">&bull;</span>
              <a href="https://doi.org/10.5281/zenodo.17954655" target="_blank" rel="noopener noreferrer" class="text-[#235789] dark:text-[#82B4DC] hover:underline font-medium">Zenodo DOI &rarr;</a>
            </div>

            <div>
              <span class="font-medium text-[#1a1e22] dark:text-[#edf2f7]">Continuous Lab Autograder: </span>
              <span class="text-slate-500">Hands-on coding lab system with automated Git evaluation for Colab assignments. </span>
              <a href="https://github.com/frcs/4C16-2425" target="_blank" rel="noopener noreferrer" class="text-[#235789] dark:text-[#82B4DC] hover:underline font-medium">GitHub Repository &rarr;</a>
              <span class="mx-1 text-slate-300 dark:text-slate-700">&bull;</span>
              <a href="https://frcs.github.io/4c16/" target="_blank" rel="noopener noreferrer" class="text-[#235789] dark:text-[#82B4DC] hover:underline font-medium">Course Hub &rarr;</a>
            </div>
          </div>
        )}

        {!m.hasDeepLearningFeature && m.links.length > 0 && (
          <div class="mt-2 flex items-center gap-3 text-xs text-[#235789] dark:text-[#82B4DC]">
            {m.links.map(l => (
              <a href={l.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 hover:underline">
                {l.name}
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              </a>
            ))}
          </div>
        )}
      </div>
    ))}
  </section>

  <!-- Previous Modules (Since 2016) -->
  <section class="space-y-4 mb-12">
    <h2 class="text-lg font-semibold tracking-tight text-[#1a1e22] dark:text-[#edf2f7] pb-1.5 border-b border-black/[0.08] dark:border-white/[0.08]">
      Previous Modules (2016 – 2024)
    </h2>

    {pastModules.map(m => (
      <div class="py-0.5">
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
          <h3 class="font-medium text-[#1a1e22] dark:text-[#edf2f7]">
            <span class="font-mono text-xs text-slate-400 mr-1.5">{m.code}:</span> {m.title}
          </h3>
          <span class="text-xs text-slate-400 font-mono shrink-0">{m.period}</span>
        </div>
        <p class="text-sm text-slate-600 dark:text-slate-400 mt-0.5 leading-relaxed">
          {m.desc}
        </p>
      </div>
    ))}
  </section>

  <!-- Earlier Teaching (Prior to 2016) -->
  <section class="space-y-4">
    <h2 class="text-lg font-semibold tracking-tight text-[#1a1e22] dark:text-[#edf2f7] pb-1.5 border-b border-black/[0.08] dark:border-white/[0.08]">
      Earlier Teaching (Prior to 2016)
    </h2>

    {priorModules.map(m => (
      <div class="py-0.5">
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
          <h3 class="font-medium text-[#1a1e22] dark:text-[#edf2f7]">
            <span class="font-mono text-xs text-slate-400 mr-1.5">{m.code}:</span> {m.title}
          </h3>
          <span class="text-xs text-slate-400 font-mono shrink-0">{m.period}</span>
        </div>
        <p class="text-sm text-slate-600 dark:text-slate-400 mt-0.5 leading-relaxed">
          {m.desc}
        </p>
      </div>
    ))}
  </section>
</BaseLayout>
